YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCk3-zIWTjiK_XICSSxkVwIw

# Riot Games API (solo servidor)
RIOT_API_KEY=
RIOT_GAME_NAME=Tidusss
RIOT_TAG_LINE=FFX
RIOT_PLATFORM_ROUTE=euw1
RIOT_REGIONAL_ROUTE=europe

# Histórico de rango — solo servidor. Protege POST /api/riot/rank-snapshot-cron.
# Genera un valor largo aleatorio y ponlo idéntico en Cloudflare Pages y en el
# secret de repo de GitHub Actions. Sin él, ese endpoint responde 401 a todo.
# Guía completa: docs/operations/rank-history.md
RANK_SNAPSHOT_CRON_SECRET=

# Twitch (solo servidor)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=tidussstwitch

# Claude — generador opcional de "Pregunta a Tidusss" (solo servidor, nunca expuesto al cliente).
# Sin CLAUDE_API_KEY, el sistema usa automáticamente el generador determinista local — nunca falla la app.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
