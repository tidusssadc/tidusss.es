---
import '../styles/global.css';
import { site } from '../data/site';
import SoulEngine from '../components/SoulEngine.astro';
import Environment from '../components/Environment.astro';
import { resolveEnvironment, type EnvironmentId } from '../data/environments';

interface Props {
  title?: string;
  description?: string;
  environment?: EnvironmentId;
  /** Solo para contenido todavía demasiado incompleto para indexarse (p. ej. una ficha de campeón sin perfil editorial). El resto del sitio nunca lo pasa. */
  noindex?: boolean;
}
const {
  title = site.title,
  description = site.description,
  environment = resolveEnvironment(Astro.url.pathname),
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="color-scheme" content="dark" />
    <meta name="msapplication-TileColor" content="#0B0B0C" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Tidusss" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="Tidusss — Cada combo cuenta. Master ADC."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta
      name="twitter:image:alt"
      content="Tidusss — Cada combo cuenta. Master ADC."
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
  </head>
  <body class="antialiased" data-environment={environment}>
    <Environment environment={environment} />
    <div class="site-stage"><slot /></div>
    <SoulEngine />
  </body>
</html>
