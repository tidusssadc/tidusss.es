---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LaboratoryHero from '../components/laboratory/LaboratoryHero.astro';
import { siteUpdates, updateKindLabel } from '../data/updates';

const entries = siteUpdates;
const kindLabel = updateKindLabel;

const pageTitle = 'Actualizaciones · tidusss.es';
const pageDescription =
  'El historial editorial de tidusss.es: nuevas guías, cambios de builds, cambios de Tier List, nuevos conceptos y mejoras de la web, en orden cronológico.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main>
    <LaboratoryHero
      eyebrow="Actualizaciones"
      title="El historial de lo que ha cambiado"
      description="Nuevas guías, cambios de builds, cambios de Tier List, nuevos conceptos y mejoras de la web — en orden, sin mezclarlo con vídeos ni directos."
    />
    <section
      class="updates-page section-shell"
      aria-labelledby="updates-title"
    >
      <div class="mx-auto max-w-4xl px-5 sm:px-8">
        <h2 id="updates-title" class="sr-only">Historial de actualizaciones</h2>
        <ol class="activity-feed">
          {
            entries.map((entry) => (
              <li>
                <a href={entry.href} class="activity-entry">
                  <time datetime={entry.date}>
                    {new Date(entry.date).toLocaleDateString('es-ES', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                  <div>
                    <b class="activity-kind" data-kind={entry.kind}>
                      {kindLabel[entry.kind]}
                    </b>
                    <strong>{entry.title}</strong>
                    <p>{entry.description}</p>
                  </div>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="tier-list-cta">
          <a class="button-secondary" href="/actividad">
            Ver también vídeos y directos <span aria-hidden="true">→</span>
          </a>
          <a class="button-secondary" href="/roadmap">
            Ver qué viene después <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
