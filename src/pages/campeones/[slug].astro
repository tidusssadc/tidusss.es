---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ExploreNext from '../../components/ExploreNext.astro';
import LaboratoryMetadata from '../../components/laboratory/LaboratoryMetadata.astro';
import ChampionKnowledgeSection from '../../components/laboratory/ChampionKnowledgeSection.astro';
import EmptyLaboratoryState from '../../components/laboratory/EmptyLaboratoryState.astro';
import ChampionHeader from '../../components/laboratory/champion/ChampionHeader.astro';
import ChampionProfileSection from '../../components/laboratory/champion/ChampionProfileSection.astro';
import ChampionTierStatus from '../../components/laboratory/champion/ChampionTierStatus.astro';
import BuildBlock from '../../components/laboratory/champion/BuildBlock.astro';
import RuneBlock from '../../components/laboratory/champion/RuneBlock.astro';
import MatchupCard from '../../components/laboratory/champion/MatchupCard.astro';
import SynergyCard from '../../components/laboratory/champion/SynergyCard.astro';
import ConceptCard from '../../components/laboratory/champion/ConceptCard.astro';
import EditorialHistoryTimeline from '../../components/laboratory/champion/EditorialHistoryTimeline.astro';
import ChampionGuideToc from '../../components/laboratory/champion/ChampionGuideToc.astro';
import ChampionQuickFacts from '../../components/laboratory/champion/ChampionQuickFacts.astro';
import ChampionMatchHistory from '../../components/laboratory/champion/ChampionMatchHistory.astro';
import ChampionRelatedVideos from '../../components/laboratory/champion/ChampionRelatedVideos.astro';
import EditorialCallout from '../../components/laboratory/EditorialCallout.astro';
import AskTidusssPrompt from '../../components/AskTidusssPrompt.astro';
import { PREGUNTA_LUCIAN_SUGGESTIONS } from '../../data/pregunta';
import { videoContentLinks } from '../../config/video-content-links';
import { resolvedVideoContent } from '../../lib/resolved-video-content';
import {
  buildLabRegistry,
  getChampionKnowledge,
  type ChampionCatalogEntry,
  type EditorialTake,
  type Synergy,
} from '../../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  championCatalogVersion,
  leagueLaboratoryBuilds,
  leagueLaboratoryConcepts,
  leagueLaboratoryMatchups,
  leagueLaboratoryPatches,
  leagueLaboratoryRunePages,
  leagueLaboratorySynergies,
  officialAdcTierList,
} from '../../data/league-laboratory';

/**
 * Una ruta por cada campeón del catálogo generado (~170), no por los 4
 * curados por Tidusss. Añadir 30 campeones nuevos a
 * `catalog/champions.generated.ts` (vía `npm run sync:champions`) genera
 * 30 páginas nuevas sin tocar esta página ni el dominio.
 */
export function getStaticPaths() {
  return championCatalog.map((catalogEntry) => ({
    params: { slug: catalogEntry.slug },
    props: { catalogEntry },
  }));
}

interface Props {
  catalogEntry: ChampionCatalogEntry;
}
const { catalogEntry } = Astro.props;

const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
  builds: leagueLaboratoryBuilds,
  runePages: leagueLaboratoryRunePages,
  matchups: leagueLaboratoryMatchups,
  synergies: leagueLaboratorySynergies,
  concepts: leagueLaboratoryConcepts,
  videoLinks: videoContentLinks,
});

const knowledge = getChampionKnowledge(registry, catalogEntry.id);
const labChampion = knowledge?.labChampion;
const hasProfile = Boolean(labChampion?.profile);
const role = labChampion?.signatureRole ?? labChampion?.roles[0];

// Las imágenes del campeón siempre usan la versión con la que se generó el
// catálogo — no la del parche de la Tier List, que es un dato editorial
// distinto y puede quedar desactualizado sin que las imágenes dejen de
// resolverse (ver ADR correspondiente).
const dataDragonVersion = championCatalogVersion;

// Builds: la principal primero, luego las alternativas — nunca al revés,
// para que "esto es lo que compraría por defecto" sea siempre lo primero
// que se lee.
const builds = knowledge?.builds ?? [];
const primaryBuilds = builds.filter((build) => build.variant === 'primary');
const situationalBuilds = builds.filter(
  (build) => build.variant === 'situational',
);
const orderedBuilds = [...primaryBuilds, ...situationalBuilds];
const patchFor = (patchId: string) =>
  leagueLaboratoryPatches.find((patch) => patch.id === patchId);

// Matchups agrupados por dificultad real — nunca dos listas mantenidas a
// mano, siempre derivadas de `matchup.difficulty`.
const matchups = knowledge?.matchups ?? [];
const easyMatchups = matchups.filter((m) => m.difficulty === 'easy');
const evenMatchups = matchups.filter((m) => m.difficulty === 'even');
const hardMatchups = matchups.filter((m) => m.difficulty === 'hard');
const opponentFor = (opponentChampionId: string) =>
  championCatalog.find((entry) => entry.id === opponentChampionId);

const synergies = knowledge?.synergies ?? [];
const partnersFor = (championIds: readonly string[]) =>
  championIds
    .filter((id) => id !== catalogEntry.id)
    .flatMap((id) => {
      const entry = championCatalog.find((candidate) => candidate.id === id);
      return entry ? [entry] : [];
    });

// Vídeos relacionados: `knowledge.videos` ya filtra la metadata editorial
// por championId (mismo patrón que builds/matchups/sinergias); aquí solo
// se cruza con los datos REALES ya resueltos una vez en build time
// (`resolvedVideoContent`) — nunca se inventa título/miniatura/duración,
// y si un vídeo no se pudo resolver (sin clave, fallo de red), simplemente
// no aparece, en vez de romper la página. Más recientes primero.
const videoIdsForChampion = new Set(
  (knowledge?.videos ?? []).map((link) => link.youtubeVideoId),
);
const videosForPage = resolvedVideoContent
  .filter((video) => videoIdsForChampion.has(video.id))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));

// Estado real en la Tier List: mismo dato que ya usa `ChampionTierStatus`,
// solo resolviendo aquí el parche vigente de esa edición (26.17) — un dato
// distinto del parche de la GUÍA (`primaryBuildPatch`, 26.14 para Lucian).
// Nunca se duplica el veredicto a mano: viene directo de `tierListAppearances`.
const tierListAppearance = knowledge?.tierListAppearances[0];
const tierListPatchLabel = tierListAppearance
  ? leagueLaboratoryPatches.find(
      (patch) => patch.id === tierListAppearance.tierList.patchId,
    )?.label
  : undefined;

/**
 * Sinergias: si varias comparten literalmente el mismo veredicto (todavía
 * no hay análisis específico por pareja), se resume una sola vez en la
 * cabecera de la sección en vez de repetir el mismo párrafo en cada
 * tarjeta. En cuanto una pareja tenga un veredicto real y distinto, deja
 * de coincidir con el genérico compartido y vuelve a mostrarse en su
 * propia tarjeta — sin tocar este cálculo ni `SynergyCard`.
 */
const synergyTakeKey = (take: EditorialTake) =>
  `${take.verdict} :: ${take.reasoning}`;
const synergyTakeCounts = new Map<string, number>();
for (const synergy of synergies) {
  const key = synergyTakeKey(synergy.editorialTake);
  synergyTakeCounts.set(key, (synergyTakeCounts.get(key) ?? 0) + 1);
}
const mostSharedSynergyTakeCount = Math.max(0, ...synergyTakeCounts.values());
const isGenericSynergyTake = (synergy: Synergy) =>
  synergies.length > 1 &&
  mostSharedSynergyTakeCount > 1 &&
  synergyTakeCounts.get(synergyTakeKey(synergy.editorialTake)) ===
    mostSharedSynergyTakeCount;
const genericSynergyTake = synergies.find((synergy) =>
  isGenericSynergyTake(synergy),
)?.editorialTake;

const quickTips = labChampion?.profile?.quickTips ?? [];
const editorialHistory = labChampion?.editorialHistory ?? [];

/**
 * Resumen compacto de power spikes para "Datos rápidos" — mismo texto real
 * que ya despliega `PowerSpikeStory` en el cuerpo principal (mismo criterio
 * de corte: "momento: explicación"), solo mostrando el momento breve en vez
 * del párrafo completo. Nunca se inventa una frase nueva ni se duplica la
 * explicación larga, que sigue viviendo únicamente en el perfil.
 */
const powerSpikeMoment = (entry: string): string | undefined => {
  const cutAt = (needle: string) => {
    const index = entry.indexOf(needle);
    return index === -1 ? undefined : entry.slice(0, index);
  };
  const moment = cutAt(': ') ?? cutAt(', ');
  return moment && moment.length <= 60 ? moment : undefined;
};
const powerSpikeSummary = (labChampion?.profile?.powerSpikes ?? [])
  .map(powerSpikeMoment)
  .filter((moment): moment is string => Boolean(moment))
  .slice(0, 2)
  .join(' · ');

// Panel contextual: solo aporta valor cuando ya hay una build real que
// resumir — no se muestra para campeones sin perfil ni build.
const lastEditorialDate = [...editorialHistory]
  .map((entry) => entry.date)
  .sort()
  .at(-1);
const primaryQuestion = PREGUNTA_LUCIAN_SUGGESTIONS[0];

// Índice lateral: solo enlaza a secciones que de verdad tienen contenido —
// un índice que apunta a estados vacíos resta profundidad en vez de sumarla.
const tocEntries = hasProfile
  ? [
      { id: 'resumen', label: 'Resumen', show: true },
      { id: 'build', label: 'Build', show: orderedBuilds.length > 0 },
      { id: 'runas', label: 'Runas', show: (knowledge?.runePages.length ?? 0) > 0 },
      { id: 'partidas', label: 'Partidas', show: true },
      { id: 'videos', label: 'Vídeos', show: videosForPage.length > 0 },
      { id: 'matchups', label: 'Matchups', show: matchups.length > 0 },
      { id: 'sinergias', label: 'Sinergias', show: synergies.length > 0 },
      {
        id: 'consejos-rapidos',
        label: 'Consejos rápidos',
        show: quickTips.length > 0,
      },
      {
        id: 'concepts',
        label: 'Conceptos',
        show: (knowledge?.concepts.length ?? 0) > 0,
      },
      {
        id: 'historial-editorial',
        label: 'Historial editorial',
        show: editorialHistory.length > 0,
      },
    ].filter((entry) => entry.show)
  : [];

// El título/descripción mencionan el parche y los objetos reales solo
// cuando existe build publicada — leídos siempre de los datos reales, nunca
// escritos a mano para un campeón concreto, para que esto siga siendo
// genérico y reutilizable para cualquier otro campeón curado.
const primaryBuild = orderedBuilds.find((build) => build.variant === 'primary');
const primaryBuildPatch = primaryBuild
  ? patchFor(primaryBuild.patchId)
  : undefined;
const coreItemNames = primaryBuild?.coreItems.map((item) => item.name) ?? [];
const primaryRuneName = knowledge?.runePages[0]?.primaryRunes[0]?.name;
const pageTitle =
  hasProfile && primaryBuild && primaryBuildPatch
    ? `${catalogEntry.name} ADC: Build y Runas del Parche ${primaryBuildPatch.label} — Guía de Tidusss`
    : hasProfile
      ? `${catalogEntry.name} ADC: Guía, Build y Runas — ADCs de Tidusss`
      : `${catalogEntry.name} — ${catalogEntry.title} · tidusss.es`;
const pageDescription =
  hasProfile && primaryBuild && primaryBuildPatch
    ? `Guía de ${catalogEntry.name} ADC de Tidusss, Master ADC en EUW: build del parche ${primaryBuildPatch.label}${coreItemNames.length > 0 ? ` (${coreItemNames.join(', ')})` : ''}${primaryRuneName ? `, runa principal ${primaryRuneName}` : ''} y el criterio real detrás de cada decisión.`
    : hasProfile
      ? `Guía de ${catalogEntry.name} ADC por Tidusss, Master ADC en EUW: build, runas, matchups y el criterio real detrás de cada decisión — no solo estadísticas.`
      : `Ficha de ${catalogEntry.name} (${catalogEntry.title}) en el Laboratorio. Su perfil editorial todavía se está preparando.`;

// Datos estructurados (Article) solo cuando hay contenido editorial real que
// describir — no tiene sentido marcar como "artículo" una ficha que todavía
// dice "Pendiente de análisis" en casi todas sus secciones. Fechas reales,
// tomadas del propio historial editorial — nunca inventadas.
const sortedHistory = [...editorialHistory].sort((a, b) =>
  a.date.localeCompare(b.date),
);
const structuredData = hasProfile
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: pageTitle,
      description: pageDescription,
      author: { '@type': 'Person', name: 'Tidusss' },
      ...(sortedHistory[0] && { datePublished: sortedHistory[0].date }),
      ...(sortedHistory.at(-1) && {
        dateModified: sortedHistory.at(-1)!.date,
      }),
    }
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={!hasProfile}
>
  {
    structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )
  }
  <Navbar />
  <main>
    <section
      class="champion-page section-shell"
      aria-labelledby="champion-name"
    >
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <ChampionHeader
          catalogEntry={catalogEntry}
          labChampion={labChampion}
          role={role}
          dataDragonVersion={dataDragonVersion}
        />

        {
          // Deliberadamente distinto del bloque de Tier List de abajo: esto
          // es el parche en el que se escribió la GUÍA (la build real, la
          // única fecha de parche que de verdad existe hoy para el perfil),
          // casi siempre más antiguo que el parche vigente de la Tier List —
          // no se actualiza solo ni se asume vigente sin que Tidusss lo
          // confirme. `lastEditorialDate` es la fecha real del propio
          // historial editorial del campeón, nunca la de la Tier List.
          primaryBuildPatch && (
            <div class="champion-guide-revision">
              <span class="champion-guide-revision-label">
                Guía · Última revisión
              </span>
              <LaboratoryMetadata
                patch={primaryBuildPatch}
                role={role}
                updatedAt={lastEditorialDate}
              />
            </div>
          )
        }

        <ChampionTierStatus
          championName={catalogEntry.name}
          championSlug={catalogEntry.slug}
          tierListAppearances={knowledge?.tierListAppearances ?? []}
          patchLabel={tierListPatchLabel}
        />

        <div class="champion-guide-layout">
          {
            (tocEntries.length > 0 || primaryBuild) && (
              <div class="champion-guide-sidebar">
                {tocEntries.length > 0 && <ChampionGuideToc entries={tocEntries} />}
                {primaryBuild && (
                  <ChampionQuickFacts
                    championName={catalogEntry.name}
                    patch={primaryBuildPatch}
                    buildItemNames={coreItemNames}
                    lastUpdated={lastEditorialDate}
                    powerSpike={powerSpikeSummary || undefined}
                    relatedQuestion={
                      catalogEntry.slug === 'lucian' ? primaryQuestion : undefined
                    }
                  />
                )}
              </div>
            )
          }
          <div class="champion-guide-main">
        <ChampionProfileSection
          profile={labChampion?.profile}
          championName={catalogEntry.name}
        />

        <div class="champion-guide-sections">
          {!hasProfile && (
            <div class="champion-knowledge-section champion-knowledge-empty-combined">
              <h3>Todavía sin análisis editorial</h3>
              <EmptyLaboratoryState
                title="Tidusss no ha curado este campeón todavía"
                description={`Build, runas, matchups, sinergias, conceptos y guía llegarán aquí en cuanto ${catalogEntry.name} entre en la rotación de análisis del Laboratorio — nunca se inventa contenido mientras tanto.`}
                ctaHref="/campeones"
                ctaLabel="Ver todo el catálogo de campeones"
              />
            </div>
          )}
          {hasProfile && (
          <>
          <ChampionKnowledgeSection
            id="build"
            title="Build"
            hasContent={orderedBuilds.length > 0}
            showShareLink
          >
            <div class="build-block-list">
              {
                orderedBuilds.map((build) => (
                  <BuildBlock
                    build={build}
                    dataDragonVersion={dataDragonVersion}
                    patch={patchFor(build.patchId)}
                  />
                ))
              }
            </div>
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="runas"
            title="Runas"
            hasContent={(knowledge?.runePages.length ?? 0) > 0}
          >
            <div class="rune-block-list">
              {
                knowledge?.runePages.map((runePage) => (
                  <RuneBlock
                    runePage={runePage}
                    patch={patchFor(runePage.patchId)}
                  />
                ))
              }
            </div>
          </ChampionKnowledgeSection>
          </>
          )}

          <div
            id="partidas"
            class="champion-knowledge-section"
            aria-labelledby="partidas-heading"
          >
            <h3 id="partidas-heading">Partidas donde aparece</h3>
            <ChampionMatchHistory championName={catalogEntry.name} />
          </div>

          {
            /* Fuera del `hasProfile`: Jhin/Ashe/Sivir/Twitch no tienen
               perfil curado en `adcLabChampions`, pero sí pueden tener
               vídeos reales conectados — igual criterio que Partidas,
               justo arriba. */
          }
          <ChampionKnowledgeSection
            id="videos"
            title="Vídeos relacionados"
            hasContent={videosForPage.length > 0}
          >
            <ChampionRelatedVideos videos={videosForPage} />
          </ChampionKnowledgeSection>

          {hasProfile && (
          <>
          <ChampionKnowledgeSection
            id="matchups"
            title="Matchups"
            hasContent={matchups.length > 0}
          >
            <div class="matchup-groups">
              {
                hardMatchups.length > 0 && (
                  <div class="matchup-group">
                    <h4>Matchups difíciles</h4>
                    <div class="matchup-card-grid">
                      {hardMatchups.map((matchup) => {
                        const opponent = opponentFor(
                          matchup.opponentChampionId,
                        );
                        return (
                          opponent && (
                            <MatchupCard
                              matchup={matchup}
                              opponentCatalogEntry={opponent}
                              dataDragonVersion={dataDragonVersion}
                            />
                          )
                        );
                      })}
                    </div>
                  </div>
                )
              }
              {
                evenMatchups.length > 0 && (
                  <div class="matchup-group">
                    <h4>Matchups parejos</h4>
                    <div class="matchup-card-grid">
                      {evenMatchups.map((matchup) => {
                        const opponent = opponentFor(
                          matchup.opponentChampionId,
                        );
                        return (
                          opponent && (
                            <MatchupCard
                              matchup={matchup}
                              opponentCatalogEntry={opponent}
                              dataDragonVersion={dataDragonVersion}
                            />
                          )
                        );
                      })}
                    </div>
                  </div>
                )
              }
              {
                easyMatchups.length > 0 && (
                  <div class="matchup-group">
                    <h4>Matchups fáciles</h4>
                    <div class="matchup-card-grid">
                      {easyMatchups.map((matchup) => {
                        const opponent = opponentFor(
                          matchup.opponentChampionId,
                        );
                        return (
                          opponent && (
                            <MatchupCard
                              matchup={matchup}
                              opponentCatalogEntry={opponent}
                              dataDragonVersion={dataDragonVersion}
                            />
                          )
                        );
                      })}
                    </div>
                  </div>
                )
              }
            </div>
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="sinergias"
            title="Sinergias"
            hasContent={synergies.length > 0}
          >
            {
              genericSynergyTake && (
                <EditorialCallout
                  icon="🔥"
                  label={`Supports con los que Tidusss recomienda jugar ${catalogEntry.name}`}
                  variant="take"
                >
                  {genericSynergyTake.verdict} {genericSynergyTake.reasoning}
                </EditorialCallout>
              )
            }
            <div class="matchup-card-grid">
              {
                synergies.map((synergy) => (
                  <SynergyCard
                    synergy={synergy}
                    partnerCatalogEntries={partnersFor(synergy.championIds)}
                    dataDragonVersion={dataDragonVersion}
                    showTake={!isGenericSynergyTake(synergy)}
                  />
                ))
              }
            </div>
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="consejos-rapidos"
            title="Consejos rápidos"
            hasContent={quickTips.length > 0}
          >
            <ul class="champion-build-list">
              {quickTips.map((tip) => <li>{tip}</li>)}
            </ul>
            {
              quickTips.length > 0 && (
                <EditorialCallout icon="🎯" label="Si tuviera que quedarme con uno" variant="focus">
                  {quickTips[quickTips.length - 1]}
                </EditorialCallout>
              )
            }
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="concepts"
            title="Conceptos relacionados"
            hasContent={(knowledge?.concepts.length ?? 0) > 0}
          >
            <ul class="concept-card-grid">
              {
                knowledge?.concepts.map((concept) => (
                  <ConceptCard concept={concept} />
                ))
              }
            </ul>
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="guides"
            title="Guías"
            hasContent={(knowledge?.guides.length ?? 0) > 0}
          >
            <ul class="champion-build-list">
              {knowledge?.guides.map((guide) => <li>{guide.title}</li>)}
            </ul>
          </ChampionKnowledgeSection>

          <ChampionKnowledgeSection
            id="historial-editorial"
            title="Historial editorial"
            hasContent={editorialHistory.length > 0}
          >
            <EditorialHistoryTimeline entries={editorialHistory} />
          </ChampionKnowledgeSection>
          </>
          )}
        </div>
          </div>
        </div>

        <div class="tier-list-cta">
          <a class="button-secondary" href="/campeones">
            Ver todo el catálogo de campeones <span aria-hidden="true">→</span>
          </a>
          <a class="button-secondary" href="/tier-list">
            Volver a la Tier List <span aria-hidden="true">→</span>
          </a>
          <a class="button-secondary" href="/competitivo">
            Ver la actividad competitiva en directo
            <span aria-hidden="true">→</span>
          </a>
        </div>

        {
          catalogEntry.slug === 'lucian' && (
            <div class="mt-12">
              <AskTidusssPrompt
                title="¿Te queda alguna duda?"
                description="Pregunta a Tidusss sobre esta guía."
                questions={PREGUNTA_LUCIAN_SUGGESTIONS}
                headingLevel="h3"
              />
            </div>
          )
        }
      </div>
    </section>
    <ExploreNext
      source={catalogEntry.id}
      eyebrow="Sigue explorando"
      title={`Relacionado con ${catalogEntry.name}`}
    />
  </main>
  <Footer />
</BaseLayout>
