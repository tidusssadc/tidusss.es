---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ExploreNext from '../../components/ExploreNext.astro';
import LaboratoryHero from '../../components/laboratory/LaboratoryHero.astro';
import ChampionEditorialCard from '../../components/laboratory/champion/ChampionEditorialCard.astro';
import ChampionAdcRosterCard from '../../components/laboratory/champion/ChampionAdcRosterCard.astro';
import {
  buildLabRegistry,
  getAdcRoster,
  getFeaturedChampions,
} from '../../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  championCatalogVersion,
  leagueLaboratoryPatches,
  officialAdcTierList,
} from '../../data/league-laboratory';

const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
});

const dataDragonVersion = championCatalogVersion;

/**
 * Hub público de ADCs — no el catálogo completo de campeones de League.
 * `championCatalog` (~173, factual, generado desde Data Dragon) sigue
 * existiendo y sigue siendo necesario internamente (partidas Riot,
 * supports, enemigos, relaciones, metadata de vídeos), pero esta página ya
 * no lo presenta como si los 173 fueran conocimiento editorial de Tidusss.
 * Lo único que se muestra aquí es: (1) contenido destacado (perfil
 * editorial completo — hoy, solo Lucian) y (2) el roster ADC de Tidusss,
 * derivado SIEMPRE de `officialAdcTierList` vía `getAdcRoster` — nunca una
 * segunda lista mantenida a mano. Hoy son 25.
 */
const featuredChampions = getFeaturedChampions(registry);
const adcRoster = getAdcRoster(registry);

const pageTitle = 'ADCs · tidusss.es';
const pageDescription = `Los ${adcRoster.length} ADC sobre los que gira el conocimiento de Tidusss, Master ADC en EUW: tier actual de la Tier List, guía completa cuando existe y vídeos relacionados.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main>
    <LaboratoryHero
      title="ADCs"
      description="Aquí reúno lo que sé de verdad sobre los ADC que juego y analizo: valoración, criterio y contenido real — no una lista de todos los campeones del juego."
    />
    <section
      class="champion-hub section-shell"
      aria-labelledby="champion-hub-title"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <header class="champion-hub-header">
          <p class="eyebrow">ADCs</p>
          <h2 id="champion-hub-title" class="sr-only">ADCs</h2>
        </header>

        {
          featuredChampions.length > 0 && (
            <div class="champion-hub-section champion-hub-featured">
              <p class="eyebrow">Contenido destacado</p>
              <h2>Análisis editorial completo</h2>
              <p class="champion-hub-section-lead">
                Los ADC con veredicto propio de Tidusss: build, runas,
                sinergias y criterio real — no solo presencia en la Tier
                List.
              </p>
              <div class="champion-editorial-grid">
                {featuredChampions.map(({ catalogEntry, labChampion }) => (
                  <ChampionEditorialCard
                    catalogEntry={catalogEntry}
                    labChampion={labChampion}
                    status="reviewed"
                    dataDragonVersion={dataDragonVersion}
                  />
                ))}
              </div>
            </div>
          )
        }

        {
          adcRoster.length > 0 && (
            <div class="champion-hub-section champion-hub-adc">
              <p class="eyebrow">Roster</p>
              <h2>
                Los {adcRoster.length} ADC de la Tier List de Tidusss
              </h2>
              <p class="champion-hub-section-lead">
                Cada ADC con entrada real en la Tier List de Tidusss, de un
                vistazo: tier actual y, cuando existe, guía completa. Esto no
                sustituye la Tier List — solo dice qué conocimiento existe de
                cada uno. Para el veredicto y el razonamiento completo, la
                edición oficial.
              </p>
              <div class="adc-roster-grid">
                {adcRoster.map((entry) => (
                  <ChampionAdcRosterCard
                    entry={entry}
                    dataDragonVersion={dataDragonVersion}
                  />
                ))}
              </div>
              <a class="button-secondary adc-roster-cta" href="/tier-list">
                Ver la Tier List oficial ADC completa{' '}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </section>
    <ExploreNext
      source="tool:champion-hub"
      eyebrow="Sigue explorando"
      title="Relacionado con los ADC"
    />
  </main>
  <Footer />
</BaseLayout>
