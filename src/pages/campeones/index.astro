---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ExploreNext from '../../components/ExploreNext.astro';
import LaboratoryHero from '../../components/laboratory/LaboratoryHero.astro';
import LaboratoryCoverageSummary from '../../components/laboratory/LaboratoryCoverageSummary.astro';
import LaboratorySearch from '../../components/laboratory/LaboratorySearch.astro';
import ChampionEditorialCard from '../../components/laboratory/champion/ChampionEditorialCard.astro';
import ChampionCatalogRow from '../../components/laboratory/champion/ChampionCatalogRow.astro';
import {
  buildLabRegistry,
  getCatalogCoverage,
  getLabChampion,
  isChampionInAnyTierList,
  resolveChampionEditorialStatus,
} from '../../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  championCatalogVersion,
  leagueLaboratoryPatches,
  officialAdcTierList,
} from '../../data/league-laboratory';

const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
});

const coverage = getCatalogCoverage(registry);
const dataDragonVersion = championCatalogVersion;

const curatedByStatus = adcLabChampions
  .map((labChampion) => {
    const catalogEntry = championCatalog.find(
      (entry) => entry.id === labChampion.id,
    );
    if (!catalogEntry) return undefined;
    return {
      catalogEntry,
      labChampion,
      status: resolveChampionEditorialStatus(labChampion),
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const reviewedChampions = curatedByStatus.filter(
  (entry) => entry.status === 'reviewed',
);
const draftChampions = curatedByStatus.filter(
  (entry) => entry.status === 'draft',
);

const catalogRows = championCatalog.map((catalogEntry) => ({
  catalogEntry,
  status: resolveChampionEditorialStatus(
    getLabChampion(registry, catalogEntry.id),
  ),
  inTierList: isChampionInAnyTierList(registry, catalogEntry.id),
}));

const classOptions = [
  ...new Set(championCatalog.flatMap((entry) => entry.tags)),
].sort((a, b) => a.localeCompare(b, 'es'));
const initialOptions = [
  ...new Set(
    championCatalog.map((entry) =>
      entry.name.charAt(0).toLocaleUpperCase('es-ES'),
    ),
  ),
].sort((a, b) => a.localeCompare(b, 'es'));

const pageTitle = 'Centro de Campeones · El Laboratorio · tidusss.es';
const pageDescription = `Explora los ${coverage.total} campeones del catálogo del Laboratorio: ${coverage.reviewed} con análisis editorial completo de Tidusss y el resto disponible mientras se revisan. Busca, filtra y encuentra la ficha de cualquier campeón.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main>
    <LaboratoryHero
      title="Centro de Campeones"
      description="El punto de partida para explorar el catálogo completo de campeones del Laboratorio: quiénes ya tienen el criterio de Tidusss y quiénes todavía están pendientes de revisión."
    />
    <section
      class="champion-hub section-shell"
      aria-labelledby="champion-hub-title"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <header class="champion-hub-header">
          <p class="eyebrow">El Laboratorio · Centro de Campeones</p>
          <h2 id="champion-hub-title">Todo el catálogo, en un solo sitio</h2>
          <p class="champion-hub-lead">
            Cada campeón de League of Legends tiene ya su propia ficha en{' '}
            <code>/campeones/&lt;campeón&gt;</code>, generada a partir de datos
            oficiales de Riot. Solo un puñado cuenta hoy con el análisis
            editorial de Tidusss — el resto sigue disponible para explorar
            mientras el Laboratorio crece.
          </p>
        </header>

        <LaboratoryCoverageSummary coverage={coverage} />

        {
          reviewedChampions.length > 0 && (
            <div class="champion-hub-featured">
              <h3>Analizados por Tidusss</h3>
              <div class="champion-editorial-grid">
                {reviewedChampions.map(
                  ({ catalogEntry, labChampion, status }) => (
                    <ChampionEditorialCard
                      catalogEntry={catalogEntry}
                      labChampion={labChampion}
                      status={status}
                      dataDragonVersion={dataDragonVersion}
                    />
                  ),
                )}
              </div>
            </div>
          )
        }

        {
          draftChampions.length > 0 && (
            <div class="champion-hub-featured">
              <h3>Presencia curada, perfil en preparación</h3>
              <div class="champion-editorial-grid">
                {draftChampions.map(({ catalogEntry, labChampion, status }) => (
                  <ChampionEditorialCard
                    catalogEntry={catalogEntry}
                    labChampion={labChampion}
                    status={status}
                    dataDragonVersion={dataDragonVersion}
                  />
                ))}
              </div>
            </div>
          )
        }

        <div class="champion-hub-catalog">
          <h3>Catálogo completo ({catalogRows.length})</h3>
          <LaboratorySearch
            classOptions={classOptions}
            initialOptions={initialOptions}
          />
          <ul class="champion-catalog-grid" data-champion-catalog-grid>
            {
              catalogRows.map(({ catalogEntry, status, inTierList }) => (
                <ChampionCatalogRow
                  catalogEntry={catalogEntry}
                  status={status}
                  dataDragonVersion={dataDragonVersion}
                  inTierList={inTierList}
                />
              ))
            }
          </ul>
          <p class="champion-catalog-empty" data-champion-catalog-empty hidden>
            Ningún campeón coincide con estos filtros. Prueba a quitar alguno o
            a buscar con otro término.
          </p>
        </div>

        <div class="tier-list-cta">
          <a class="button-secondary" href="/tier-list">
            Ver la Tier List oficial ADC <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
    <ExploreNext
      source="tool:champion-hub"
      eyebrow="Sigue explorando"
      title="Relacionado con el Centro de Campeones"
    />
  </main>
  <Footer />
</BaseLayout>
