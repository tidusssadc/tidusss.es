---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LaboratoryHero from '../components/laboratory/LaboratoryHero.astro';
import { PREGUNTA_GENERAL_SUGGESTIONS } from '../data/pregunta';
import {
  buildLabRegistry,
  getAdcRoster,
  getCatalogCoverage,
} from '../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  leagueLaboratoryBuilds,
  leagueLaboratoryConcepts,
  leagueLaboratoryPatches,
  leagueLaboratorySynergies,
  officialAdcTierList,
} from '../data/league-laboratory';

const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
});
const coverage = getCatalogCoverage(registry);
const adcRoster = getAdcRoster(registry);

const stats = [
  { value: coverage.total, label: 'Campeones en el catálogo' },
  { value: coverage.reviewed, label: 'Analizados por Tidusss' },
  { value: leagueLaboratoryBuilds.length, label: 'Builds documentadas' },
  { value: leagueLaboratorySynergies.length, label: 'Sinergias confirmadas' },
  { value: leagueLaboratoryConcepts.length, label: 'Conceptos explicados' },
  { value: leagueLaboratoryPatches.length, label: 'Parches cubiertos' },
] as const;

const groups = [
  {
    title: 'ADCs',
    description:
      'El criterio de Tidusss sobre los ADC que juega y analiza, documentado campeón a campeón.',
    links: [
      {
        href: '/campeones/lucian',
        title: 'Guía completa de Lucian',
        description:
          'Build, runas, sinergias, matchups, power spikes y errores frecuentes.',
      },
      {
        href: '/campeones',
        title: 'ADCs',
        description: `Los ${adcRoster.length} ADC de la Tier List de Tidusss: tier, guías y vídeos relacionados.`,
      },
      {
        href: '/tier-list',
        title: 'Tier List oficial ADC',
        description: 'Clasificación editorial del meta actual, no un promedio de win rate.',
      },
      {
        href: '/academia',
        title: 'Aprende ADC',
        description: 'El vocabulario y los fundamentos de ADC, en fichas navegables.',
      },
    ],
  },
  {
    title: 'Contenido',
    description: 'Partidas, directos y el análisis detrás de cada decisión.',
    links: [
      {
        href: '/#contenido',
        title: 'Últimos vídeos',
        description: 'Gameplays y análisis recientes, directamente desde YouTube.',
      },
      {
        href: '/competitivo',
        title: 'Centro competitivo',
        description: 'Rango, LP, partidas recientes y el directo de Twitch cuando está activo.',
      },
      {
        href: '/actividad',
        title: 'Actividad reciente',
        description: 'Todo lo publicado y actualizado, en orden cronológico.',
      },
    ],
  },
  {
    title: 'Pregunta a Tidusss',
    description:
      'Resuelve dudas concretas de ADC con el contenido editorial ya publicado, al momento.',
    links: PREGUNTA_GENERAL_SUGGESTIONS.slice(0, 3).map((question) => ({
      href: `/pregunta?q=${encodeURIComponent(question)}`,
      title: question,
      description: 'Responde con el contenido editorial ya publicado.',
    })),
  },
  {
    /**
     * "Comunidad" describía mal este grupo: no hay nada de comunidad real
     * aquí (ni foro, ni Discord — eso ya vive en Contacto/Footer), solo
     * progreso del proyecto y su historial de cambios. "Proyecto" es
     * honesto con lo que hay dentro.
     */
    title: 'Proyecto',
    description: 'Cómo va el proyecto: objetivos, qué viene después y qué ha cambiado.',
    links: [
      {
        href: '/comunidad',
        title: 'Estado del proyecto',
        description: 'Objetivos actuales y últimos cambios, de un vistazo.',
      },
      {
        href: '/roadmap',
        title: 'Roadmap',
        description: 'Qué acaba de salir, qué está en marcha y qué está por llegar.',
      },
      {
        href: '/actualizaciones',
        title: 'Actualizaciones',
        description: 'El historial editorial completo: guías, builds y Tier List.',
      },
    ],
  },
] as const;

const pageTitle = 'Explorar · tidusss.es';
const pageDescription =
  'El índice completo de tidusss.es: guías, tier list, vídeos, directos, Pregunta a Tidusss y el estado del proyecto, todo en un solo sitio.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main>
    <LaboratoryHero
      eyebrow="Índice"
      title="Explorar"
      description="Todo lo que hay en tidusss.es, en un solo sitio: guías, herramientas, vídeos, directos y el estado del proyecto."
    />
    <section class="explore-page section-shell" aria-labelledby="explore-title">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <h2 id="explore-title" class="sr-only">Explorar tidusss.es</h2>

        <dl class="explore-stats" aria-label="ADCs en cifras">
          {
            stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="explore-groups">
          {
            groups.map((group) => (
              <div class="explore-group">
                <header>
                  <h3>{group.title}</h3>
                  <p>{group.description}</p>
                </header>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={'external' in link && link.external ? '_blank' : undefined}
                        rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                      >
                        <div>
                          <strong>{link.title}</strong>
                          <p>{link.description}</p>
                        </div>
                        <b aria-hidden="true">
                          {'external' in link && link.external ? '↗' : '→'}
                        </b>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
