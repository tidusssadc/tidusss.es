---
import About from '../components/About.astro';
import ActivityCenterCta from '../components/ActivityCenterCta.astro';
import AskTidusssPrompt from '../components/AskTidusssPrompt.astro';
import BrandClosing from '../components/BrandClosing.astro';
import BrandManifesto from '../components/BrandManifesto.astro';
import CompetitiveCredential from '../components/CompetitiveCredential.astro';
import Contact from '../components/Contact.astro';
import ContentSection from '../components/ContentSection.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HomePlatformShowcase from '../components/HomePlatformShowcase.astro';
import HomeStateEngine from '../components/HomeStateEngine.astro';
import LiveTeaser from '../components/LiveTeaser.astro';
import Navbar from '../components/Navbar.astro';
import Recognition from '../components/Recognition.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PREGUNTA_HOME_SUGGESTIONS } from '../data/pregunta';
---

<BaseLayout
  title="Tidusss — ADC Master, gameplays y SoloQ"
  description="Web oficial de Tidusss, ADC Master en EUW. Gameplays, directos, análisis de SoloQ, últimas partidas y evolución competitiva."
>
  <Navbar />
  <HomeStateEngine />
  <main>
    <Hero /><LiveTeaser /><HomePlatformShowcase /><CompetitiveCredential /><BrandManifesto
    /><ContentSection />
    <section
      class="section-shell"
      aria-labelledby="home-lab-title"
      data-reveal
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p class="eyebrow">El Laboratorio</p>
        <h2 id="home-lab-title" class="home-lab-title">
          El criterio de Tidusss, documentado.
        </h2>
        <div class="tools-grid mt-10">
          <a class="tool-card" href="/campeones/lucian">
            <strong>Guía de Lucian</strong>
            <p>Build, runas, sinergias y el criterio real detrás de cada decisión.</p>
            <span class="tool-card-cta">Ver guía <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/tier-list">
            <strong>Tier List oficial ADC</strong>
            <p>Clasificación editorial del meta actual, explicada partida a partida.</p>
            <span class="tool-card-cta">Ver Tier List <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/academia">
            <strong>Academia ADC</strong>
            <p>El vocabulario y los fundamentos de ADC, en fichas navegables.</p>
            <span class="tool-card-cta">Explorar <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/herramientas">
            <strong>Herramientas</strong>
            <p>Pregunta a Tidusss, Tier List, Centro de Campeones y más, en un solo sitio.</p>
            <span class="tool-card-cta">Ver todas <b aria-hidden="true">→</b></span>
          </a>
        </div>
      </div>
    </section>
    <ActivityCenterCta />
    <section
      id="pregunta-tidusss"
      class="section-shell"
      aria-label="¿Tienes una duda sobre Lucian?"
      data-reveal
    >
      <div class="mx-auto max-w-4xl px-5 sm:px-8">
        <AskTidusssPrompt
          title="¿Tienes una duda sobre Lucian?"
          description="Pregunta sobre builds, runas, combos, power spikes o la forma de jugar el campeón."
          questions={PREGUNTA_HOME_SUGGESTIONS}
        />
      </div>
    </section>
    <Recognition /><About /><Timeline /><Contact
    /><BrandClosing />
  </main>
  <Footer />
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reducedMotion)
    revealTargets.forEach((target) => target.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((target) => observer.observe(target));
  }
</script>
