---
import About from '../components/About.astro';
import CompetitiveCredential from '../components/CompetitiveCredential.astro';
import Contact from '../components/Contact.astro';
import ContentSection from '../components/ContentSection.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HomePlatformShowcase from '../components/HomePlatformShowcase.astro';
import Navbar from '../components/Navbar.astro';
import Recognition from '../components/Recognition.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tidusss — ADC Master EUW, YouTube y Twitch"
  description="Web oficial de Tidusss, creador de contenido y ADC Master en EUW especializado en Lucian. Gameplays, análisis, directos y actividad competitiva."
>
  <Navbar />
  <main>
    <Hero /><CompetitiveCredential /><HomePlatformShowcase /><Recognition
    /><ContentSection /><About /><Timeline /><Contact />
  </main>
  <Footer />
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reducedMotion)
    revealTargets.forEach((target) => target.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((target) => observer.observe(target));
  }
</script>
