---
import About from '../components/About.astro';
import AskTidusssPrompt from '../components/AskTidusssPrompt.astro';
import BrandClosing from '../components/BrandClosing.astro';
import BrandManifesto from '../components/BrandManifesto.astro';
import CompetitiveCredential from '../components/CompetitiveCredential.astro';
import Contact from '../components/Contact.astro';
import ContentSection from '../components/ContentSection.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HomePlatformShowcase from '../components/HomePlatformShowcase.astro';
import HomeStateEngine from '../components/HomeStateEngine.astro';
import HomeTodayModule from '../components/HomeTodayModule.astro';
import Navbar from '../components/Navbar.astro';
import Recognition from '../components/Recognition.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PREGUNTA_HOME_SUGGESTIONS } from '../data/pregunta';
---

<BaseLayout
  title="Tidusss — ADC Master, gameplays y SoloQ"
  description="Web oficial de Tidusss, ADC Master en EUW. Gameplays, directos, análisis de SoloQ, últimas partidas y evolución competitiva."
>
  <Navbar />
  <HomeStateEngine />
  <main>
    <!--
      Narrativa deliberada (Home V2): identidad → estado actual → hoy/contexto
      → plataformas → contenido → pregunta → autoridad → sobre Tidusss →
      explorar → contacto. LiveTeaser y ActivityCenterCta se retiraron de esta
      composición (duplicaban CompetitiveCredential / HomeTodayModule /
      ContentSection respectivamente) pero siguen existiendo como archivo.
    -->
    <Hero />
    <CompetitiveCredential />
    <HomeTodayModule />
    <HomePlatformShowcase />
    <BrandManifesto />
    <ContentSection />
    <section
      id="pregunta-tidusss"
      class="section-shell"
      aria-label="¿Tienes una duda de ADC?"
      data-reveal
    >
      <div class="mx-auto max-w-4xl px-5 sm:px-8">
        <AskTidusssPrompt
          title="¿Tienes una duda de ADC?"
          description="Pregunta sobre builds, runas, conceptos de juego o cualquier campeón de la Tier List — Lucian incluido."
          questions={PREGUNTA_HOME_SUGGESTIONS}
        />
      </div>
    </section>
    <Recognition /><About /><Timeline />
    <section class="section-shell" aria-labelledby="home-keep-exploring-title" data-reveal>
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p class="eyebrow">Sigue explorando</p>
        <h2 id="home-keep-exploring-title" class="home-lab-title">
          Esto no termina aquí.
        </h2>
        <div class="today-widgets mt-8">
          <a class="tool-card" href="/explorar">
            <strong>Explorar</strong>
            <p>El índice completo del sitio, con cifras reales del catálogo.</p>
            <span class="tool-card-cta">Explorar todo <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/actividad">
            <strong>Actividad</strong>
            <p>Vídeos, directos, partidas y cambios editoriales, en orden.</p>
            <span class="tool-card-cta">Ver actividad <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/academia">
            <strong>Academia ADC</strong>
            <p>El vocabulario y los fundamentos, en fichas navegables.</p>
            <span class="tool-card-cta">Ir a la Academia <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/pregunta">
            <strong>Pregunta a Tidusss</strong>
            <p>Resuelve una duda concreta con el contenido ya publicado.</p>
            <span class="tool-card-cta">Preguntar <b aria-hidden="true">→</b></span>
          </a>
          <a class="tool-card" href="/comunidad">
            <strong>Comunidad</strong>
            <p>Objetivos, roadmap y qué acaba de cambiar en el proyecto.</p>
            <span class="tool-card-cta">Ver estado <b aria-hidden="true">→</b></span>
          </a>
        </div>
      </div>
    </section>
    <Contact
    /><BrandClosing />
  </main>
  <Footer />
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reducedMotion)
    revealTargets.forEach((target) => target.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((target) => observer.observe(target));
  }
</script>
