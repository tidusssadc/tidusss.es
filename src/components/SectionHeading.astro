---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2
    class="mt-4 text-3xl font-bold tracking-[-0.035em] text-white sm:text-5xl"
  >
    {title}
  </h2>
  {
    description && (
      <p class="mt-5 text-base leading-7 text-slate-400 sm:text-lg">
        {description}
      </p>
    )
  }
</header>
