---
import { integrationEndpoints } from '../config/platforms';
---

<section
  id="competitivo-home"
  class="home-credential"
  data-home-credential
  data-home-target="competitive"
  data-endpoint={integrationEndpoints.riot}
  aria-labelledby="credential-title"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="home-credential-shell">
      <div class="home-credential-copy">
        <p class="eyebrow">Credencial competitiva</p>
        <h2 id="credential-title">
          Master es la credencial. Las decisiones son el contenido.
        </h2>
        <p>
          El rango confirma el nivel desde el que juego. Cada partida me da
          decisiones que revisar, explicar y convertir en contenido.
        </p>
        <a href="/competitivo"
          >Ver evolución competitiva <span aria-hidden="true">→</span></a
        >
      </div>

      <div class="credential-data" aria-live="polite" aria-busy="true">
        <div class="credential-rank">
          <img
            src="/images/brand/ranks/master-emblem.webp"
            width="640"
            height="512"
            alt="Emblema de rango Master"
            loading="lazy"
            decoding="async"
          />
          <div>
            <span>Solo/Duo · EUW</span>
            <strong data-credential-rank class="data-skeleton">&nbsp;</strong>
            <small data-credential-lp class="data-skeleton">&nbsp;</small>
          </div>
        </div>
        <dl>
          <div>
            <dt>Riot ID</dt>
            <dd data-credential-riot>Tidusss#FFX</dd>
          </div>
          <div>
            <dt>Muestra reciente</dt>
            <dd data-credential-record class="data-skeleton">&nbsp;</dd>
          </div>
          <div>
            <dt>Win rate</dt>
            <dd data-credential-winrate class="data-skeleton">&nbsp;</dd>
          </div>
          <div>
            <dt>Última actividad</dt>
            <dd data-credential-activity class="data-skeleton">&nbsp;</dd>
          </div>
        </dl>
        <p data-credential-state hidden></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { publishHomeSignal } from '../domain/home-state';
  import { goals } from '../config/goals';
  import { relativeTime } from '../lib/time';
  import type { RiotPublicResponse } from '../lib/riot';

  // Nunca un número de LP repetido a mano: el objetivo real vive en
  // `config/goals.ts` — leerlo aquí evita que este script se desincronice
  // del hito real cuando el LP ya lo supera (regresión corregida en Fase V).
  const soloQueueGoal = goals.find((goal) => goal.id === 'soloqueue-700');
  const soloQueueTarget = soloQueueGoal?.target ?? 0;

  const credential = document.querySelector<HTMLElement>(
    '[data-home-credential]',
  );
  const setCredential = (selector: string, value: string) => {
    const node = credential?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.textContent = value;
    node.classList.remove('data-skeleton');
  };

  if (credential)
    fetch(credential.dataset.endpoint!)
      .then((response) => response.json() as Promise<RiotPublicResponse>)
      .then((payload) => {
        if (!payload.ok) throw new Error(payload.error.code);
        const { profile, ranked, recent } = payload.data;
        publishHomeSignal({
          type: 'competitive',
          rank: ranked.tier,
          leaguePoints: ranked.leaguePoints,
          goals:
            ranked.leaguePoints === undefined
              ? []
              : [
                  {
                    id: 'goal:soloqueue-700',
                    label: 'LP',
                    current: ranked.leaguePoints,
                    target: soloQueueTarget,
                    progress: Math.min(100, (ranked.leaguePoints / soloQueueTarget) * 100),
                  },
                ],
        });
        setCredential(
          '[data-credential-rank]',
          ranked.available
            ? (ranked.tier ?? 'Clasificado')
            : 'Sin clasificación',
        );
        setCredential(
          '[data-credential-lp]',
          ranked.leaguePoints === undefined
            ? 'LP no disponibles'
            : `${ranked.leaguePoints} LP`,
        );
        setCredential('[data-credential-riot]', profile.riotId);
        setCredential(
          '[data-credential-record]',
          recent.sampleSize
            ? `${recent.wins}V · ${recent.losses}D · ${recent.sampleSize} partidas`
            : 'Sin partidas recientes',
        );
        setCredential(
          '[data-credential-winrate]',
          recent.winRate === undefined ? 'Sin muestra' : `${recent.winRate}%`,
        );
        setCredential(
          '[data-credential-activity]',
          recent.matches[0]?.playedAt
            ? (relativeTime(recent.matches[0].playedAt) ?? 'Reciente')
            : 'Sin actividad reciente',
        );
        credential
          .querySelector('[aria-busy]')
          ?.setAttribute('aria-busy', 'false');
      })
      .catch(() => {
        credential
          .querySelectorAll('.data-skeleton')
          .forEach((node) => node.classList.remove('data-skeleton'));
        const state = credential.querySelector<HTMLElement>(
          '[data-credential-state]',
        );
        if (state) {
          state.hidden = false;
          state.textContent =
            'La credencial no se ha podido actualizar. El perfil completo sigue disponible en Live.';
        }
        credential
          .querySelector('[aria-busy]')
          ?.setAttribute('aria-busy', 'false');
      });
</script>
