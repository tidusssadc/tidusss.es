---
import { site } from '../data/site';
---

<main class="grid min-h-screen place-items-center px-6 py-16">
  <section class="text-center" aria-labelledby="page-title">
    <p
      class="mb-4 text-xs font-semibold tracking-[0.32em] text-slate-400 uppercase"
    >
      Web oficial
    </p>
    <h1
      id="page-title"
      class="text-4xl font-semibold tracking-tight text-white sm:text-6xl"
    >
      {site.name}
      <span class="text-slate-500">—</span> Próximamente
    </h1>
  </section>
</main>
