---
import type { EditorialReviewStatus, EditorialTake } from '../../domain/league-laboratory';
import TraitList from './TraitList.astro';

interface Props {
  take: EditorialTake;
  reviewStatus: EditorialReviewStatus;
  strengths?: readonly string[];
  weaknesses?: readonly string[];
  /** Cuándo elegirlo en SoloQ — solo si hay una opinión real detrás. */
  idealIf?: string;
  /** El riesgo/contexto que lo hace peor pick — mismo criterio que `idealIf`. */
  watchFor?: string;
  /** Enlace a la ficha del campeón en el Laboratorio, cuando existe una página real. */
  championHref?: string;
  /**
   * "Guía de <Campeón>" solo cuando /campeones/<slug> es de verdad una guía
   * editorial (perfil publicado) — si no, se mantiene "Ficha del campeón"
   * (ver `hasChampionGuide` en TierListSection/TierListCounterSection/
   * TierListPendingSection).
   */
  championLinkLabel?: string;
}
const {
  take,
  reviewStatus,
  strengths,
  weaknesses,
  idealIf,
  watchFor,
  championHref,
  championLinkLabel = 'Ficha del campeón',
} = Astro.props;
---

<div class="editorial-take" data-review-status={reviewStatus}>
  {
    reviewStatus === 'placeholder' ? (
      <>
        <span class="editorial-take-draft-flag">Análisis de Tidusss próximamente</span>
        <p class="editorial-take-verdict">{take.verdict}</p>
      </>
    ) : (
      <>
        <p class="editorial-take-verdict">{take.verdict}</p>
        <div class="editorial-take-actions">
          <details class="editorial-take-details">
            <summary>
              <span data-state="closed">Ver análisis ↓</span>
              <span data-state="open">Cerrar análisis ↑</span>
            </summary>
            <div class="editorial-take-body">
              <span class="editorial-take-label">El veredicto de Tidusss</span>
              <p class="editorial-take-reasoning">{take.reasoning}</p>
              {idealIf && (
                <p class="editorial-take-hint editorial-take-hint--ideal">
                  <span>Ideal si</span>
                  {idealIf}
                </p>
              )}
              {watchFor && (
                <p class="editorial-take-hint editorial-take-hint--watch">
                  <span>Cuidado con</span>
                  {watchFor}
                </p>
              )}
              <TraitList label="Fortalezas" items={strengths ?? []} />
              <TraitList label="Debilidades" items={weaknesses ?? []} />
            </div>
          </details>
          {championHref && (
            <a class="editorial-take-champion-link" href={championHref}>
              {championLinkLabel} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </>
    )
  }
</div>
