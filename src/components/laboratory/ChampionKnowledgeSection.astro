---
import ShareLinkButton from '../ShareLinkButton.astro';

interface Props {
  id: string;
  title: string;
  /**
   * Cuándo es `false`, la sección entera desaparece — sin cabecera, sin
   * "próximamente", sin "pendiente de análisis". Una guía rica no debe
   * sentirse como una lista de huecos por rellenar; lo que todavía no
   * existe simplemente no ocupa espacio (ver auditoría de /campeones/lucian).
   */
  hasContent: boolean;
  /** Solo el bloque de Build lo activa hoy — el encargo prioriza guía, build, conceptos y Tier List, nunca todas las secciones a la vez. */
  showShareLink?: boolean;
}
const { id, title, hasContent, showShareLink } = Astro.props;
---

{
  hasContent && (
    <section
      id={id}
      class="champion-knowledge-section"
      aria-labelledby={`${id}-heading`}
    >
      <div class="champion-knowledge-heading">
        <h3 id={`${id}-heading`}>{title}</h3>
        {
          showShareLink && (
            <ShareLinkButton
              class="share-link-button-icon"
              href={`${Astro.url.pathname}#${id}`}
              label={`Copiar enlace a ${title}`}
            />
          )
        }
      </div>
      <slot />
    </section>
  )
}
