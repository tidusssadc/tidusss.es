---
import EmptyLaboratoryState from './EmptyLaboratoryState.astro';
import ShareLinkButton from '../ShareLinkButton.astro';

interface Props {
  id: string;
  title: string;
  hasContent: boolean;
  emptyTitle: string;
  emptyDescription: string;
  emptyCtaHref?: string;
  emptyCtaLabel?: string;
  emptyCtaExternal?: boolean;
  /** Solo el bloque de Build lo activa hoy — el encargo prioriza guía, build, conceptos y Tier List, nunca todas las secciones a la vez. */
  showShareLink?: boolean;
}
const {
  id,
  title,
  hasContent,
  emptyTitle,
  emptyDescription,
  emptyCtaHref,
  emptyCtaLabel,
  emptyCtaExternal,
  showShareLink,
} = Astro.props;
---

<section
  id={id}
  class="champion-knowledge-section"
  aria-labelledby={`${id}-heading`}
>
  <div class="champion-knowledge-heading">
    <h3 id={`${id}-heading`}>{title}</h3>
    {
      showShareLink && hasContent && (
        <ShareLinkButton
          class="share-link-button-icon"
          href={`${Astro.url.pathname}#${id}`}
          label={`Copiar enlace a ${title}`}
        />
      )
    }
  </div>
  {
    hasContent ? (
      <slot />
    ) : (
      <EmptyLaboratoryState
        title={emptyTitle}
        description={emptyDescription}
        ctaHref={emptyCtaHref}
        ctaLabel={emptyCtaLabel}
        ctaExternal={emptyCtaExternal}
      />
    )
  }
</section>
