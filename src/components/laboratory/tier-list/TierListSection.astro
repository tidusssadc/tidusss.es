---
import type {
  ChampionCatalogEntry,
  LabChampionId,
  ReviewedTierListEntry,
  Role,
  TierGrade,
} from '../../../domain/league-laboratory';
import ChampionIdentity from '../ChampionIdentity.astro';
import EditorialTakeCard from '../EditorialTakeCard.astro';
import TierBadge from '../TierBadge.astro';

interface Props {
  tier: TierGrade;
  entries: ReviewedTierListEntry[];
  champions: Map<LabChampionId, ChampionCatalogEntry>;
  role: Role;
  dataDragonVersion: string;
  /** Campeones cuya /campeones/<slug> es de verdad una guía editorial publicada, no solo una ficha básica. */
  championIdsWithGuide: ReadonlySet<LabChampionId>;
}
const { tier, entries, champions, role, dataDragonVersion, championIdsWithGuide } =
  Astro.props;
const slug = tier.toLowerCase().replace('+', '-plus');
---

{
  entries.length > 0 && (
    <section
      class="tier-list-row"
      data-tier={slug}
      aria-labelledby={`tier-${slug}-heading`}
    >
      <header>
        <TierBadge tier={tier} />
        <h3 id={`tier-${slug}-heading`} class="sr-only">
          Tier {tier}
        </h3>
      </header>
      <ul>
        {entries.map((entry) => {
          const champion = champions.get(entry.championId);
          return (
            champion && (
              <li
                class="tier-list-entry"
                data-champion={champion.slug}
                id={`campeon-${champion.slug}`}
              >
                <div class="tier-list-entry-summary">
                  <ChampionIdentity
                    champion={champion}
                    role={role}
                    dataDragonVersion={dataDragonVersion}
                  />
                  <TierBadge tier={tier} compact />
                </div>
                <EditorialTakeCard
                  take={entry.editorialTake}
                  reviewStatus="reviewed"
                  strengths={entry.strengths}
                  weaknesses={entry.weaknesses}
                  idealIf={entry.idealIf}
                  watchFor={entry.watchFor}
                  championHref={`/campeones/${champion.slug}`}
                  championLinkLabel={
                    championIdsWithGuide.has(entry.championId)
                      ? `Guía de ${champion.name}`
                      : 'Ficha del campeón'
                  }
                />
              </li>
            )
          );
        })}
      </ul>
    </section>
  )
}
