---
import TierBadge from '../TierBadge.astro';
import type { TierGrade } from '../../../domain/league-laboratory';

// Leyenda compacta de una sola línea (wrap natural en móvil). Solo las
// categorías reales de la Tier List 26.17 — sin S+ ni Pendientes.
const legend: { tier: TierGrade; description: string }[] = [
  { tier: 'S', description: 'Top del meta' },
  { tier: 'A', description: 'Muy fuerte' },
  { tier: 'B', description: 'Buen pick' },
  { tier: 'C', description: 'Situacional' },
  { tier: 'D', description: 'Débil' },
];
---

<div class="tier-list-legend" aria-label="Leyenda de tiers">
  {
    legend.map(({ tier, description }) => (
      <span class="tier-list-legend-item">
        <TierBadge tier={tier} compact />
        {description}
      </span>
    ))
  }
  <span class="tier-list-legend-item">
    <span class="lab-badge">Counter</span>
    Depende del matchup, no es un tier inferior
  </span>
</div>
