---
interface Props {
  /** Solo se muestra el chip "Pendientes" si de verdad hay campeones sin revisar publicados. */
  hasPendingEntries?: boolean;
}
const { hasPendingEntries = false } = Astro.props;

// Mismas categorías reales que TierListLegend: S, Counter, A, B, C, D.
const filterChips: { value: string; label: string }[] = [
  { value: 's', label: 'S' },
  { value: 'counter', label: 'Counter' },
  { value: 'a', label: 'A' },
  { value: 'b', label: 'B' },
  { value: 'c', label: 'C' },
  { value: 'd', label: 'D' },
];
---

<div
  class="tier-list-filters"
  data-tier-list-filters
  role="search"
  aria-label="Filtrar la tier list"
>
  <div class="tier-list-filter-chips" role="group" aria-label="Filtrar por tier">
    <button type="button" data-tier-filter="all" aria-pressed="true">Todos</button>
    {
      filterChips.map(({ value, label }) => (
        <button type="button" data-tier-filter={value} aria-pressed="false">
          {label}
        </button>
      ))
    }
    {
      hasPendingEntries && (
        <button type="button" data-tier-filter="placeholder" aria-pressed="false">
          Pendientes
        </button>
      )
    }
  </div>
  <label class="tier-list-search">
    <span class="sr-only">Buscar campeón</span>
    <input
      type="search"
      data-tier-list-search
      placeholder="Buscar campeón…"
      autocomplete="off"
    />
  </label>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tier-list-filters]');
  const chips = [
    ...(root?.querySelectorAll<HTMLButtonElement>('[data-tier-filter]') ?? []),
  ];
  const search = root?.querySelector<HTMLInputElement>('[data-tier-list-search]');
  const entries = [
    ...document.querySelectorAll<HTMLElement>('.tier-list-entry'),
  ];
  // El wall de campeones se agrupa en filas por tier y en la sección de
  // counter picks — ambas se ocultan igual cuando ninguno de sus campeones
  // coincide con el filtro activo (ver `data-tier` en ambas).
  const rows = [
    ...document.querySelectorAll<HTMLElement>('.tier-list-row, .tier-list-counter'),
  ];
  const pendingSection =
    document.querySelector<HTMLElement>('.tier-list-pending');

  let activeTier = 'all';

  const championName = (entry: HTMLElement) =>
    entry.querySelector('strong')?.textContent?.toLocaleLowerCase('es-ES') ??
    '';

  const applyFilters = () => {
    const query = (search?.value ?? '').trim().toLocaleLowerCase('es-ES');
    entries.forEach((entry) => {
      const isPlaceholder = entry.classList.contains(
        'tier-list-entry--placeholder',
      );
      const entryTier = entry.closest<HTMLElement>('[data-tier]')?.dataset
        .tier;
      const matchesTier =
        activeTier === 'all' ||
        (activeTier === 'placeholder' && isPlaceholder) ||
        entryTier === activeTier;
      const matchesQuery = !query || championName(entry).includes(query);
      entry.hidden = !(matchesTier && matchesQuery);
    });
    rows.forEach((row) => {
      const visible = [
        ...row.querySelectorAll<HTMLElement>('.tier-list-entry'),
      ].some((entry) => !entry.hidden);
      row.hidden = !visible;
    });
    if (pendingSection) {
      const visible = [
        ...pendingSection.querySelectorAll<HTMLElement>('.tier-list-entry'),
      ].some((entry) => !entry.hidden);
      pendingSection.hidden = !visible;
    }
  };

  const selectChip = (chip: HTMLButtonElement) => {
    activeTier = chip.dataset.tierFilter ?? 'all';
    chips.forEach((candidate) =>
      candidate.setAttribute('aria-pressed', String(candidate === chip)),
    );
    applyFilters();
  };

  chips.forEach((chip) => chip.addEventListener('click', () => selectChip(chip)));
  search?.addEventListener('input', applyFilters);

  const params = new URLSearchParams(location.search);
  const initialTier = params.get('tier');
  if (initialTier) {
    const chip = chips.find(
      (candidate) => candidate.dataset.tierFilter === initialTier,
    );
    if (chip) selectChip(chip);
  }
  const initialChampion =
    params.get('champion') ?? location.hash.replace('#campeon-', '');
  if (initialChampion) {
    const target = document.getElementById(`campeon-${initialChampion}`);
    target?.querySelector('details')?.setAttribute('open', '');
    target?.scrollIntoView({ block: 'center' });
  }
</script>
