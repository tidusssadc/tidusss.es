---
interface Props {
  classOptions: readonly string[];
}
const { classOptions } = Astro.props;

/**
 * Pocos filtros, de alta utilidad, sobre datos reales — no los 6 controles
 * de antes (estado/dificultad/clase/inicial/tier list/orden). 'Con
 * contenido' fusiona 'reviewed' + 'draft' en el filtro (la fila individual
 * sigue distinguiendo los dos internamente vía `EditorialStatusBadge`):
 * para decidir "¿hay algo que leer aquí?", la distinción entre borrador y
 * revisado es secundaria. Dificultad e inicial se retiraron: el buscador
 * por nombre ya cubre "encontrar un campeón concreto" mejor que un
 * selector de 27 letras.
 */
const statusOptions = [
  { value: 'all', label: 'Todos' },
  { value: 'has-content', label: 'Con contenido' },
  { value: 'pending', label: 'Pendientes' },
] as const;
---

<div
  class="laboratory-search"
  data-laboratory-search
  role="search"
  aria-label="Buscar y filtrar en el catálogo de campeones"
>
  <label class="laboratory-search-input">
    <span class="sr-only">Buscar campeón por nombre</span>
    <input
      type="search"
      data-hub-search
      placeholder="Buscar campeón… (p. ej. kaisa, dr mundo, jarvan)"
      autocomplete="off"
    />
  </label>

  <div class="laboratory-search-filters">
    <div
      class="laboratory-filter-chips"
      role="group"
      aria-label="Filtrar por estado editorial"
    >
      {
        statusOptions.map(({ value, label }) => (
          <button
            type="button"
            data-hub-filter="status"
            data-value={value}
            aria-pressed={value === 'all' ? 'true' : 'false'}
          >
            {label}
          </button>
        ))
      }
      <button
        type="button"
        data-hub-filter="adc"
        data-value="adc"
        aria-pressed="false"
        title="Campeones con entrada real en la Tier List ADC de Tidusss"
      >
        ADC
      </button>
    </div>

    <label class="laboratory-search-select">
      <span class="sr-only">Filtrar por clase oficial</span>
      <select data-hub-class-select>
        <option value="all">Todas las clases</option>
        {
          classOptions.map((tag) => (
            <option value={tag.toLowerCase()}>{tag}</option>
          ))
        }
      </select>
    </label>

    <label class="laboratory-search-select">
      <span class="sr-only">Ordenar catálogo</span>
      <select data-hub-sort>
        <option value="name-asc">Nombre (A-Z)</option>
        <option value="name-desc">Nombre (Z-A)</option>
        <option value="status">Con contenido primero</option>
      </select>
    </label>
  </div>

  <p
    class="laboratory-search-results"
    role="status"
    aria-live="polite"
    data-hub-results-count
  >
  </p>
</div>

<script>
  import { normalizeSearchText } from '../../domain/league-laboratory';

  const root = document.querySelector<HTMLElement>('[data-laboratory-search]');
  const searchInput =
    root?.querySelector<HTMLInputElement>('[data-hub-search]');
  const classSelect = root?.querySelector<HTMLSelectElement>(
    '[data-hub-class-select]',
  );
  const resultsCount = root?.querySelector<HTMLElement>(
    '[data-hub-results-count]',
  );
  const statusChips = [
    ...(root?.querySelectorAll<HTMLButtonElement>(
      '[data-hub-filter="status"]',
    ) ?? []),
  ];
  const adcChip = root?.querySelector<HTMLButtonElement>(
    '[data-hub-filter="adc"]',
  );
  const rows = [
    ...document.querySelectorAll<HTMLElement>('[data-champion-catalog-row]'),
  ];
  const catalogGrid = document.querySelector<HTMLElement>(
    '[data-champion-catalog-grid]',
  );
  const sortSelect = root?.querySelector<HTMLSelectElement>('[data-hub-sort]');
  const emptyState = document.querySelector<HTMLElement>(
    '[data-champion-catalog-empty]',
  );

  const state = {
    status: 'all',
    class: 'all',
    adc: false,
    query: '',
    sort: 'name-asc',
  };

  const statusWeight: Record<string, number> = {
    reviewed: 0,
    draft: 1,
    pending: 2,
  };

  const applySort = () => {
    if (!catalogGrid) return;
    const sorted = [...rows].sort((a, b) => {
      if (state.sort === 'status') {
        const weightDiff =
          (statusWeight[a.dataset.status ?? 'pending'] ?? 3) -
          (statusWeight[b.dataset.status ?? 'pending'] ?? 3);
        if (weightDiff !== 0) return weightDiff;
      }
      const nameA = a.dataset.name ?? '';
      const nameB = b.dataset.name ?? '';
      const compared = nameA.localeCompare(nameB, 'es');
      return state.sort === 'name-desc' ? -compared : compared;
    });
    catalogGrid.append(...sorted);
  };

  /**
   * 173 filas siempre en el DOM sería el mismo problema de altura de
   * antes, solo que en varias columnas. Sin ningún filtro activo se
   * muestran como mucho `CATALOG_PREVIEW_CAP` — el resto sigue siendo
   * real y accesible con un clic ("Mostrar los 173 campeones"), y
   * cualquier búsqueda o filtro real desactiva el límite: nunca se oculta
   * un resultado que el usuario pidió explícitamente.
   */
  const CATALOG_PREVIEW_CAP = 30;
  let catalogExpanded = false;
  const showMoreButton = document.querySelector<HTMLButtonElement>(
    '[data-champion-catalog-show-more]',
  );
  const isDefaultState = () =>
    !state.query && state.status === 'all' && state.class === 'all' && !state.adc;
  // El orden real en pantalla (tras `applySort`), no el orden de carga —
  // el límite debe respetar lo que el usuario ve, no el DOM original.
  const orderedRows = (): HTMLElement[] =>
    catalogGrid ? ([...catalogGrid.children] as HTMLElement[]) : rows;

  const applyFilters = () => {
    const capActive = !catalogExpanded && isDefaultState();
    let shownCount = 0;
    let matchedCount = 0;
    for (const row of orderedRows()) {
      const rowStatus = row.dataset.status;
      const matchesStatus =
        state.status === 'all' ||
        (state.status === 'has-content'
          ? rowStatus === 'reviewed' || rowStatus === 'draft'
          : rowStatus === state.status);
      const rowTags = (row.dataset.tags ?? '').split(',');
      const matchesClass =
        state.class === 'all' || rowTags.includes(state.class);
      const matchesAdc = !state.adc || row.dataset.tierlist === 'true';
      const matchesQuery =
        !state.query ||
        normalizeSearchText(row.dataset.search ?? '').includes(
          normalizeSearchText(state.query),
        );
      const matches =
        matchesStatus && matchesClass && matchesAdc && matchesQuery;
      if (matches) matchedCount += 1;
      const shown = matches && (!capActive || shownCount < CATALOG_PREVIEW_CAP);
      row.hidden = !shown;
      if (shown) shownCount += 1;
    }
    if (resultsCount) {
      resultsCount.textContent =
        matchedCount === rows.length
          ? capActive
            ? `Mostrando ${shownCount} de los ${rows.length} campeones del catálogo.`
            : `Mostrando los ${rows.length} campeones del catálogo.`
          : `${matchedCount} de ${rows.length} campeones coinciden con estos filtros.`;
    }
    if (emptyState) emptyState.hidden = matchedCount > 0;
    if (showMoreButton) {
      const hasMore = capActive && matchedCount > shownCount;
      showMoreButton.hidden = !hasMore;
      if (hasMore)
        showMoreButton.textContent = `Mostrar los ${matchedCount} campeones`;
    }
  };

  const syncUrl = () => {
    const params = new URLSearchParams();
    if (state.query) params.set('q', state.query);
    if (state.status !== 'all') params.set('estado', state.status);
    if (state.class !== 'all') params.set('clase', state.class);
    if (state.adc) params.set('adc', '1');
    const query = params.toString();
    const nextUrl = query ? `${location.pathname}?${query}` : location.pathname;
    history.replaceState(null, '', nextUrl);
  };

  const update = () => {
    applyFilters();
    syncUrl();
  };

  sortSelect?.addEventListener('change', () => {
    state.sort = sortSelect.value;
    applySort();
  });

  const selectChip = (chips: HTMLButtonElement[], chip: HTMLButtonElement) => {
    chips.forEach((candidate) =>
      candidate.setAttribute('aria-pressed', String(candidate === chip)),
    );
  };

  searchInput?.addEventListener('input', () => {
    state.query = searchInput.value.trim();
    update();
  });
  statusChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      state.status = chip.dataset.value ?? 'all';
      selectChip(statusChips, chip);
      update();
    }),
  );
  classSelect?.addEventListener('change', () => {
    state.class = classSelect.value;
    update();
  });
  adcChip?.addEventListener('click', () => {
    state.adc = !state.adc;
    adcChip.setAttribute('aria-pressed', String(state.adc));
    update();
  });
  showMoreButton?.addEventListener('click', () => {
    catalogExpanded = true;
    applyFilters();
  });

  // Estado inicial desde la URL: un enlace con `?estado=reviewed&clase=marksman`
  // debe abrir la página ya filtrada igual que la vio quien lo compartió.
  const params = new URLSearchParams(location.search);
  const initialQuery = params.get('q');
  if (initialQuery && searchInput) {
    searchInput.value = initialQuery;
    state.query = initialQuery;
  }
  const initialStatus = params.get('estado');
  if (initialStatus) {
    const chip = statusChips.find(
      (candidate) => candidate.dataset.value === initialStatus,
    );
    if (chip) {
      state.status = initialStatus;
      selectChip(statusChips, chip);
    }
  }
  const initialClass = params.get('clase');
  if (initialClass && classSelect) {
    const option = [...classSelect.options].find(
      (candidate) => candidate.value === initialClass,
    );
    if (option) {
      classSelect.value = initialClass;
      state.class = initialClass;
    }
  }
  if (params.get('adc') === '1' && adcChip) {
    state.adc = true;
    adcChip.setAttribute('aria-pressed', 'true');
  }

  applySort();
  applyFilters();
</script>
