---
import type {
  ChampionCatalogEntry,
  ChampionEditorialStatus,
} from '../../../domain/league-laboratory';
import { resolveRiotDifficultyBucket } from '../../../domain/league-laboratory';
import { dataDragonUrls } from '../../../lib/riot/datadragon';
import EditorialStatusBadge from '../EditorialStatusBadge.astro';

interface Props {
  catalogEntry: ChampionCatalogEntry;
  status: ChampionEditorialStatus;
  dataDragonVersion: string;
  inTierList: boolean;
}
const { catalogEntry, status, dataDragonVersion, inTierList } = Astro.props;
const iconUrl = dataDragonUrls(dataDragonVersion).champion(
  catalogEntry.dataDragonKey,
);
const difficultyBucket = resolveRiotDifficultyBucket(
  catalogEntry.riotDifficulty,
);
const initial = catalogEntry.name.charAt(0).toLocaleUpperCase('es-ES');
const searchText = `${catalogEntry.name} ${catalogEntry.title}`;
---

<li
  class="champion-catalog-row"
  data-champion-catalog-row
  data-status={status}
  data-tags={catalogEntry.tags.join(',').toLowerCase()}
  data-difficulty={difficultyBucket}
  data-initial={initial}
  data-tierlist={String(inTierList)}
  data-search={searchText}
>
  <a href={`/campeones/${catalogEntry.slug}`}>
    <img
      src={iconUrl}
      width="44"
      height="44"
      loading="lazy"
      decoding="async"
      alt=""
    />
    <span class="champion-catalog-row-name">
      <strong>{catalogEntry.name}</strong>
      <small>{catalogEntry.title}</small>
    </span>
    <span class="champion-catalog-row-tags"
      >{catalogEntry.tags.join(' · ')}</span
    >
    <EditorialStatusBadge status={status} />
  </a>
</li>
