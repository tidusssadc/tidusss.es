---
import type { ChampionKnowledge } from '../../../domain/league-laboratory';
import EmptyLaboratoryState from '../EmptyLaboratoryState.astro';
import TierBadge from '../TierBadge.astro';

interface Props {
  championName: string;
  championSlug: string;
  tierListAppearances: ChampionKnowledge['tierListAppearances'];
  /** Etiqueta del parche vigente de esta edición ("26.17") — resuelta por quien llama (`leagueLaboratoryPatches`), nunca inferida aquí ni duplicada a mano. */
  patchLabel?: string;
}
const { championName, championSlug, tierListAppearances, patchLabel } = Astro.props;
const appearance = tierListAppearances[0];
---

{
  appearance ? (
    <a
      class="champion-tier-status"
      href={`/tier-list?champion=${championSlug}`}
    >
      <span class="champion-tier-status-label">Tier List actual</span>
      <div class="champion-tier-status-heading">
        {appearance.entry.reviewStatus === 'reviewed' ? (
          <TierBadge tier={appearance.entry.tier} compact />
        ) : (
          <span class="tier-badge" data-tier="pending" aria-hidden="true">
            ?
          </span>
        )}
        <strong>{championName}</strong>
        {patchLabel && (
          <span class="champion-tier-status-patch">Parche {patchLabel}</span>
        )}
      </div>
      {
        appearance.entry.reviewStatus === 'reviewed' && (
          <p class="champion-tier-status-verdict">
            {appearance.entry.editorialTake.verdict}
          </p>
        )
      }
      <span class="champion-tier-status-link">
        {appearance.entry.reviewStatus === 'reviewed'
          ? 'Ver en la Tier List oficial'
          : 'Todavía sin clasificar — ver estado en la Tier List'}{' '}
        <span aria-hidden="true">→</span>
      </span>
    </a>
  ) : (
    <EmptyLaboratoryState
      title="Todavía no aparece en ninguna Tier List"
      description="Se añadirá aquí en cuanto tenga una entrada publicada."
    />
  )
}
