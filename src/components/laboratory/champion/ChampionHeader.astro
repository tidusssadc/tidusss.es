---
import type {
  ChampionCatalogEntry,
  LabChampion,
  Role,
} from '../../../domain/league-laboratory';
import { dataDragonUrls } from '../../../lib/riot/datadragon';
import ConfidenceIndicator from '../ConfidenceIndicator.astro';
import RoleBadge from '../RoleBadge.astro';
import ShareLinkButton from '../../ShareLinkButton.astro';

interface Props {
  catalogEntry: ChampionCatalogEntry;
  labChampion?: LabChampion;
  role?: Role;
  dataDragonVersion: string;
}
const { catalogEntry, labChampion, role, dataDragonVersion } = Astro.props;
const portraitUrl = dataDragonUrls(dataDragonVersion).championLoading(
  catalogEntry.dataDragonKey,
);
const hasProfile = Boolean(labChampion?.profile);
---

<header class="champion-header" aria-labelledby="champion-name">
  <div class="champion-header-portrait">
    <img
      src={portraitUrl}
      width="308"
      height="560"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="champion-header-identity">
    <p class="eyebrow">El Laboratorio · Explorador de campeones</p>
    <h1 id="champion-name">{catalogEntry.name}</h1>
    <p class="champion-header-title">{catalogEntry.title}</p>
    <div class="champion-header-badges">
      {role && <RoleBadge role={role} />}
      <span class="lab-badge lab-badge--class">
        <span class="lab-badge-label">Clase</span>
        <strong>{catalogEntry.tags.join(' · ')}</strong>
      </span>
      {
        labChampion?.isSignatureChampion && (
          <span class="lab-badge lab-badge--signature">
            <strong>Especialidad de Tidusss</strong>
          </span>
        )
      }
    </div>
    <p class="champion-header-riot-difficulty">
      Dificultad según Riot{' '}
      <strong>{catalogEntry.riotDifficulty} / 10</strong>
    </p>
    <p class="champion-header-status">
      {
        hasProfile
          ? 'Perfil editorial de Tidusss completo'
          : 'Tidusss todavía no ha escrito su perfil editorial'
      }
    </p>
    {
      hasProfile && labChampion?.profile && (
        <ConfidenceIndicator
          confidence={labChampion.profile.editorialTake.confidence}
        />
      )
    }
    {
      hasProfile && (
        <div class="champion-header-actions">
          <ShareLinkButton label="Compartir esta guía" />
        </div>
      )
    }
  </div>
</header>
