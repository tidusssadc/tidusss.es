---
import type { ChampionCatalogEntry, Role } from '../../domain/league-laboratory';
import { dataDragonUrls } from '../../lib/riot/datadragon';

interface Props {
  champion: ChampionCatalogEntry;
  /** Ya se sobreentiende en esta Tier List ADC — no se muestra aquí, ver TierListSection/TierListCounterSection/TierListPendingSection. */
  role: Role;
  dataDragonVersion: string;
}
const { champion, dataDragonVersion } = Astro.props;
const iconUrl = dataDragonUrls(dataDragonVersion).champion(
  champion.dataDragonKey,
);
---

<div class="champion-identity">
  <img src={iconUrl} width="56" height="56" loading="lazy" decoding="async" alt="" />
  <strong>{champion.name}</strong>
</div>
