---
import { getPrimaryConnection } from '../domain/content-graph';

const next = getPrimaryConnection('creator-project:tidusss');
---

<section
  class="brand-closing"
  aria-labelledby="brand-closing-title"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow">Tidusss</p>
    <h2 id="brand-closing-title">Cada combo cuenta.</h2>
    <p>Pero ninguna decisión ocurre sola.</p>
    {
      next?.target.href && (
        <a href={next.target.href}>
          {next.relation.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>
