---
/**
 * Buscador global: localiza contenido real y navega a él. Distinto de
 * "Pregunta a Tidusss" (que construye una respuesta editorial) — aquí no se
 * genera nada, solo se encuentra. El diálogo vive una única vez dentro de
 * `Navbar.astro` (el único componente presente en todas las páginas
 * reales); los botones que lo abren se definen donde tengan sentido
 * visualmente (aquí, en el propio `Navbar`) y se enganchan por atributo
 * `data-search-open`, así que pueden vivir en cualquier punto del DOM —
 * incluida una página futura sin `Navbar`, como la 404.
 */
---

<dialog class="global-search" data-search-dialog aria-label="Buscar en tidusss.es">
  <div class="global-search-panel">
    <div class="global-search-field">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.6" />
        <path d="M17 17L13.4 13.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="Busca Navori, Lucian, spacing, Tier List…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Buscar en tidusss.es"
        aria-controls="global-search-results"
        aria-expanded="false"
        aria-activedescendant=""
        role="combobox"
        aria-autocomplete="list"
      />
      <button type="button" class="global-search-close" data-search-close aria-label="Cerrar buscador">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <div
      class="global-search-body"
      id="global-search-results"
      role="listbox"
      aria-label="Resultados de búsqueda"
      data-search-results
    >
    </div>
    <div class="global-search-footer">
      <span class="global-search-hint"><kbd>↑↓</kbd> navegar</span>
      <span class="global-search-hint"><kbd>Enter</kbd> abrir</span>
      <span class="global-search-hint"><kbd>Esc</kbd> cerrar</span>
      <a class="global-search-full-link" data-search-full-link href="/buscar" hidden
        >Ver todos los resultados <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</dialog>

<script>
  import { searchEntries } from '../../domain/search-index';
  import type { SearchEntry, SearchEntryCategory } from '../../domain/search-index';
  import { SEARCH_CATEGORY_LABEL } from '../../domain/search-index';
  import { readRecentPages, recordPageVisit, clearRecentPages } from '../../lib/recent-pages';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const resultsRoot = document.querySelector<HTMLElement>('[data-search-results]');
  const fullLink = document.querySelector<HTMLAnchorElement>('[data-search-full-link]');
  const openTriggers = [...document.querySelectorAll<HTMLButtonElement>('[data-search-open]')];
  const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]');
  if (!dialog || !input || !resultsRoot || !fullLink) throw new Error('unreachable');

  // Marca de plataforma en el atajo del trigger: "Cmd" en Mac, "Ctrl" en el resto — nunca los dos a la vez.
  const kbdMod = document.querySelector('[data-search-kbd-mod]');
  if (kbdMod && /Mac|iPhone|iPad/.test(navigator.platform ?? navigator.userAgent)) {
    kbdMod.textContent = 'Cmd';
  }

  recordPageVisit(location.pathname + location.search, document.title);

  const ICONS: Record<SearchEntryCategory, string> = {
    pagina:
      '<path d="M4 4h12v12H4z" stroke="currentColor" stroke-width="1.4"/><path d="M4 8h12" stroke="currentColor" stroke-width="1.4"/>',
    campeon:
      '<path d="M10 3l6 2.4v4.2c0 4-2.6 6.7-6 7.4-3.4-.7-6-3.4-6-7.4V5.4L10 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
    guia:
      '<path d="M4 4.5C5 3.7 6.6 3.4 8 3.6c1.1.15 2 .6 2 .6s.9-.45 2-.6c1.4-.2 3-.1 4 .7v10.4c-1-.6-2.6-.7-4-.5-1.1.15-2 .6-2 .6s-.9-.45-2-.6c-1.4-.2-3-.1-4 .5V4.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>',
    build:
      '<path d="M6 6l8 8M6 14L14 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="6" cy="6" r="1.6" stroke="currentColor" stroke-width="1.2"/><circle cx="14" cy="14" r="1.6" stroke="currentColor" stroke-width="1.2"/>',
    academia:
      '<path d="M3 7.5L10 4l7 3.5-7 3.5-7-3.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6 9.2v3.3c0 1 1.8 2 4 2s4-1 4-2V9.2" stroke="currentColor" stroke-width="1.2"/>',
    herramienta:
      '<path d="M12.8 3.7a3 3 0 00-4 4L4 12.5 6 15l4.8-4.8a3 3 0 004-4l-2 2-1.5-1.5 2-2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>',
    'tier-list':
      '<path d="M5 15V9M10 15V5M15 15v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
    actualizacion:
      '<path d="M10 5.5V10l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="10" cy="10" r="6.3" stroke="currentColor" stroke-width="1.3"/>',
    pregunta:
      '<path d="M7.3 7.6a2.7 2.7 0 115 1.5c0 1.6-2.3 1.7-2.3 3.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="10" cy="14.3" r=".9" fill="currentColor"/>',
    video:
      '<rect x="3.5" y="5" width="13" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 7.8l4 2.2-4 2.2V7.8z" fill="currentColor"/>',
  };

  const escapeHtml = (value: string): string =>
    value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  /**
   * Resalta la primera coincidencia literal (insensible a mayúsculas) del
   * texto de búsqueda tal y como lo escribió la persona usuaria. Si no hay
   * coincidencia literal directa (p. ej. "kaisa" contra "Kai'Sa" — el
   * ranking sí los empareja vía `normalizeSearchText`, pero aquí solo
   * resaltamos, nunca reescribimos el título) se muestra el texto sin
   * resaltar: degradación honesta, nunca un resaltado incorrecto.
   */
  const highlight = (text: string, rawQuery: string): string => {
    const escaped = escapeHtml(text);
    const query = rawQuery.trim();
    if (!query) return escaped;
    const index = text.toLowerCase().indexOf(query.toLowerCase());
    if (index === -1) return escaped;
    const before = escapeHtml(text.slice(0, index));
    const match = escapeHtml(text.slice(index, index + query.length));
    const after = escapeHtml(text.slice(index + query.length));
    return `${before}<mark>${match}</mark>${after}`;
  };

  // --- Índice estático (build time) ---
  // Los vídeos ya vienen dentro de `/buscar-index.json` (los curados de
  // `video-content-links.ts`, con sus relaciones reales como keywords) —
  // única fuente para el buscador, sin una segunda llamada propia a
  // `/api/youtube` (esa integración sigue viva para Home/ActivityCenterCta,
  // solo deja de usarse aquí como fuente duplicada de vídeos).
  let indexPromise: Promise<SearchEntry[]> | undefined;
  const ensureIndex = (): Promise<SearchEntry[]> => {
    indexPromise ??= fetch('/buscar-index.json').then((response) => response.json());
    return indexPromise;
  };

  // --- Estado de teclado/foco ---
  let lastFocused: HTMLElement | null = null;
  let activeIndex = -1;

  const optionEls = (): HTMLElement[] => [
    ...resultsRoot.querySelectorAll<HTMLElement>('[data-search-option]'),
  ];

  const setActive = (nextIndex: number) => {
    const options = optionEls();
    if (options.length === 0) {
      activeIndex = -1;
      input.setAttribute('aria-activedescendant', '');
      return;
    }
    activeIndex = ((nextIndex % options.length) + options.length) % options.length;
    options.forEach((option, index) => {
      const isActive = index === activeIndex;
      option.setAttribute('aria-selected', String(isActive));
      option.classList.toggle('is-active', isActive);
    });
    const active = options[activeIndex];
    if (active) {
      input.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    }
  };

  // Orden de categorías fijado por el encargo (p. ej. para "lucian": Guía,
  // Página, Tier List, Builds/Runas/Sinergias, Vídeos...). Dentro de cada
  // categoría el orden real lo decide la puntuación de `searchEntries`.
  const CATEGORY_ORDER: SearchEntryCategory[] = [
    'guia',
    'campeon',
    'tier-list',
    'build',
    'academia',
    'video',
    'pregunta',
    'actualizacion',
    'herramienta',
    'pagina',
  ];

  const renderInitialState = () => {
    const recent = readRecentPages();
    const recentHtml = recent.length
      ? `<div class="global-search-section">
          <div class="global-search-section-header">
            <p class="global-search-section-title">Retomar donde lo dejaste</p>
            <button type="button" class="global-search-clear-recent" data-search-clear-recent>Borrar</button>
          </div>
          <ul class="global-search-recent">
            ${recent
              .map(
                (entry) =>
                  `<li><a href="${escapeHtml(entry.href)}">${escapeHtml(entry.title)}</a></li>`,
              )
              .join('')}
          </ul>
        </div>`
      : '';
    resultsRoot.innerHTML = `
      ${recentHtml}
      <div class="global-search-section">
        <p class="global-search-section-title">Prueba a buscar</p>
        <div class="global-search-suggestions">
          <button type="button" class="global-search-chip" data-search-suggestion="Navori">Navori</button>
          <button type="button" class="global-search-chip" data-search-suggestion="Lucian">Lucian</button>
          <button type="button" class="global-search-chip" data-search-suggestion="spacing">spacing</button>
          <button type="button" class="global-search-chip" data-search-suggestion="Tier List">Tier List</button>
          <button type="button" class="global-search-chip" data-search-suggestion="Kai'Sa">Kai'Sa</button>
          <button type="button" class="global-search-chip" data-search-suggestion="Jhin">Jhin</button>
          <button type="button" class="global-search-chip" data-search-suggestion="snowball">snowball</button>
        </div>
      </div>
    `;
    resultsRoot
      .querySelectorAll<HTMLButtonElement>('[data-search-suggestion]')
      .forEach((chip) =>
        chip.addEventListener('click', () => {
          input.value = chip.dataset.searchSuggestion ?? '';
          render(input.value);
          input.focus();
        }),
      );
    resultsRoot
      .querySelector('[data-search-clear-recent]')
      ?.addEventListener('click', () => {
        clearRecentPages();
        renderInitialState();
      });
    fullLink.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    activeIndex = -1;
  };

  const renderNoResults = (query: string) => {
    resultsRoot.innerHTML = `
      <div class="global-search-empty">
        <p class="global-search-empty-title">No he encontrado contenido para «${escapeHtml(query)}».</p>
        <p class="global-search-empty-hint">Puede que todavía no lo haya publicado, o que uses otras palabras.</p>
        <div class="global-search-empty-actions">
          <a href="/pregunta?q=${encodeURIComponent(query)}">Preguntar a Tidusss</a>
          <a href="/campeones/lucian">Ver la guía de Lucian</a>
          <a href="/academia">Aprende ADC</a>
          <a href="/campeones">Abrir ADCs</a>
        </div>
      </div>
    `;
    fullLink.hidden = true;
    input.setAttribute('aria-expanded', 'true');
    activeIndex = -1;
  };

  const renderResults = (query: string, matches: { entry: SearchEntry }[]) => {
    const byCategory = new Map<SearchEntryCategory, SearchEntry[]>();
    for (const { entry } of matches) {
      const list = byCategory.get(entry.category) ?? [];
      list.push(entry);
      byCategory.set(entry.category, list);
    }
    const orderedCategories = CATEGORY_ORDER.filter((category) => byCategory.has(category));
    let optionIndex = 0;
    resultsRoot.innerHTML = orderedCategories
      .map((category) => {
        const entries = (byCategory.get(category) ?? []).slice(0, 6);
        const items = entries
          .map((entry) => {
            const id = `search-option-${optionIndex++}`;
            const meta = [entry.patchLabel ? `Parche ${entry.patchLabel}` : undefined]
              .filter(Boolean)
              .join(' · ');
            return `
              <a
                id="${id}"
                class="global-search-result"
                data-search-option
                role="option"
                aria-selected="false"
                href="${escapeHtml(entry.href)}"
              >
                <span class="global-search-result-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none">${ICONS[entry.category]}</svg></span>
                <span class="global-search-result-body">
                  <span class="global-search-result-title">${highlight(entry.title, query)}</span>
                  <span class="global-search-result-description">${highlight(entry.description, query)}</span>
                  ${meta ? `<span class="global-search-result-meta">${escapeHtml(meta)}</span>` : ''}
                </span>
              </a>
            `;
          })
          .join('');
        return `
          <div class="global-search-section" role="group" aria-label="${SEARCH_CATEGORY_LABEL[category]}">
            <p class="global-search-section-title">${SEARCH_CATEGORY_LABEL[category]}</p>
            <div class="global-search-results-list">${items}</div>
          </div>
        `;
      })
      .join('');
    fullLink.href = `/buscar?q=${encodeURIComponent(query)}`;
    fullLink.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    setActive(0);
  };

  const render = async (rawQuery: string) => {
    const query = rawQuery.trim();
    if (!query) {
      renderInitialState();
      return;
    }
    const entries = await ensureIndex();
    const matches = searchEntries(entries, query, { limit: 60 });
    if (matches.length === 0) renderNoResults(query);
    else renderResults(query, matches);
  };

  // --- Apertura / cierre ---
  const openDialog = () => {
    lastFocused = document.activeElement as HTMLElement | null;
    dialog.showModal();
    void ensureIndex();
    input.value = '';
    renderInitialState();
    input.focus();
  };
  const closeDialog = () => {
    if (dialog.open) dialog.close();
  };

  openTriggers.forEach((trigger) => trigger.addEventListener('click', openDialog));
  closeButton?.addEventListener('click', closeDialog);

  dialog.addEventListener('close', () => {
    lastFocused?.focus();
  });
  // Clic fuera del panel (en el ::backdrop, que en <dialog> se recibe como clic sobre el propio elemento) cierra.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) closeDialog();
  });

  window.addEventListener('keydown', (event) => {
    const isSearchShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
    if (isSearchShortcut) {
      event.preventDefault();
      if (dialog.open) closeDialog();
      else openDialog();
    }
  });

  input.addEventListener('input', () => {
    void render(input.value);
  });

  input.addEventListener('keydown', (event) => {
    const options = optionEls();
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (options.length > 0) setActive(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (options.length > 0) setActive(activeIndex - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const target = options[activeIndex] ?? options[0];
      if (target instanceof HTMLAnchorElement) location.href = target.href;
    }
    // Escape lo maneja nativamente <dialog> (dispara 'cancel' -> 'close').
  });
</script>
