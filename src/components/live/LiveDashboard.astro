---
import { integrationEndpoints, platforms } from '../../config/platforms';
import MatchCard from './matches/MatchCard.astro';
import MatchEmpty from './matches/MatchEmpty.astro';
import PlayerProfile from './PlayerProfile.astro';
---

<main
  class="live-page"
  data-live-root
  data-youtube={integrationEndpoints.youtube}
  data-youtube-stats={integrationEndpoints.youtubeStats}
  data-riot={integrationEndpoints.riot}
  data-twitch={integrationEndpoints.twitch}
>
  <section class="live-intro">
    <div class="live-container">
      <p class="eyebrow">El Laboratorio / Competitivo</p>
      <h1>El centro competitivo de Tidusss.</h1>
      <p>SoloQ, canal y directo. Datos actuales, sin ruido.</p>
      <img
        class="live-hero-signature"
        src="/images/brand/lucian/lucian-high-noon-standing.webp"
        width="634"
        height="792"
        alt=""
        aria-hidden="true"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="live-container live-grid">
    <section class="live-module live-module--wide" aria-labelledby="solo-title">
      <header class="live-module-head">
        <div>
          <span>01 / Competitivo</span><h2 id="solo-title">Hoy en SoloQ</h2>
        </div>
        <small
          data-riot-updated
          class="data-skeleton data-skeleton--meta"
          aria-label="Actualizando datos competitivos"
          aria-live="polite">&nbsp;</small
        >
      </header>
      <div class="profile-context">
        <strong data-riot-id>Tidusss#FFX</strong><span>EUW · Solo/Duo</span>
      </div>
      <div class="today-rank">
        <div>
          <strong
            data-rank
            class="data-skeleton"
            aria-label="Actualizando rango">&nbsp;</strong
          ><span data-lp class="data-skeleton data-skeleton--line">&nbsp;</span>
        </div>
        <p data-activity class="data-skeleton data-skeleton--copy">&nbsp;</p>
        <img
          class="rank-emblem"
          data-rank-emblem
          width="640"
          height="512"
          alt=""
          aria-hidden="true"
          decoding="async"
          hidden
        />
      </div>
      <div class="today-metrics" data-today-metrics hidden>
        <div><strong data-today-games></strong><span>Partidas</span></div>
        <div>
          <strong data-today-record></strong><span>Victorias · Derrotas</span>
        </div>
        <div><strong data-today-wr></strong><span>Win rate</span></div>
        <div><strong data-today-kda></strong><span>KDA medio</span></div>
      </div>
      <div class="today-foot" data-today-foot hidden>
        <p><span>Campeón del día</span><strong data-today-champion></strong></p>
        <p><span>Racha actual</span><strong data-today-streak></strong></p>
        <p>
          <span>Variación de LP</span><strong data-lp-delta
            >Pendiente</strong
          >
          <small>Se mostrará en cuanto haya una medición previa con la que compararla.</small>
        </p>
      </div>
      <div class="today-empty" data-today-empty hidden>
        <strong>Sin clasificatorias hoy.</strong>
        <p>
          Todavía no hay actividad de Solo/Duo registrada desde las 00:00 en
          Europe/Madrid.
        </p>
        <p data-last-competitive hidden></p>
        <img
          class="today-empty-signature"
          data-today-empty-signature
          width="669"
          height="714"
          alt=""
          aria-hidden="true"
          decoding="async"
          loading="lazy"
          hidden
        />
      </div>
      <div class="live-empty" data-riot-error hidden>
        <strong>Clasificación temporalmente no disponible.</strong>
        <p>El resto del centro Live sigue funcionando.</p>
      </div>
    </section>

    <PlayerProfile />

    <section class="live-module" aria-labelledby="twitch-title">
      <header class="live-module-head">
        <div><span>02 / Twitch</span><h2 id="twitch-title">Directo</h2></div>
        <i class="live-dot" aria-hidden="true"></i>
      </header>
      <div class="stream-status" aria-live="polite">
        <strong
          data-stream-state
          class="data-skeleton"
          aria-label="Actualizando Twitch">&nbsp;</strong
        >
        <p data-stream-copy class="data-skeleton data-skeleton--copy">&nbsp;</p>
        <small data-stream-meta hidden>
          <span data-stream-category></span>
          <span data-stream-viewers></span>
          <span data-stream-duration></span>
        </small>
      </div>
      <small
        class="live-updated data-skeleton data-skeleton--meta"
        data-twitch-updated
        aria-label="Actualizando estado de Twitch">&nbsp;</small
      >
      <a
        class="live-action"
        href={platforms.twitch.url}
        target="_blank"
        rel="noreferrer"
        data-stream-link>Visitar Twitch ↗</a
      >
    </section>

    <section class="live-module" aria-labelledby="youtube-title">
      <header class="live-module-head">
        <div><span>03 / YouTube</span><h2 id="youtube-title">Canal</h2></div>
        <small>Dato proporcionado por YouTube</small>
      </header>
      <div class="youtube-number">
        <strong
          data-subscribers
          class="data-skeleton"
          aria-label="Actualizando suscriptores">&nbsp;</strong
        ><span>Suscriptores</span>
      </div>
      <p class="provider-state" data-youtube-state hidden></p>
      <div data-youtube-details hidden>
        <div class="goal-line">
          <span>Próximo objetivo <b data-subscriber-goal></b></span><strong
            data-subscriber-progress></strong>
        </div>
        <div class="progress-track"><span data-subscriber-bar></span></div>
        <div class="channel-metrics">
          <span><b data-views></b> visualizaciones</span><span
            ><b data-video-count></b> vídeos</span
          >
        </div>
      </div>
      <small
        class="live-updated data-skeleton data-skeleton--meta"
        data-youtube-updated
        aria-label="Actualizando estadísticas">&nbsp;</small
      >
    </section>

    <section
      class="live-module live-module--wide"
      aria-labelledby="matches-title"
    >
      <header class="live-module-head">
        <div>
          <span>04 / Sesión</span><h2 id="matches-title">Últimas partidas</h2>
        </div><small>Solo/Duo ranked</small>
      </header>
      <ol class="live-match-list" data-live-matches aria-live="polite">
        <li
          class="live-loading live-loading--row match-card-skeleton"
          aria-label="Actualizando partidas"
        >
          <i></i><i></i><i></i>
        </li>
      </ol>
      <MatchCard />
      <MatchEmpty />
    </section>

    <section id="objetivos" class="live-module" aria-labelledby="goals-title">
      <header class="live-module-head">
        <div><span>05 / Progreso</span><h2 id="goals-title">Objetivos</h2></div>
      </header>
      <div class="goals-list">
        <article data-goal-chain="competitive-lp">
          <span>Objetivo competitivo</span>
          <strong data-goal-value class="data-skeleton">&nbsp;</strong>
          <div data-goal-track hidden><i></i></div>
        </article>
        <article data-goal-chain="youtube-subscribers">
          <span>Suscriptores</span>
          <strong data-goal-value class="data-skeleton">&nbsp;</strong>
          <div data-goal-track hidden><i></i></div>
        </article>
        <article data-goal-chain="youtube-videos">
          <span>Vídeos publicados</span>
          <strong data-goal-value class="data-skeleton">&nbsp;</strong>
          <div data-goal-track hidden><i></i></div>
        </article>
      </div>
    </section>

    <section class="live-module" aria-labelledby="activity-title">
      <header class="live-module-head">
        <div>
          <span>06 / Ahora</span><h2 id="activity-title">Actividad reciente</h2>
        </div>
      </header>
      <ol class="activity-list" data-activity-feed aria-live="polite">
        <li
          class="live-loading live-loading--row"
          aria-label="Actualizando actividad"
        >
          <i></i><i></i>
        </li>
      </ol>
    </section>

    <section
      class="live-module live-module--wide profile-refresh"
      aria-labelledby="profile-title"
    >
      <header class="live-module-head">
        <div>
          <span>07 / Perfil</span><h2 id="profile-title">
            Consultar perfil competitivo
          </h2>
        </div><small>Tidusss#FFX · EUW</small>
      </header>
      <div class="profile-refresh-body">
        <p>
          Actualiza el rango, las partidas y la actividad competitiva de
          Tidusss#FFX.
        </p>
        <button type="button" data-profile-refresh>Actualizar perfil</button>
      </div>
      <p
        class="profile-refresh-state"
        data-profile-refresh-state
        aria-live="polite"
      >
      </p>
    </section>
  </div>
</main>

<script>
  import { buildActivity } from '../../lib/activity';
  import {
    elapsedDuration,
    madridTime,
    relativeTime,
    updatedAgo,
  } from '../../lib/time';
  import {
    COMPETITIVE_LP_CHAIN,
    YOUTUBE_SUBSCRIBER_CHAIN,
    YOUTUBE_VIDEO_CHAIN,
    primaryFromChain,
    resolveChain,
  } from '../../domain/goals';
  import { rankAssetFor } from '../../config/rank-assets';
  import { renderMatchCards } from './matches/render';
  import type { RiotPublicResponse } from '../../lib/riot';
  import type {
    TwitchStatusResponse,
    YouTubeStatsResponse,
  } from '../../types/platforms';
  import type {
    YouTubeFeedResponse,
    YouTubeFeedResult,
  } from '../../types/content';

  // Las tres cadenas reales que Competitivo puede medir con datos que ya
  // llegan a esta página — nunca se inventa un cuarto objetivo sin fuente.
  const GOAL_CHAINS = {
    'competitive-lp': COMPETITIVE_LP_CHAIN,
    'youtube-subscribers': YOUTUBE_SUBSCRIBER_CHAIN,
    'youtube-videos': YOUTUBE_VIDEO_CHAIN,
  } as const;

  const root = document.querySelector<HTMLElement>('[data-live-root]');
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const entered = new WeakSet<Element>();
  const pendingAnimations = new WeakMap<
    HTMLElement,
    { values: number[]; render: (values: number[]) => string }
  >();
  const easing = (progress: number) => 1 - Math.pow(1 - progress, 3);
  let valueObserver: IntersectionObserver | undefined;

  const animateNow = (
    node: HTMLElement,
    values: number[],
    render: (values: number[]) => string,
  ) => {
    const previous = (node.dataset.numericValue ?? '')
      .split(',')
      .map(Number)
      .filter(Number.isFinite);
    const from =
      previous.length === values.length ? previous : values.map(() => 0);
    node.dataset.numericValue = values.join(',');
    if (reducedMotion) {
      node.textContent = render(values);
      return;
    }
    const startedAt = performance.now();
    const duration = 850;
    const frame = (now: number) => {
      const progress = Math.min(1, (now - startedAt) / duration);
      const eased = easing(progress);
      node.textContent = render(
        values.map((value, index) => {
          const start = from[index] ?? 0;
          return start + (value - start) * eased;
        }),
      );
      if (progress < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    // Red de seguridad: en una pestaña en segundo plano `requestAnimationFrame`
    // puede no llegar a ejecutarse nunca — sin esto, el valor real quedaría
    // bloqueado en el esqueleto de carga aunque la API ya hubiera respondido.
    setTimeout(() => {
      node.textContent = render(values);
    }, duration + 100);
  };

  const animateValues = (
    selector: string,
    values: number[],
    render: (values: number[]) => string,
  ) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.classList.remove('data-skeleton', 'data-skeleton--line');
    if (entered.has(node) || reducedMotion) {
      animateNow(node, values, render);
      return;
    }
    pendingAnimations.set(node, { values, render });
    valueObserver?.observe(node);
  };

  const animateBar = (
    node: HTMLElement | null | undefined,
    progress: number,
  ) => {
    if (!node) return;
    const target = `${Math.max(0, Math.min(100, progress))}%`;
    if (reducedMotion || node.dataset.progressReady) {
      node.style.width = target;
      return;
    }
    node.style.width = '0%';
    node.dataset.progressReady = 'true';
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        node.style.width = target;
      }),
    );
  };

  if (!reducedMotion) {
    valueObserver = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const node = entry.target as HTMLElement;
          entered.add(node);
          valueObserver?.unobserve(node);
          const pending = pendingAnimations.get(node);
          if (pending) animateNow(node, pending.values, pending.render);
          pendingAnimations.delete(node);
        }),
      { threshold: 0.2 },
    );
  }

  const text = (selector: string, value: string) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node || node.textContent === value) return;
    node.textContent = value;
    if (
      !reducedMotion &&
      !node.classList.contains('data-skeleton') &&
      typeof node.animate === 'function'
    )
      node.animate(
        [
          { opacity: 0.45, transform: 'translate3d(0, 3px, 0)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0)' },
        ],
        { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
  };
  const visible = (selector: string, show: boolean) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (node) node.hidden = !show;
  };
  const number = (value?: number) =>
    value === undefined
      ? undefined
      : new Intl.NumberFormat('es-ES').format(value);
  const percent = (value?: number) =>
    value === undefined ? undefined : `${String(value).replace('.', ',')} %`;
  const appendEmpty = (
    container: Element,
    titleCopy: string,
    detailCopy: string,
  ) => {
    const item = document.createElement('li');
    item.className = 'compact-empty';
    const title = document.createElement('strong');
    title.textContent = titleCopy;
    const detail = document.createElement('span');
    detail.textContent = detailCopy;
    item.append(title, detail);
    container.append(item);
  };
  let riotData: Extract<RiotPublicResponse, { ok: true }>['data'] | undefined;
  let youtubeData:
    Extract<YouTubeStatsResponse, { ok: true }>['data'] | undefined;
  let videos: YouTubeFeedResult['videos'] = [];
  let fetching = false;

  const positionLabel = (position?: string) =>
    (
      ({
        BOTTOM: 'ADC',
        UTILITY: 'Support',
        MIDDLE: 'Mid',
        TOP: 'Top',
        JUNGLE: 'Jungle',
      }) as Record<string, string>
    )[position ?? ''] ??
    position ??
    'Sin dato';

  const renderMatches = () => {
    const list = root?.querySelector('[data-live-matches]');
    if (!list || !riotData) return;
    renderMatchCards(list, riotData.recent.matches.slice(0, 5), {
      formatNumber: (value) => number(value) ?? String(value),
      relativeTime,
      reducedMotion,
      videos,
    });
  };

  const renderPlayerProfile = () => {
    if (!riotData) return;
    const { profile, ranked, recent } = riotData;
    const hasMatches = recent.sampleSize > 0;
    const championGroups = new Map<string, typeof recent.matches>();
    recent.matches.forEach((match) =>
      championGroups.set(match.championName, [
        ...(championGroups.get(match.championName) ?? []),
        match,
      ]),
    );
    const derivedChampions = [...championGroups.entries()]
      .map(([championName, matches]) => {
        const wins = matches.filter((match) => match.win).length;
        const average = (values: number[]) =>
          values.reduce((sum, value) => sum + value, 0) / values.length;
        return {
          championName,
          championImageUrl: matches[0]?.championImageUrl,
          games: matches.length,
          wins,
          losses: matches.length - wins,
          winRate: Math.round((wins / matches.length) * 100),
          averageKda: average(matches.map((match) => match.kda)),
          averageCsPerMinute: average(
            matches.map((match) => match.csPerMinute),
          ),
        };
      })
      .sort(
        (a, b) =>
          b.games - a.games || a.championName.localeCompare(b.championName),
      );
    const profileChampions = recent.champions ?? derivedChampions;
    const positionGroups = new Map<string, number>();
    recent.matches.forEach((match) =>
      positionGroups.set(
        match.position,
        (positionGroups.get(match.position) ?? 0) + 1,
      ),
    );
    const derivedPositions = [...positionGroups.entries()]
      .map(([position, games]) => ({
        position,
        games,
        percentage: Math.round((games / recent.matches.length) * 100),
      }))
      .sort(
        (a, b) => b.games - a.games || a.position.localeCompare(b.position),
      );
    const profilePositions = recent.positions ?? derivedPositions;
    const primaryPosition =
      recent.primaryPosition ?? recent.matches[0]?.position;
    const gamesLastSevenDays =
      recent.gamesLastSevenDays ??
      recent.matches.filter(
        (match) =>
          new Date(match.playedAt).getTime() >=
          Date.now() - 7 * 24 * 60 * 60_000,
      ).length;
    const averageDamage =
      recent.averageDamageToChampions ??
      (recent.matches.length
        ? recent.matches.reduce(
            (sum, match) => sum + match.damageToChampions,
            0,
          ) / recent.matches.length
        : undefined);
    const editorialSummary = recent.editorialSummary?.length
      ? recent.editorialSummary
      : [
          recent.matches.length && (positionGroups.get('BOTTOM') ?? 0)
            ? `${positionGroups.get('BOTTOM')} de las últimas ${recent.matches.length} partidas fueron como ADC.`
            : undefined,
          profileChampions[0]
            ? `${profileChampions[0].championName} es el campeón más jugado de la muestra (${profileChampions[0].games} partidas).`
            : undefined,
          recent.averageCsPerMinute === undefined
            ? undefined
            : `Promedio de ${String(recent.averageCsPerMinute).replace('.', ',')} CS/min en las últimas partidas.`,
        ].filter((value): value is string => Boolean(value));
    visible('[data-player-profile-empty]', !hasMatches);
    text('[data-profile-riot-id]', profile.riotId);
    text(
      '[data-profile-sample]',
      `${recent.sampleSize} ${recent.sampleSize === 1 ? 'partida' : 'partidas'} · muestra disponible`,
    );
    text(
      '[data-profile-rank]',
      ranked.available
        ? `${ranked.tier ?? ''}${ranked.leaguePoints === undefined ? '' : ` · ${ranked.leaguePoints} LP`}`.trim()
        : 'Sin clasificación',
    );
    text(
      '[data-profile-record]',
      ranked.wins === undefined || ranked.losses === undefined
        ? 'Sin dato'
        : `${ranked.wins}V · ${ranked.losses}D`,
    );
    text(
      '[data-profile-winrate]',
      ranked.winRate === undefined ? 'Sin dato' : `${ranked.winRate}%`,
    );
    text('[data-profile-role]', positionLabel(primaryPosition));
    text(
      '[data-profile-kda]',
      recent.averageKda?.toFixed(2).replace('.', ',') ?? '—',
    );
    text(
      '[data-profile-csm]',
      recent.averageCsPerMinute === undefined
        ? '—'
        : String(recent.averageCsPerMinute).replace('.', ','),
    );
    text(
      '[data-profile-damage]',
      averageDamage === undefined
        ? '—'
        : (number(Math.round(averageDamage)) ?? '—'),
    );
    text(
      '[data-profile-week]',
      `${gamesLastSevenDays} ${gamesLastSevenDays === 1 ? 'partida' : 'partidas'}`,
    );
    text(
      '[data-profile-last]',
      (recent.lastPlayedAt ?? recent.matches[0]?.playedAt)
        ? (relativeTime(recent.lastPlayedAt ?? recent.matches[0]?.playedAt) ??
            '—')
        : 'Sin actividad',
    );

    const editorial = root?.querySelector('[data-profile-editorial]');
    editorial?.replaceChildren(
      ...editorialSummary.map((summary) => {
        const item = document.createElement('li');
        item.textContent = summary;
        return item;
      }),
    );
    const championList = root?.querySelector('[data-profile-champions]');
    championList?.replaceChildren(
      ...profileChampions.slice(0, 5).map((champion) => {
        const item = document.createElement('li');
        if (champion.championImageUrl) {
          const image = document.createElement('img');
          image.src = champion.championImageUrl;
          image.alt = '';
          image.width = 44;
          image.height = 44;
          image.loading = 'lazy';
          image.decoding = 'async';
          item.append(image);
        }
        const identity = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = champion.championName;
        const record = document.createElement('span');
        record.textContent = `${champion.games} partidas · ${champion.wins}V · ${champion.losses}D`;
        identity.append(name, record);
        const metrics = document.createElement('p');
        metrics.textContent = `${champion.winRate}% WR · ${champion.averageKda.toFixed(2).replace('.', ',')} KDA · ${String(champion.averageCsPerMinute).replace('.', ',')} CS/min`;
        item.append(identity, metrics);
        return item;
      }),
    );
    const positionList = root?.querySelector('[data-profile-positions]');
    positionList?.replaceChildren(
      ...profilePositions.map((position) => {
        const item = document.createElement('li');
        const label = document.createElement('span');
        label.textContent = positionLabel(position.position);
        const bar = document.createElement('i');
        bar.style.width = `${position.percentage}%`;
        const value = document.createElement('strong');
        value.textContent = `${position.games} · ${position.percentage}%`;
        item.append(label, bar, value);
        return item;
      }),
    );
    text(
      '[data-profile-positions-note]',
      hasMatches
        ? `Distribución calculada sobre ${recent.sampleSize} partidas recientes`
        : 'Sin muestra suficiente',
    );
  };

  const renderRelatedGameplays = () => {
    const section = root?.querySelector<HTMLElement>(
      '[data-related-gameplays]',
    );
    const list = root?.querySelector('[data-related-gameplays-list]');
    if (!section || !list) return;
    const gameplays = videos.filter((video) => !video.isShort).slice(0, 3);
    section.hidden = gameplays.length === 0;
    list.replaceChildren(
      ...gameplays.map((video) => {
        const link = document.createElement('a');
        link.href = video.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.setAttribute('aria-label', `Ver en YouTube: ${video.title}`);
        const image = document.createElement('img');
        image.src = video.thumbnailUrl;
        image.alt = `Miniatura de ${video.title}`;
        image.width = 480;
        image.height = 270;
        image.loading = 'lazy';
        image.decoding = 'async';
        const copy = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = video.title;
        const meta = document.createElement('span');
        meta.textContent = [
          relativeTime(video.publishedAt),
          video.durationLabel,
        ]
          .filter(Boolean)
          .join(' · ');
        copy.append(title, meta);
        link.append(image, copy);
        return link;
      }),
    );
  };

  const updateRelativeLabels = () =>
    root?.querySelectorAll<HTMLElement>('[data-updated-at]').forEach((node) => {
      const suffix = node.dataset.updatedSuffix;
      node.textContent = `${updatedAgo(node.dataset.updatedAt)}${suffix ? ` · ${suffix}` : ''}`;
    });

  const markUpdated = (
    selector: string,
    timestamp: string,
    suffix?: string,
  ) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.classList.remove('data-skeleton', 'data-skeleton--meta');
    node.dataset.updatedAt = timestamp;
    node.toggleAttribute('data-updated-at', true);
    if (suffix) node.dataset.updatedSuffix = suffix;
    else delete node.dataset.updatedSuffix;
    node.textContent = `${updatedAgo(timestamp)}${suffix ? ` · ${suffix}` : ''}`;
  };

  const loadRiot = async () => {
    const response = await fetch(root!.dataset.riot!);
    const payload = (await response.json()) as RiotPublicResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    riotData = payload.data;
    const { profile, ranked, today, recent } = payload.data;
    text('[data-riot-id]', profile.riotId);
    text('[data-rank]', ranked.tier ?? 'Sin clasificación');
    root?.querySelector('[data-rank]')?.classList.remove('data-skeleton');
    if (ranked.leaguePoints === undefined) {
      root
        ?.querySelector('[data-lp]')
        ?.classList.remove('data-skeleton', 'data-skeleton--line');
      text('[data-lp]', 'Sin LP disponibles');
    } else
      animateValues(
        '[data-lp]',
        [ranked.leaguePoints],
        ([value]) => `${Math.round(value ?? 0)} LP`,
      );
    markUpdated('[data-riot-updated]', payload.data.updatedAt);
    root
      ?.querySelector('[data-activity]')
      ?.classList.remove('data-skeleton', 'data-skeleton--copy');
    visible('[data-riot-error]', false);
    visible('[data-today-metrics]', today.games > 0);
    visible('[data-today-foot]', today.games > 0);
    visible('[data-today-empty]', today.games === 0);
    const emblem = root?.querySelector<HTMLImageElement>('[data-rank-emblem]');
    const emptySignature = root?.querySelector<HTMLImageElement>(
      '[data-today-empty-signature]',
    );
    const rankAsset = rankAssetFor(ranked.tier);
    if (emblem) {
      emblem.hidden = today.games === 0 || !rankAsset;
      if (
        !emblem.hidden &&
        rankAsset &&
        emblem.src !== new URL(rankAsset.src, location.href).href
      )
        emblem.src = rankAsset.src;
    }
    if (emptySignature) {
      emptySignature.hidden = today.games > 0;
      if (!emptySignature.hidden && !emptySignature.src)
        emptySignature.src = '/images/brand/lucian/lucian-high-noon-ready.webp';
    }

    if (today.games > 0) {
      text(
        '[data-activity]',
        today.lastPlayedAt
          ? `Última partida ${relativeTime(today.lastPlayedAt) ?? ''}`.trim()
          : 'Actividad registrada hoy',
      );
      animateValues('[data-today-games]', [today.games], ([value]) =>
        String(Math.round(value ?? 0)),
      );
      animateValues(
        '[data-today-record]',
        [today.wins, today.losses],
        ([wins, losses]) =>
          `${Math.round(wins ?? 0)}V · ${Math.round(losses ?? 0)}D`,
      );
      if (today.winRate === undefined) text('[data-today-wr]', 'Sin dato');
      else
        animateValues(
          '[data-today-wr]',
          [today.winRate],
          ([value]) => `${Math.round(value ?? 0)}%`,
        );
      if (today.averageKda === undefined) text('[data-today-kda]', 'Sin dato');
      else
        animateValues('[data-today-kda]', [today.averageKda], ([value]) =>
          (value ?? 0).toFixed(2).replace('.', ','),
        );
      text(
        '[data-today-champion]',
        today.mostPlayedChampion?.championName ?? 'Sin dato',
      );
      text(
        '[data-today-streak]',
        today.streak
          ? `${today.streak.games} ${today.streak.result === 'win' ? 'victorias' : 'derrotas'}`
          : 'Sin racha',
      );
    } else {
      text('[data-activity]', 'Sin clasificatorias hoy');
      const last = recent.matches[0]?.playedAt;
      const lastCopy = last
        ? `Última actividad competitiva: ${relativeTime(last) ?? ''} · ${madridTime(last) ?? ''}`
        : '';
      text('[data-last-competitive]', lastCopy);
      visible('[data-last-competitive]', Boolean(lastCopy));
    }

    renderPlayerProfile();
    renderMatches();
  };

  const loadYouTube = async () => {
    const response = await fetch(root!.dataset.youtubeStats!);
    const payload = (await response.json()) as YouTubeStatsResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    youtubeData = payload.data;
    root
      ?.querySelector('[data-subscribers]')
      ?.classList.remove('data-skeleton');
    if (payload.data.subscriberCount === undefined) {
      text('[data-subscribers]', 'No visible');
      text('[data-youtube-state]', 'Suscriptores no visibles públicamente.');
      visible('[data-youtube-state]', true);
    } else {
      animateValues(
        '[data-subscribers]',
        [payload.data.subscriberCount],
        ([value]) => number(Math.round(value ?? 0)) ?? '',
      );
      visible('[data-youtube-state]', false);
    }
    visible('[data-youtube-details]', true);
    text(
      '[data-subscriber-goal]',
      number(payload.data.nextGoal) ?? 'Hito máximo alcanzado',
    );
    if (payload.data.progress === undefined)
      text('[data-subscriber-progress]', 'Sin porcentaje');
    else
      animateValues(
        '[data-subscriber-progress]',
        [payload.data.progress],
        ([value]) =>
          percent(Math.round((value ?? 0) * 10) / 10) ?? 'Sin porcentaje',
      );
    if (payload.data.viewCount === undefined)
      text('[data-views]', 'No visibles');
    else
      animateValues(
        '[data-views]',
        [payload.data.viewCount],
        ([value]) => number(Math.round(value ?? 0)) ?? '',
      );
    if (payload.data.videoCount === undefined)
      text('[data-video-count]', 'No visibles');
    else
      animateValues(
        '[data-video-count]',
        [payload.data.videoCount],
        ([value]) => number(Math.round(value ?? 0)) ?? '',
      );
    markUpdated(
      '[data-youtube-updated]',
      payload.data.updatedAt,
      'cifra redondeada por YouTube',
    );
    const bar = root?.querySelector<HTMLElement>('[data-subscriber-bar]');
    animateBar(bar, payload.data.progress ?? 0);
  };

  const loadTwitch = async () => {
    const response = await fetch(root!.dataset.twitch!);
    const payload = (await response.json()) as TwitchStatusResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    const status = payload.data;
    root
      ?.querySelector('[data-stream-state]')
      ?.classList.remove('data-skeleton');
    root
      ?.querySelector('[data-stream-copy]')
      ?.classList.remove('data-skeleton', 'data-skeleton--copy');
    root?.toggleAttribute('data-stream-live', status.state === 'online');
    markUpdated('[data-twitch-updated]', status.updatedAt);
    if (status.state === 'online') {
      text('[data-stream-state]', 'EN DIRECTO');
      text('[data-stream-copy]', status.title ?? 'Tidusss está en directo.');
      text('[data-stream-category]', status.category ?? '');
      if (status.viewerCount === undefined) text('[data-stream-viewers]', '');
      else
        animateValues(
          '[data-stream-viewers]',
          [status.viewerCount],
          ([value]) => `${number(Math.round(value ?? 0))} espectadores`,
        );
      text(
        '[data-stream-duration]',
        status.startedAt
          ? `${elapsedDuration(status.startedAt) ?? ''} en directo`
          : '',
      );
      visible('[data-stream-meta]', true);
      text('[data-stream-link]', 'Ver directo ↗');
    } else if (status.state === 'offline') {
      text('[data-stream-state]', 'Offline');
      text(
        '[data-stream-copy]',
        'Pásate por el canal o revisa la actividad reciente.',
      );
      visible('[data-stream-meta]', false);
      text('[data-stream-link]', 'Visitar Twitch ↗');
    } else {
      text('[data-stream-state]', 'Conexión con Twitch pendiente.');
      text(
        '[data-stream-copy]',
        'El canal sigue disponible desde el enlace inferior.',
      );
      visible('[data-stream-meta]', false);
    }
  };

  const loadFeed = async () => {
    const response = await fetch(root!.dataset.youtube!);
    const payload = (await response.json()) as YouTubeFeedResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    videos = payload.data.videos;
    renderMatches();
    renderRelatedGameplays();
  };

  // Cada objetivo se recalcula contra el valor real de esta misma carga —
  // nunca contra un target fijo editado a mano. Un hito ya conseguido se
  // muestra como logro, no como una barra que sigue "en progreso".
  const updateGoals = () =>
    root
      ?.querySelectorAll<HTMLElement>('[data-goal-chain]')
      .forEach((item) => {
        const chainKey = item.dataset.goalChain as keyof typeof GOAL_CHAINS;
        const chain = GOAL_CHAINS[chainKey];
        const current =
          chainKey === 'competitive-lp'
            ? riotData?.ranked.leaguePoints
            : chainKey === 'youtube-subscribers'
              ? youtubeData?.subscriberCount
              : youtubeData?.videoCount;
        const resolved = chain
          ? primaryFromChain(resolveChain(chain, current))
          : undefined;
        const value = item.querySelector<HTMLElement>('[data-goal-value]');
        const track = item.querySelector<HTMLElement>('[data-goal-track]');
        const bar = track?.querySelector<HTMLElement>('i');
        value?.classList.remove('data-skeleton');
        if (track) track.hidden = true;
        if (
          !resolved ||
          resolved.status === 'no-data' ||
          resolved.status === 'unavailable'
        ) {
          if (value)
            value.textContent =
              chainKey === 'competitive-lp'
                ? 'Riot no responde ahora mismo — vuelve en un momento'
                : 'YouTube no responde ahora mismo — vuelve en un momento';
          return;
        }
        if (resolved.status === 'paused') {
          if (value) value.textContent = 'Objetivo pausado.';
          return;
        }
        if (resolved.status === 'completed') {
          if (value) value.textContent = `${resolved.title} · Conseguido`;
          return;
        }
        if (value)
          value.textContent = `${number(Math.round(resolved.current ?? 0))} / ${number(resolved.target)} ${resolved.unit} · ${percent(Math.round((resolved.progress ?? 0) * 10) / 10)}`;
        if (track) track.hidden = false;
        animateBar(bar, resolved.progress ?? 0);
      });

  const updateActivity = () => {
    const feed = root?.querySelector('[data-activity-feed]');
    if (!feed) return;
    const events = buildActivity(
      riotData?.recent.matches.slice(0, 3),
      videos.slice(0, 3),
    );
    feed.replaceChildren(
      ...events.map((event) => {
        const item = document.createElement('li');
        const copy = document.createElement('div');
        const title = event.href
          ? document.createElement('a')
          : document.createElement('strong');
        title.textContent = event.title;
        if (title instanceof HTMLAnchorElement) {
          title.href = event.href!;
          title.target = '_blank';
          title.rel = 'noreferrer';
        }
        const detail = document.createElement('span');
        detail.textContent = event.detail;
        copy.append(title, detail);
        const time = document.createElement('time');
        time.dateTime = event.timestamp;
        time.textContent = relativeTime(event.timestamp) ?? '';
        item.append(copy, time);
        return item;
      }),
    );
    if (!events.length) {
      appendEmpty(
        feed,
        'Todavía no hay actividad reciente disponible.',
        'Las nuevas partidas, vídeos y directos aparecerán aquí automáticamente.',
      );
    }
  };

  const refresh = async (manual = false) => {
    if (fetching || (!manual && document.hidden)) return;
    fetching = true;
    const button = root?.querySelector<HTMLButtonElement>(
      '[data-profile-refresh]',
    );
    if (button) button.disabled = true;
    if (manual) text('[data-profile-refresh-state]', 'Actualizando perfil…');
    const results = await Promise.allSettled([
      loadRiot(),
      loadYouTube(),
      loadTwitch(),
      loadFeed(),
    ]);
    if (results[0].status === 'rejected') {
      visible('[data-riot-error]', true);
      visible('[data-rank-emblem]', false);
      visible('[data-today-empty-signature]', false);
      root?.querySelector('[data-rank]')?.classList.remove('data-skeleton');
      root
        ?.querySelector('[data-lp]')
        ?.classList.remove('data-skeleton', 'data-skeleton--line');
      root
        ?.querySelector('[data-activity]')
        ?.classList.remove('data-skeleton', 'data-skeleton--copy');
      text('[data-rank]', 'Riot no contesta ahora mismo');
      text('[data-lp]', 'Intentaremos actualizar pronto');
      text('[data-activity]', 'No he podido consultar la SoloQ ahora mismo');
      root
        ?.querySelector('[data-riot-updated]')
        ?.classList.remove('data-skeleton', 'data-skeleton--meta');
      text('[data-riot-updated]', 'Reintentando la conexión con Riot');
    }
    if (results[1].status === 'rejected') {
      const code =
        results[1].reason instanceof Error ? results[1].reason.message : '';
      root
        ?.querySelector('[data-subscribers]')
        ?.classList.remove('data-skeleton');
      text('[data-subscribers]', 'YouTube no responde ahora mismo');
      text(
        '[data-youtube-state]',
        code === 'YOUTUBE_NOT_CONFIGURED'
          ? 'Canal pendiente de conexión.'
          : 'YouTube no me deja consultar el canal ahora mismo.',
      );
      visible('[data-youtube-state]', true);
      root
        ?.querySelector('[data-youtube-updated]')
        ?.classList.remove('data-skeleton', 'data-skeleton--meta');
      text(
        '[data-youtube-updated]',
        'Se conservará el último dato válido cuando exista.',
      );
    }
    if (results[2].status === 'rejected') {
      root
        ?.querySelector('[data-stream-state]')
        ?.classList.remove('data-skeleton');
      root
        ?.querySelector('[data-stream-copy]')
        ?.classList.remove('data-skeleton', 'data-skeleton--copy');
      root
        ?.querySelector('[data-twitch-updated]')
        ?.classList.remove('data-skeleton', 'data-skeleton--meta');
      text('[data-stream-state]', 'Estado temporalmente no disponible.');
      text(
        '[data-stream-copy]',
        'Pásate por el canal o revisa la actividad reciente.',
      );
      text('[data-twitch-updated]', 'Intentaremos actualizar pronto');
    }
    updateGoals();
    updateActivity();
    if (manual)
      text(
        '[data-profile-refresh-state]',
        results[0].status === 'fulfilled'
          ? 'Perfil actualizado.'
          : 'No se ha podido actualizar el perfil ahora mismo.',
      );
    if (button) button.disabled = false;
    fetching = false;
  };

  refresh();
  window.setInterval(() => refresh(), 120_000);
  window.setInterval(updateRelativeLabels, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
  root
    ?.querySelector('[data-profile-refresh]')
    ?.addEventListener('click', () => refresh(true));

  root?.toggleAttribute('data-motion-ready', true);
  const modules = root?.querySelectorAll<HTMLElement>('.live-module');
  if (reducedMotion)
    modules?.forEach((module) => module.classList.add('is-visible'));
  else {
    const moduleObserver = new IntersectionObserver(
      (entries, observer) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }),
      { threshold: 0.08 },
    );
    modules?.forEach((module) => moduleObserver.observe(module));
  }
</script>
