---
import { integrationEndpoints } from '../../config/platforms';
import MatchCard from './matches/MatchCard.astro';
import MatchEmpty from './matches/MatchEmpty.astro';
import PerformanceProfile from './PerformanceProfile.astro';
import LiveGameModule from './LiveGameModule.astro';
import { resolvedMatchVideoContent } from '../../lib/resolved-match-video-content';
---

<main
  class="live-page"
  data-live-root
  data-youtube={integrationEndpoints.youtube}
  data-riot={integrationEndpoints.riot}
  data-riot-matches-base={integrationEndpoints.riotMatchesBase}
  data-match-videos={JSON.stringify(resolvedMatchVideoContent)}
>
  <section class="live-intro">
    <div class="live-container">
      <p class="eyebrow">El Laboratorio / Competitivo</p>
      <h1>El centro competitivo de Tidusss.</h1>
      <p>Rango, rendimiento y Champion Pool reales de SoloQ.</p>
      <img
        class="live-hero-signature"
        src="/images/brand/lucian/lucian-high-noon-standing.webp"
        width="634"
        height="792"
        alt=""
        aria-hidden="true"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <div class="live-container">
    <LiveGameModule />
  </div>

  <div class="live-container live-grid">
    <section class="live-module live-module--wide status-module" aria-labelledby="solo-title">
      <header class="live-module-head">
        <div>
          <span>01 / Ahora</span><h2 id="solo-title">Estado competitivo</h2>
        </div>
        <div class="status-module-meta">
          <small
            data-riot-updated
            class="data-skeleton data-skeleton--meta"
            aria-label="Actualizando datos competitivos"
            aria-live="polite">&nbsp;</small
          >
          <button type="button" class="status-refresh" data-profile-refresh>
            Actualizar
          </button>
        </div>
      </header>
      <p
        class="status-refresh-state"
        data-profile-refresh-state
        aria-live="polite"
      >
      </p>
      <div class="profile-context">
        <strong data-riot-id>Tidusss#FFX</strong><span>EUW · Solo/Duo</span>
      </div>
      <div class="today-rank">
        <div>
          <strong
            data-rank
            class="data-skeleton"
            aria-label="Actualizando rango">&nbsp;</strong
          ><span data-lp class="data-skeleton data-skeleton--line">&nbsp;</span>
        </div>
        <p data-activity class="data-skeleton data-skeleton--copy">&nbsp;</p>
        <img
          class="rank-emblem"
          data-rank-emblem
          width="640"
          height="512"
          alt=""
          aria-hidden="true"
          decoding="async"
          hidden
        />
      </div>
      <div class="season-record" data-season-record hidden>
        <span data-season-record-line></span>
      </div>
      <div class="today-metrics" data-today-metrics hidden>
        <div><strong data-today-games></strong><span>Partidas hoy</span></div>
        <div>
          <strong data-today-record></strong><span>Victorias · Derrotas</span>
        </div>
        <div><strong data-today-wr></strong><span>Win rate</span></div>
        <div><strong data-today-kda></strong><span>KDA medio</span></div>
      </div>
      <div class="today-foot" data-today-foot hidden>
        <p><span>Campeón del día</span><strong data-today-champion></strong></p>
        <p><span>Racha actual</span><strong data-today-streak></strong></p>
        <p>
          <span>Variación de LP</span><strong data-lp-delta
            >Pendiente</strong
          >
          <small>Se mostrará en cuanto haya una medición previa con la que compararla.</small>
        </p>
      </div>
      <div class="today-empty" data-today-empty hidden>
        <strong>Sin clasificatorias hoy.</strong>
        <p>
          Todavía no hay actividad de Solo/Duo registrada desde las 00:00 en
          Europe/Madrid.
        </p>
        <p data-last-competitive hidden></p>
        <img
          class="today-empty-signature"
          data-today-empty-signature
          width="669"
          height="714"
          alt=""
          aria-hidden="true"
          decoding="async"
          loading="lazy"
          hidden
        />
      </div>
      <div class="live-empty" data-riot-error hidden>
        <strong>Clasificación temporalmente no disponible.</strong>
        <p>El resto del centro Live sigue funcionando.</p>
      </div>
    </section>

    <PerformanceProfile />

    <section
      class="live-module live-module--wide"
      aria-labelledby="matches-title"
    >
      <header class="live-module-head">
        <div>
          <span>05 / Historial</span><h2 id="matches-title">Últimas partidas</h2>
        </div><small>Solo/Duo ranked</small>
      </header>
      <ol class="live-match-list" data-live-matches aria-live="polite">
        <li
          class="live-loading live-loading--row match-card-skeleton"
          aria-label="Actualizando partidas"
        >
          <i></i><i></i><i></i>
        </li>
      </ol>
      <MatchCard />
      <MatchEmpty />
    </section>

    <div class="related-gameplays live-module live-module--wide" data-related-gameplays hidden>
      <div class="profile-subhead">
        <h3>Gameplays recientes</h3>
        <small
          >Contenido real del canal; no implica asociación con una partida.</small
        >
      </div>
      <div data-related-gameplays-list></div>
    </div>

  </div>
</main>

<script>
  import { madridTime, relativeTime, updatedAgo } from '../../lib/time';
  import { rankAssetFor } from '../../config/rank-assets';
  import { renderMatchCards } from './matches/render';
  import type { RiotPublicResponse } from '../../lib/riot';
  import type {
    YouTubeFeedResponse,
    YouTubeFeedResult,
    YouTubeVideo,
  } from '../../types/content';

  const root = document.querySelector<HTMLElement>('[data-live-root]');
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const entered = new WeakSet<Element>();
  const pendingAnimations = new WeakMap<
    HTMLElement,
    { values: number[]; render: (values: number[]) => string }
  >();
  const easing = (progress: number) => 1 - Math.pow(1 - progress, 3);
  let valueObserver: IntersectionObserver | undefined;

  const animateNow = (
    node: HTMLElement,
    values: number[],
    render: (values: number[]) => string,
  ) => {
    const previous = (node.dataset.numericValue ?? '')
      .split(',')
      .map(Number)
      .filter(Number.isFinite);
    const from =
      previous.length === values.length ? previous : values.map(() => 0);
    node.dataset.numericValue = values.join(',');
    if (reducedMotion) {
      node.textContent = render(values);
      return;
    }
    const startedAt = performance.now();
    const duration = 850;
    const frame = (now: number) => {
      const progress = Math.min(1, (now - startedAt) / duration);
      const eased = easing(progress);
      node.textContent = render(
        values.map((value, index) => {
          const start = from[index] ?? 0;
          return start + (value - start) * eased;
        }),
      );
      if (progress < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    // Red de seguridad: en una pestaña en segundo plano `requestAnimationFrame`
    // puede no llegar a ejecutarse nunca — sin esto, el valor real quedaría
    // bloqueado en el esqueleto de carga aunque la API ya hubiera respondido.
    setTimeout(() => {
      node.textContent = render(values);
    }, duration + 100);
  };

  const animateValues = (
    selector: string,
    values: number[],
    render: (values: number[]) => string,
  ) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.classList.remove('data-skeleton', 'data-skeleton--line');
    if (entered.has(node) || reducedMotion) {
      animateNow(node, values, render);
      return;
    }
    pendingAnimations.set(node, { values, render });
    valueObserver?.observe(node);
  };

  if (!reducedMotion) {
    valueObserver = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const node = entry.target as HTMLElement;
          entered.add(node);
          valueObserver?.unobserve(node);
          const pending = pendingAnimations.get(node);
          if (pending) animateNow(node, pending.values, pending.render);
          pendingAnimations.delete(node);
        }),
      { threshold: 0.2 },
    );
  }

  const text = (selector: string, value: string) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node || node.textContent === value) return;
    node.textContent = value;
    if (
      !reducedMotion &&
      !node.classList.contains('data-skeleton') &&
      typeof node.animate === 'function'
    )
      node.animate(
        [
          { opacity: 0.45, transform: 'translate3d(0, 3px, 0)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0)' },
        ],
        { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
  };
  const visible = (selector: string, show: boolean) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (node) node.hidden = !show;
  };
  const number = (value?: number) =>
    value === undefined
      ? undefined
      : new Intl.NumberFormat('es-ES').format(value);
  let riotData: Extract<RiotPublicResponse, { ok: true }>['data'] | undefined;
  let videos: YouTubeFeedResult['videos'] = [];
  // Vídeos de `matchVideoLinks` ya resueltos en build time (lib/resolved-
  // match-video-content.ts) — la relación partida↔vídeo es permanente y no
  // debe depender de que el vídeo siga entre los últimos 12 subidos del
  // canal. Se parsean una sola vez; si el atributo faltara o viniera
  // corrupto, se degrada a "sin vídeos de partida" en vez de romper el
  // resto del dashboard.
  let matchVideos: YouTubeVideo[] = [];
  try {
    matchVideos = JSON.parse(root?.dataset.matchVideos ?? '[]');
  } catch {
    matchVideos = [];
  }
  let fetching = false;
  // Solo true mientras el fallo de Riot sea el motivo real por el que no
  // hay partidas que mostrar — nunca se confunde con "sin clasificatorias
  // recientes" (eso es data real: sampleSize === 0, no un fallo de red).
  let riotFailed = false;

  const renderMatches = () => {
    const list = root?.querySelector('[data-live-matches]');
    if (!list) return;
    // Sin `riotData` (todavía no ha llegado o Riot ha fallado) se pasa un
    // array vacío: `renderMatchCards` ya sabe pintar el estado vacío real
    // (`MatchEmpty`) en vez de dejar el esqueleto de carga para siempre.
    //
    // El pool de vídeos para resolver `MatchVideoBadge`/`MatchVideoPanel` se
    // amplía con `matchVideos` (resueltos en build time desde
    // `matchVideoLinks`, ver lib/resolved-match-video-content.ts) para que
    // una asociación verificada siga resolviendo aunque el vídeo ya no esté
    // entre los últimos 12 del canal. Solo se mezcla aquí, para esta
    // llamada — `videos` en sí no se toca, así que el resto del dashboard
    // (vídeos relacionados, actividad reciente) sigue mostrando únicamente
    // subidas reales y recientes del canal, sin vídeos de partida colándose.
    const matchVideoPool = [
      ...new Map(
        [...videos, ...matchVideos].map((video) => [video.id, video]),
      ).values(),
    ];
    // `recent.matches` ya viene limitado a `riotDefaults.recentSoloSample`
    // (10) desde `analyzeRecentSoloQueue` — mostrar las 10 no añade
    // ninguna llamada a Riot nueva, ya están en el cliente (encargo Page
    // Design Rework §17).
    renderMatchCards(list, riotData?.recent.matches.slice(0, 10) ?? [], {
      formatNumber: (value) => number(value) ?? String(value),
      relativeTime,
      reducedMotion,
      videos: matchVideoPool,
      matchesBase: root?.dataset.riotMatchesBase ?? '/api/riot/matches',
      // "No hay partidas" (sampleSize real 0) y "no se pudieron cargar"
      // (Riot ha fallado) son cosas distintas — solo se sobrescribe el
      // copy por defecto de MatchEmpty cuando es realmente un fallo.
      emptyState: riotFailed
        ? {
            label: 'Sin conexión con Riot',
            title: 'No se han podido cargar las partidas.',
            detail: 'Riot no responde ahora mismo — vuelve a intentarlo en unos minutos.',
          }
        : undefined,
    });
  };

  /**
   * Registro de temporada (ranked.wins/losses/winRate) — antes vivía en el
   * `PerformanceProfile`/`PlayerProfile` separado; ahora es una sola línea
   * de contexto dentro de "01 · Ahora", justo debajo del rango — el mismo
   * dato, sin una card entera solo para tres números (encargo §3/§17).
   */
  const renderSeasonRecord = () => {
    if (!riotData) return;
    const { ranked } = riotData;
    const hasRecord = ranked.available && ranked.wins !== undefined && ranked.losses !== undefined;
    visible('[data-season-record]', hasRecord);
    if (!hasRecord) return;
    const parts = [`${ranked.wins}V · ${ranked.losses}D`];
    if (ranked.winRate !== undefined) parts.push(`${ranked.winRate}% WR`);
    text('[data-season-record-line]', parts.join(' · '));
  };

  const renderRelatedGameplays = () => {
    const section = root?.querySelector<HTMLElement>(
      '[data-related-gameplays]',
    );
    const list = root?.querySelector('[data-related-gameplays-list]');
    if (!section || !list) return;
    const gameplays = videos.filter((video) => !video.isShort).slice(0, 3);
    section.hidden = gameplays.length === 0;
    list.replaceChildren(
      ...gameplays.map((video) => {
        const link = document.createElement('a');
        link.href = video.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.setAttribute('aria-label', `Ver en YouTube: ${video.title}`);
        const image = document.createElement('img');
        image.src = video.thumbnailUrl;
        image.alt = `Miniatura de ${video.title}`;
        image.width = 480;
        image.height = 270;
        image.loading = 'lazy';
        image.decoding = 'async';
        const copy = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = video.title;
        const meta = document.createElement('span');
        meta.textContent = [
          relativeTime(video.publishedAt),
          video.durationLabel,
        ]
          .filter(Boolean)
          .join(' · ');
        copy.append(title, meta);
        link.append(image, copy);
        return link;
      }),
    );
  };

  const updateRelativeLabels = () =>
    root?.querySelectorAll<HTMLElement>('[data-updated-at]').forEach((node) => {
      const suffix = node.dataset.updatedSuffix;
      node.textContent = `${updatedAgo(node.dataset.updatedAt)}${suffix ? ` · ${suffix}` : ''}`;
    });

  const markUpdated = (
    selector: string,
    timestamp: string,
    suffix?: string,
  ) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.classList.remove('data-skeleton', 'data-skeleton--meta');
    node.dataset.updatedAt = timestamp;
    node.toggleAttribute('data-updated-at', true);
    if (suffix) node.dataset.updatedSuffix = suffix;
    else delete node.dataset.updatedSuffix;
    node.textContent = `${updatedAgo(timestamp)}${suffix ? ` · ${suffix}` : ''}`;
  };

  const loadRiot = async () => {
    const response = await fetch(root!.dataset.riot!);
    const payload = (await response.json()) as RiotPublicResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    riotData = payload.data;
    riotFailed = false;
    const { profile, ranked, today, recent } = payload.data;
    text('[data-riot-id]', profile.riotId);
    text('[data-rank]', ranked.tier ?? 'Sin clasificación');
    root
      ?.querySelector('[data-rank]')
      ?.classList.remove('data-skeleton', 'live-stat-fallback');
    if (ranked.leaguePoints === undefined) {
      root
        ?.querySelector('[data-lp]')
        ?.classList.remove('data-skeleton', 'data-skeleton--line');
      text('[data-lp]', 'Sin LP disponibles');
    } else
      animateValues(
        '[data-lp]',
        [ranked.leaguePoints],
        ([value]) => `${Math.round(value ?? 0)} LP`,
      );
    markUpdated('[data-riot-updated]', payload.data.updatedAt);
    root
      ?.querySelector('[data-activity]')
      ?.classList.remove('data-skeleton', 'data-skeleton--copy');
    visible('[data-riot-error]', false);
    visible('[data-today-metrics]', today.games > 0);
    visible('[data-today-foot]', today.games > 0);
    visible('[data-today-empty]', today.games === 0);
    const emblem = root?.querySelector<HTMLImageElement>('[data-rank-emblem]');
    const emptySignature = root?.querySelector<HTMLImageElement>(
      '[data-today-empty-signature]',
    );
    const rankAsset = rankAssetFor(ranked.tier);
    if (emblem) {
      emblem.hidden = today.games === 0 || !rankAsset;
      if (
        !emblem.hidden &&
        rankAsset &&
        emblem.src !== new URL(rankAsset.src, location.href).href
      )
        emblem.src = rankAsset.src;
    }
    if (emptySignature) {
      emptySignature.hidden = today.games > 0;
      if (!emptySignature.hidden && !emptySignature.src)
        emptySignature.src = '/images/brand/lucian/lucian-high-noon-ready.webp';
    }

    if (today.games > 0) {
      text(
        '[data-activity]',
        today.lastPlayedAt
          ? `Última partida ${relativeTime(today.lastPlayedAt) ?? ''}`.trim()
          : 'Actividad registrada hoy',
      );
      animateValues('[data-today-games]', [today.games], ([value]) =>
        String(Math.round(value ?? 0)),
      );
      animateValues(
        '[data-today-record]',
        [today.wins, today.losses],
        ([wins, losses]) =>
          `${Math.round(wins ?? 0)}V · ${Math.round(losses ?? 0)}D`,
      );
      if (today.winRate === undefined) text('[data-today-wr]', 'Sin dato');
      else
        animateValues(
          '[data-today-wr]',
          [today.winRate],
          ([value]) => `${Math.round(value ?? 0)}%`,
        );
      if (today.averageKda === undefined) text('[data-today-kda]', 'Sin dato');
      else
        animateValues('[data-today-kda]', [today.averageKda], ([value]) =>
          (value ?? 0).toFixed(2).replace('.', ','),
        );
      text(
        '[data-today-champion]',
        today.mostPlayedChampion?.championName ?? 'Sin dato',
      );
      text(
        '[data-today-streak]',
        today.streak
          ? `${today.streak.games} ${today.streak.result === 'win' ? 'victorias' : 'derrotas'}`
          : 'Sin racha',
      );
    } else {
      text('[data-activity]', 'Sin clasificatorias hoy');
      const last = recent.matches[0]?.playedAt;
      const lastCopy = last
        ? `Última actividad competitiva: ${relativeTime(last) ?? ''} · ${madridTime(last) ?? ''}`
        : '';
      text('[data-last-competitive]', lastCopy);
      visible('[data-last-competitive]', Boolean(lastCopy));
    }

    renderSeasonRecord();
    renderMatches();
  };

  const loadFeed = async () => {
    const response = await fetch(root!.dataset.youtube!);
    const payload = (await response.json()) as YouTubeFeedResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    videos = payload.data.videos;
    renderMatches();
    renderRelatedGameplays();
  };

  const refresh = async (manual = false) => {
    if (fetching || (!manual && document.hidden)) return;
    fetching = true;
    const button = root?.querySelector<HTMLButtonElement>(
      '[data-profile-refresh]',
    );
    if (button) button.disabled = true;
    if (manual) text('[data-profile-refresh-state]', 'Actualizando…');
    const results = await Promise.allSettled([loadRiot(), loadFeed()]);
    if (results[0].status === 'rejected') {
      riotFailed = true;
      visible('[data-rank-emblem]', false);
      visible('[data-today-empty-signature]', false);
      // Un único mensaje compacto (aquí, en el propio rango) en vez del
      // mismo fallo repetido en 3-4 frases distintas de esta sección: el
      // bloque separado `.live-empty` (`[data-riot-error]`) ya no se
      // muestra — quedaría diciendo exactamente lo mismo.
      const rankNode = root?.querySelector('[data-rank]');
      rankNode?.classList.remove('data-skeleton');
      rankNode?.classList.add('live-stat-fallback');
      root
        ?.querySelector('[data-lp]')
        ?.classList.remove('data-skeleton', 'data-skeleton--line');
      root
        ?.querySelector('[data-activity]')
        ?.classList.remove('data-skeleton', 'data-skeleton--copy');
      text('[data-rank]', 'Riot no disponible');
      text('[data-lp]', '');
      text('[data-activity]', 'Reintentaremos automáticamente en unos minutos.');
      root
        ?.querySelector('[data-riot-updated]')
        ?.classList.remove('data-skeleton', 'data-skeleton--meta');
      text('[data-riot-updated]', 'Reintentando la conexión con Riot');
      renderMatches();
    }
    if (manual)
      text(
        '[data-profile-refresh-state]',
        results[0].status === 'fulfilled'
          ? 'Actualizado.'
          : 'No se ha podido actualizar ahora mismo.',
      );
    if (button) button.disabled = false;
    fetching = false;
  };

  refresh();
  window.setInterval(() => refresh(), 120_000);
  window.setInterval(updateRelativeLabels, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
  root
    ?.querySelector('[data-profile-refresh]')
    ?.addEventListener('click', () => refresh(true));

  root?.toggleAttribute('data-motion-ready', true);
  const modules = root?.querySelectorAll<HTMLElement>('.live-module');
  if (reducedMotion)
    modules?.forEach((module) => module.classList.add('is-visible'));
  else {
    const moduleObserver = new IntersectionObserver(
      (entries, observer) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }),
      { threshold: 0.08 },
    );
    modules?.forEach((module) => moduleObserver.observe(module));
  }
</script>
