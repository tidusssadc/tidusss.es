---
import { integrationEndpoints } from '../../config/platforms';
import MatchCard from './matches/MatchCard.astro';
import MatchEmpty from './matches/MatchEmpty.astro';
import PerformanceProfile from './PerformanceProfile.astro';
import LiveGameModule from './LiveGameModule.astro';
import RankEvolution from './RankEvolution.astro';
import { resolvedMatchVideoContent } from '../../lib/resolved-match-video-content';
---

<!--
  /competitivo — V4 "SoloQ Control Room". El objetivo ya no es "una página
  con estadísticas" sino el centro de mando diario de SoloQ de Tidusss:
  responde de inmediato a "¿cómo voy ahora?", luego a "¿por qué?", luego a
  "¿qué ha pasado en mis partidas?".

  Composición (rompe la pila de 5 capítulos de V3):
   1. COMMAND BAR sticky — HUD competitivo compacto: rango, LP, pico,
      Δ de sesión, racha, última partida, estado LIVE, actualización.
   2. Grid asimétrico: SESIÓN DE HOY (7) · EVOLUCIÓN LP (5).
   3. FORMA POR CAMPEÓN (5) · RENDIMIENTO RECIENTE + contexto (7)  [PerformanceProfile].
   4. HISTORIAL (12) — denso, con filtros client-side y "cargar anteriores".

  Todo client-side (sitio estático). Cero llamadas Riot nuevas frente a V3:
  el mismo `/api/riot/overview` ya trae 20 partidas y la sesión de hoy
  derivada; `/api/riot/rank-history` ya lo pedía RankEvolution.
-->
<main
  class="live-page"
  data-live-root
  data-youtube={integrationEndpoints.youtube}
  data-riot={integrationEndpoints.riot}
  data-riot-rank-history={integrationEndpoints.riotRankHistory}
  data-riot-matches-base={integrationEndpoints.riotMatchesBase}
  data-match-videos={JSON.stringify(resolvedMatchVideoContent)}
>
  <div class="command-bar-shell">
    <div class="live-container">
      <div class="command-bar" data-command-bar>
        <div class="cb-rank">
          <img
            class="cb-crest"
            data-rank-crest
            width="34"
            height="34"
            alt=""
            aria-hidden="true"
            decoding="async"
            hidden
          />
          <strong data-rank class="cb-tier data-skeleton data-skeleton--line" aria-label="Actualizando rango">&nbsp;</strong>
          <span data-lp class="cb-lp data-skeleton data-skeleton--line" aria-hidden="true">&nbsp;</span>
        </div>

        <div class="cb-facts" data-cb-facts>
          <span class="cb-fact" data-cb-peak hidden><b>pico</b> <span data-cb-peak-value></span></span>
          <span class="cb-fact cb-fact--session" data-cb-session hidden><b>sesión</b> <span data-cb-session-value></span></span>
          <span class="cb-fact" data-cb-streak hidden><span data-cb-streak-value></span></span>
          <span class="cb-fact" data-cb-last hidden><b>última</b> <span data-cb-last-value></span></span>
        </div>

        <div class="cb-tail">
          <span class="cb-account"><strong data-riot-id>Tidusss#FFX</strong><span>EUW · Solo/Duo</span></span>
          <span class="cb-live" data-cb-live>
            <i class="live-dot" aria-hidden="true"></i>
            <span data-cb-live-label>fuera de partida</span>
          </span>
          <small
            data-riot-updated
            class="cb-updated data-skeleton data-skeleton--meta"
            aria-label="Actualizando datos competitivos"
            aria-live="polite">&nbsp;</small
          >
          <button type="button" class="cb-refresh" data-profile-refresh aria-label="Actualizar datos competitivos">
            <span aria-hidden="true">↻</span>
          </button>
          <p class="sr-only" data-profile-refresh-state aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>

  <div class="live-container live-stack">
    <LiveGameModule />

    <!--
      HERO PANEL (Signature Pass §4): identidad + sesión + evolución como UN
      SOLO SISTEMA. Ultimate ya los unió en un contenedor, pero seguían
      leyéndose como 3 columnas con divisores. Ahora es una franja de
      identidad de ancho completo (`.hero-strip`: cresta → MASTER/LP → pico
      → Δ sesión → session run → cuenta) seguida del cuerpo (sesión +
      evolución) — se lee de arriba a abajo como una sola historia ("¿cómo
      va el grind?"), no como 3 casillas de una tabla. El rango/LP tiene
      tratamiento de "hero data" (§6), la sesión es una micro-historia con
      un "session run" W/L (§7, derivado de `today.matches`, sin llamadas
      Riot nuevas) que conecta visualmente con el Historial.
    -->
    <div class="hero-panel" data-hero-panel>
      <div class="hero-strip">
        <div class="hero-crest-wrap">
          <img
            class="hero-crest"
            data-rank-crest-hero
            width="64"
            height="64"
            alt=""
            aria-hidden="true"
            decoding="async"
            hidden
          />
        </div>
        <div class="hero-rank">
          <strong data-rank-hero class="hero-tier data-skeleton data-skeleton--line" aria-label="Actualizando rango">&nbsp;</strong>
          <span data-lp-hero class="hero-lp data-skeleton data-skeleton--line" aria-hidden="true">&nbsp;</span>
        </div>
        <dl class="hero-figures">
          <div data-hero-peak-row hidden>
            <dt>Pico observado</dt>
            <dd data-hero-peak></dd>
          </div>
          <div data-hero-session-row hidden>
            <dt>Sesión de hoy</dt>
            <dd data-hero-session></dd>
          </div>
        </dl>
        <ol class="hero-pips" data-session-pips aria-label="Resultados de la sesión de hoy, en orden cronológico"></ol>
        <p class="hero-account">
          <strong data-riot-id-hero>Tidusss#FFX</strong><span>EUW · Solo/Duo</span>
        </p>
      </div>

      <div class="hero-body">
      <section
        class="hero-session"
        aria-labelledby="session-title"
        data-session-module
      >
        <header class="live-module-head">
          <div>
            <span>Sesión de hoy</span>
            <h2 id="session-title" data-session-heading>Sesión de hoy</h2>
          </div>
          <small data-session-meta class="data-skeleton data-skeleton--meta">&nbsp;</small>
        </header>

        <div data-session-body hidden>
          <div class="session-headline">
            <strong data-session-record></strong>
            <span data-session-since></span>
          </div>
          <ul class="session-figs">
            <li><strong data-session-wr></strong><span>Win rate</span></li>
            <li><strong data-session-kda></strong><span>KDA</span></li>
            <li><strong data-session-csm></strong><span>CS/min</span></li>
            <li><strong data-session-dpm></strong><span>Daño/min</span></li>
          </ul>
          <p class="session-tags">
            <span data-session-streak-tag hidden>Racha <strong data-session-streak></strong></span>
            <span data-session-champ-tag hidden>Más jugado <strong data-session-champ></strong></span>
          </p>
          <ul class="insights" data-session-insights hidden></ul>
        </div>

        <div class="compact-empty" data-session-empty hidden>
          <strong>Sin clasificatorias hoy.</strong>
          <span>
            No hay Solo/Duo registrada desde las 00:00 en Europe/Madrid.
            <span data-session-last hidden></span>
          </span>
        </div>

        <div class="compact-empty" data-riot-error hidden>
          <strong>Riot no responde ahora mismo.</strong>
          <span>El resto del Control Room sigue funcionando — se reintenta solo.</span>
        </div>
      </section>

      <RankEvolution />
      </div>
    </div>

    <PerformanceProfile />

    <section
      class="live-module live-module--wide history-module"
      aria-labelledby="matches-title"
      data-history-module
    >
      <header class="live-module-head">
        <div>
          <span>Historial</span><h2 id="matches-title">Últimas partidas</h2>
        </div>
        <div class="history-filters" data-history-filters hidden>
          <div class="history-filter-group" role="group" aria-label="Filtrar por resultado">
            <button type="button" data-history-filter="all" aria-pressed="true">Todas</button>
            <button type="button" data-history-filter="win" aria-pressed="false">Victorias</button>
            <button type="button" data-history-filter="loss" aria-pressed="false">Derrotas</button>
          </div>
          <label class="history-champion-filter">
            <span class="sr-only">Filtrar por campeón</span>
            <select data-history-champion>
              <option value="">Todos los campeones</option>
            </select>
          </label>
        </div>
      </header>

      <ol class="live-match-list" data-live-matches aria-live="polite">
        <li
          class="live-loading live-loading--row match-card-skeleton"
          aria-label="Actualizando partidas"
        >
          <i></i><i></i><i></i>
        </li>
      </ol>
      <MatchCard />
      <MatchEmpty />

      <div class="history-more" data-history-more hidden>
        <p data-history-count aria-live="polite"></p>
        <button type="button" class="history-load-more" data-history-load-more>
          Cargar anteriores
        </button>
      </div>
    </section>

    <div class="related-gameplays live-module live-module--wide" data-related-gameplays hidden>
      <div class="profile-subhead">
        <h3>Gameplays recientes</h3>
        <small
          >Contenido real del canal; no implica asociación con una partida.</small
        >
      </div>
      <div data-related-gameplays-list></div>
    </div>
  </div>
</main>

<script>
  import { installCompetitiveQaIfRequested } from '../../lib/dev/competitive-qa';
  import { madridTime, relativeTime, updatedAgo } from '../../lib/time';
  import { rankAssetFor } from '../../config/rank-assets';
  import { formatRankLabel } from '../../lib/rank-history/format';
  import { renderMatchCards } from './matches/render';
  import {
    buildDeterministicInsights,
    deriveSessionLpDelta,
  } from '../../lib/riot/insights';
  import type { RiotPublicResponse } from '../../lib/riot';
  import type { RankHistoryPublicResponse } from '../../../functions/api/riot/rank-history';
  import type { RankEvolutionPoint, RankEvolutionSummary } from '../../lib/rank-history';
  import type {
    YouTubeFeedResponse,
    YouTubeFeedResult,
    YouTubeVideo,
  } from '../../types/content';

  // Modo de QA visual (previews de rama): no-op salvo `?qa=competitive-v3`
  // en un host que no sea producción. Se llama antes que cualquier fetch.
  installCompetitiveQaIfRequested();

  const root = document.querySelector<HTMLElement>('[data-live-root]');
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  const text = (selector: string, value: string) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node || node.textContent === value) return;
    node.textContent = value;
    if (
      !reducedMotion &&
      !node.classList.contains('data-skeleton') &&
      typeof node.animate === 'function'
    )
      node.animate(
        [
          { opacity: 0.45, transform: 'translate3d(0, 2px, 0)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0)' },
        ],
        { duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
  };
  const visible = (selector: string, show: boolean) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (node) node.hidden = !show;
  };
  const unskeleton = (selector: string) =>
    root
      ?.querySelector(selector)
      ?.classList.remove(
        'data-skeleton',
        'data-skeleton--line',
        'data-skeleton--meta',
        'data-skeleton--copy',
      );
  const decimal = (value?: number, digits = 2) =>
    value === undefined ? '—' : value.toFixed(digits).replace('.', ',');
  const number = (value?: number) =>
    value === undefined
      ? undefined
      : new Intl.NumberFormat('es-ES').format(value);

  let riotData: Extract<RiotPublicResponse, { ok: true }>['data'] | undefined;
  let rankPoints: RankEvolutionPoint[] = [];
  let videos: YouTubeFeedResult['videos'] = [];
  let matchVideos: YouTubeVideo[] = [];
  try {
    matchVideos = JSON.parse(root?.dataset.matchVideos ?? '[]');
  } catch {
    matchVideos = [];
  }
  let fetching = false;
  let riotFailed = false;

  // --- Historial: filtros + "cargar anteriores", todo client-side sobre las
  // partidas que ya están en el payload (hasta 20). ---
  const HISTORY_PAGE = 10;
  let historyResult: 'all' | 'win' | 'loss' = 'all';
  let historyChampion = '';
  let historyVisible = HISTORY_PAGE;
  let lastNewestMatchId: string | undefined;

  const filteredMatches = () => {
    const all = riotData?.recent.matches ?? [];
    return all.filter((match) => {
      if (historyResult === 'win' && !match.win) return false;
      if (historyResult === 'loss' && match.win) return false;
      if (historyChampion && match.championName !== historyChampion) return false;
      return true;
    });
  };

  const renderHistory = () => {
    const list = root?.querySelector('[data-live-matches]');
    if (!list) return;
    const matchVideoPool = [
      ...new Map(
        [...videos, ...matchVideos].map((video) => [video.id, video]),
      ).values(),
    ];
    const all = filteredMatches();
    const slice = all.slice(0, historyVisible);
    renderMatchCards(list, slice, {
      formatNumber: (value) => number(value) ?? String(value),
      relativeTime,
      reducedMotion,
      videos: matchVideoPool,
      matchesBase: root?.dataset.riotMatchesBase ?? '/api/riot/matches',
      showLatestTag: historyResult === 'all' && !historyChampion,
      emptyState: riotFailed
        ? {
            label: 'Sin conexión con Riot',
            title: 'No se han podido cargar las partidas.',
            detail:
              'Riot no responde ahora mismo — vuelve a intentarlo en unos minutos.',
          }
        : undefined,
    });

    // Resalta la partida más reciente SOLO cuando es nueva respecto al
    // último render (llegó una partida terminada mientras la página estaba
    // abierta) — nunca en la primera carga. Client-side, sutil, y sin
    // movimiento si el usuario lo ha pedido.
    const newestId = riotData?.recent.matches[0]?.matchId;
    if (
      newestId &&
      lastNewestMatchId &&
      newestId !== lastNewestMatchId &&
      historyResult === 'all' &&
      !historyChampion
    ) {
      const firstCard = list.querySelector<HTMLElement>('[data-match-card]');
      if (firstCard) {
        firstCard.dataset.newest = 'true';
        if (!reducedMotion)
          window.setTimeout(() => firstCard.removeAttribute('data-newest'), 6000);
      }
    }
    lastNewestMatchId = newestId;

    const more = root?.querySelector<HTMLElement>('[data-history-more]');
    if (more) {
      const hasMore = all.length > slice.length;
      more.hidden = all.length <= HISTORY_PAGE;
      text(
        '[data-history-count]',
        all.length
          ? `${slice.length} de ${all.length}${
              riotData && all.length < riotData.recent.matches.length
                ? ' (filtradas)'
                : ''
            }`
          : '',
      );
      const button = more.querySelector<HTMLButtonElement>('[data-history-load-more]');
      if (button) button.hidden = !hasMore;
    }
  };

  const setupHistoryControls = () => {
    const filters = root?.querySelector<HTMLElement>('[data-history-filters]');
    if (!filters) return;
    filters.querySelectorAll<HTMLButtonElement>('[data-history-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        historyResult = (button.dataset.historyFilter ?? 'all') as typeof historyResult;
        historyVisible = HISTORY_PAGE;
        filters
          .querySelectorAll<HTMLButtonElement>('[data-history-filter]')
          .forEach((other) =>
            other.setAttribute('aria-pressed', String(other === button)),
          );
        renderHistory();
      });
    });
    const select = filters.querySelector<HTMLSelectElement>('[data-history-champion]');
    select?.addEventListener('change', () => {
      historyChampion = select.value;
      historyVisible = HISTORY_PAGE;
      renderHistory();
    });
    root
      ?.querySelector<HTMLButtonElement>('[data-history-load-more]')
      ?.addEventListener('click', () => {
        historyVisible += HISTORY_PAGE;
        renderHistory();
      });
  };

  const syncChampionFilterOptions = () => {
    const select = root?.querySelector<HTMLSelectElement>('[data-history-champion]');
    if (!select || !riotData) return;
    const names = [
      ...new Set(riotData.recent.matches.map((match) => match.championName)),
    ].sort();
    const current = select.value;
    select.replaceChildren(
      Object.assign(document.createElement('option'), {
        value: '',
        textContent: 'Todos los campeones',
      }),
      ...names.map((name) =>
        Object.assign(document.createElement('option'), {
          value: name,
          textContent: name,
        }),
      ),
    );
    if (names.includes(current)) select.value = current;
    else historyChampion = '';
  };

  // --- Command bar + hero identity (mismo dato, dos lecturas: la barra
  // sticky es utilidad de contexto; el hero es el "MASTER 554 LP" con peso
  // real que pide el encargo §7 — ninguna de las dos inventa nada nuevo). ---
  const renderCommandBar = () => {
    if (!riotData) return;
    const { profile, ranked, today } = riotData;
    text('[data-riot-id]', profile.riotId);
    text('[data-riot-id-hero]', profile.riotId);
    unskeleton('[data-rank]');
    unskeleton('[data-lp]');
    unskeleton('[data-rank-hero]');
    unskeleton('[data-lp-hero]');
    root?.querySelector('[data-rank]')?.classList.remove('live-stat-fallback');
    root?.querySelector('[data-rank-hero]')?.classList.remove('live-stat-fallback');
    text('[data-rank]', ranked.tier ?? 'Sin clasificación');
    text('[data-rank-hero]', ranked.tier ?? 'Sin clasificación');
    if (ranked.leaguePoints === undefined) {
      text('[data-lp]', '');
      text('[data-lp-hero]', '');
      visible('[data-lp]', false);
      visible('[data-lp-hero]', false);
    } else {
      visible('[data-lp]', true);
      visible('[data-lp-hero]', true);
      text('[data-lp]', `${ranked.leaguePoints} LP`);
      text('[data-lp-hero]', `${ranked.leaguePoints}`);
    }

    const rankAsset = rankAssetFor(ranked.tier);
    for (const selector of ['[data-rank-crest]', '[data-rank-crest-hero]']) {
      const crest = root?.querySelector<HTMLImageElement>(selector);
      if (!crest) continue;
      crest.hidden = !rankAsset;
      if (rankAsset && crest.src !== new URL(rankAsset.src, location.href).href)
        crest.src = rankAsset.src;
    }

    // Δ de sesión: solo si hay un snapshot real anterior a la primera ranked
    // de hoy (`deriveSessionLpDelta`). Si no, "pendiente" — nunca se calcula.
    const sessionDelta = deriveSessionLpDelta(
      rankPoints,
      today.firstPlayedAt,
      ranked.leaguePoints === undefined
        ? undefined
        : { observedAt: riotData.updatedAt, tier: ranked.tier, rank: ranked.rank, leaguePoints: ranked.leaguePoints },
    );
    const sessionValueText = !sessionDelta
      ? 'pendiente de histórico'
      : sessionDelta.tierChanged
        ? `${sessionDelta.fromLabel} → ${sessionDelta.toLabel}`
        : `${sessionDelta.delta >= 0 ? '+' : ''}${sessionDelta.delta} LP`;
    if (today.games === 0) {
      visible('[data-cb-session]', false);
      visible('[data-hero-session-row]', false);
    } else {
      visible('[data-cb-session]', true);
      visible('[data-hero-session-row]', true);
      text('[data-cb-session-value]', sessionValueText);
      text('[data-hero-session]', sessionValueText);
      const positive = Boolean(sessionDelta) && sessionDelta!.delta > 0;
      const negative = Boolean(sessionDelta) && sessionDelta!.delta < 0;
      root?.querySelector('[data-cb-session]')?.classList.toggle('cb-fact--pos', positive);
      root?.querySelector('[data-cb-session]')?.classList.toggle('cb-fact--neg', negative);
      root?.querySelector('[data-hero-session-row]')?.classList.toggle('is-pos', positive);
      root?.querySelector('[data-hero-session-row]')?.classList.toggle('is-neg', negative);
    }

    if (today.streak && today.streak.games >= 2) {
      visible('[data-cb-streak]', true);
      const isWin = today.streak.result === 'win';
      text(
        '[data-cb-streak-value]',
        `${isWin ? '▲' : '▼'} ${today.streak.games} ${isWin ? 'victorias' : 'derrotas'}`,
      );
      root
        ?.querySelector('[data-cb-streak]')
        ?.classList.toggle('cb-fact--pos', isWin);
      root
        ?.querySelector('[data-cb-streak]')
        ?.classList.toggle('cb-fact--neg', !isWin);
    } else {
      visible('[data-cb-streak]', false);
    }

    const last = today.lastPlayedAt ?? riotData.recent.matches[0]?.playedAt;
    if (last) {
      visible('[data-cb-last]', true);
      text('[data-cb-last-value]', relativeTime(last) ?? '');
    } else {
      visible('[data-cb-last]', false);
    }
  };

  const renderRankHistoryFacts = (summary: RankEvolutionSummary) => {
    if (!summary.available) {
      visible('[data-cb-peak]', false);
      visible('[data-hero-peak-row]', false);
      return;
    }
    rankPoints = summary.points;
    if (summary.peak) {
      const peakLabel = formatRankLabel(summary.peak.tier, summary.peak.rank);
      visible('[data-cb-peak]', true);
      visible('[data-hero-peak-row]', true);
      text('[data-cb-peak-value]', peakLabel);
      text('[data-hero-peak]', peakLabel);
    }
    // La barra de comando y el hero pueden pintar el Δ de sesión ahora que hay puntos.
    renderCommandBar();
  };

  // --- Micro-secuencia W/L de la sesión (encargo Art Direction §8): los
  // mismos `today.matches` que ya alimentan el resto de "Sesión de hoy",
  // en orden cronológico (la primera partida del día a la izquierda) — 0
  // llamadas Riot nuevas, mismo lenguaje de color que Match History. ---
  const renderSessionPips = () => {
    const list = root?.querySelector<HTMLElement>('[data-session-pips]');
    if (!list) return;
    const matches = riotData?.today.matches ?? [];
    if (!matches.length) {
      list.hidden = true;
      list.replaceChildren();
      return;
    }
    list.hidden = false;
    list.replaceChildren(
      ...[...matches].reverse().map((match) => {
        const item = document.createElement('li');
        item.className = match.win ? 'is-victory' : 'is-defeat';
        item.title = `${match.win ? 'Victoria' : 'Derrota'} · ${match.championName}`;
        return item;
      }),
    );
  };

  // --- Sesión de hoy ---
  const renderSession = () => {
    if (!riotData) return;
    const { today } = riotData;
    unskeleton('[data-session-meta]');
    const hasGames = today.games > 0;
    visible('[data-session-body]', hasGames && !riotFailed);
    visible('[data-session-empty]', !hasGames && !riotFailed);
    visible('[data-riot-error]', riotFailed);
    renderSessionPips();
    if (riotFailed) return;

    if (!hasGames) {
      text('[data-session-heading]', 'Sesión de hoy');
      text('[data-session-meta]', 'Sin partidas');
      const last = riotData.recent.matches[0]?.playedAt;
      if (last) {
        visible('[data-session-last]', true);
        text(
          '[data-session-last]',
          `Última actividad: ${relativeTime(last) ?? ''} · ${madridTime(last) ?? ''}`,
        );
      }
      return;
    }

    text('[data-session-heading]', 'Sesión de hoy');
    text(
      '[data-session-meta]',
      today.lastPlayedAt
        ? `Última hace ${relativeTime(today.lastPlayedAt)?.replace('hace ', '') ?? '—'}`
        : `${today.games} partidas`,
    );
    text('[data-session-record]', `${today.wins}V · ${today.losses}D`);
    text(
      '[data-session-since]',
      today.firstPlayedAt
        ? `desde las ${madridTime(today.firstPlayedAt) ?? ''}`
        : '',
    );
    text('[data-session-wr]', today.winRate === undefined ? '—' : `${today.winRate}%`);
    text('[data-session-kda]', decimal(today.averageKda));
    text('[data-session-csm]', decimal(today.averageCsPerMinute, 1));
    text(
      '[data-session-dpm]',
      today.averageDamagePerMinute === undefined
        ? '—'
        : String(Math.round(today.averageDamagePerMinute)),
    );

    visible('[data-session-streak-tag]', Boolean(today.streak));
    if (today.streak)
      text(
        '[data-session-streak]',
        `${today.streak.games} ${today.streak.result === 'win' ? 'victorias' : 'derrotas'}`,
      );
    visible('[data-session-champ-tag]', Boolean(today.mostPlayedChampion));
    if (today.mostPlayedChampion)
      text('[data-session-champ]', today.mostPlayedChampion.championName);

    const insights = buildDeterministicInsights(riotData, 4);
    const list = root?.querySelector('[data-session-insights]');
    if (list) {
      list.replaceChildren(
        ...insights.map((insight) => {
          const item = document.createElement('li');
          item.textContent = insight.text;
          return item;
        }),
      );
      (list as HTMLElement).hidden = insights.length === 0;
    }
  };

  const renderRelatedGameplays = () => {
    const section = root?.querySelector<HTMLElement>('[data-related-gameplays]');
    const list = root?.querySelector('[data-related-gameplays-list]');
    if (!section || !list) return;
    const gameplays = videos.filter((video) => !video.isShort).slice(0, 3);
    section.hidden = gameplays.length === 0;
    list.replaceChildren(
      ...gameplays.map((video) => {
        const link = document.createElement('a');
        link.href = video.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.setAttribute('aria-label', `Ver en YouTube: ${video.title}`);
        const image = document.createElement('img');
        image.src = video.thumbnailUrl;
        image.alt = `Miniatura de ${video.title}`;
        image.width = 480;
        image.height = 270;
        image.loading = 'lazy';
        image.decoding = 'async';
        const copy = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = video.title;
        const meta = document.createElement('span');
        meta.textContent = [relativeTime(video.publishedAt), video.durationLabel]
          .filter(Boolean)
          .join(' · ');
        copy.append(title, meta);
        link.append(image, copy);
        return link;
      }),
    );
  };

  const updateRelativeLabels = () =>
    root?.querySelectorAll<HTMLElement>('[data-updated-at]').forEach((node) => {
      const suffix = node.dataset.updatedSuffix;
      node.textContent = `${updatedAgo(node.dataset.updatedAt)}${suffix ? ` · ${suffix}` : ''}`;
    });

  const markUpdated = (selector: string, timestamp: string) => {
    const node = root?.querySelector<HTMLElement>(selector);
    if (!node) return;
    node.classList.remove('data-skeleton', 'data-skeleton--meta');
    node.dataset.updatedAt = timestamp;
    node.toggleAttribute('data-updated-at', true);
    node.textContent = updatedAgo(timestamp);
  };

  const loadRiot = async () => {
    const response = await fetch(root!.dataset.riot!);
    const payload = (await response.json()) as RiotPublicResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    riotData = payload.data;
    riotFailed = false;
    markUpdated('[data-riot-updated]', payload.data.updatedAt);
    renderCommandBar();
    renderSession();
    syncChampionFilterOptions();
    visible('[data-history-filters]', riotData.recent.matches.length > 0);
    renderHistory();
  };

  const loadRankHistory = async () => {
    try {
      const response = await fetch(root!.dataset.riotRankHistory!);
      const payload = (await response.json()) as RankHistoryPublicResponse;
      if (payload.ok) renderRankHistoryFacts(payload.data);
    } catch {
      /* la barra de comando simplemente no muestra pico/Δ de sesión */
    }
  };

  const loadFeed = async () => {
    const response = await fetch(root!.dataset.youtube!);
    const payload = (await response.json()) as YouTubeFeedResponse;
    if (!payload.ok) throw new Error(payload.error.code);
    videos = payload.data.videos;
    renderHistory();
    renderRelatedGameplays();
  };

  const applyRiotFailure = () => {
    riotFailed = true;
    for (const selector of ['[data-rank]', '[data-rank-hero]']) {
      const rankNode = root?.querySelector(selector);
      rankNode?.classList.remove('data-skeleton', 'data-skeleton--line');
      rankNode?.classList.add('live-stat-fallback');
      text(selector, 'Riot no disponible');
    }
    unskeleton('[data-lp]');
    unskeleton('[data-lp-hero]');
    unskeleton('[data-riot-updated]');
    text('[data-lp]', '');
    text('[data-lp-hero]', '');
    visible('[data-lp]', false);
    visible('[data-lp-hero]', false);
    visible('[data-cb-peak]', false);
    visible('[data-hero-peak-row]', false);
    visible('[data-cb-session]', false);
    visible('[data-hero-session-row]', false);
    visible('[data-cb-streak]', false);
    visible('[data-cb-last]', false);
    visible('[data-rank-crest]', false);
    visible('[data-rank-crest-hero]', false);
    text('[data-riot-updated]', 'Reintentando…');
    renderSession();
    renderHistory();
  };

  const refresh = async (manual = false) => {
    if (fetching || (!manual && document.hidden)) return;
    fetching = true;
    const button = root?.querySelector<HTMLButtonElement>('[data-profile-refresh]');
    if (button) button.disabled = true;
    if (manual) text('[data-profile-refresh-state]', 'Actualizando…');
    const results = await Promise.allSettled([loadRiot(), loadFeed(), loadRankHistory()]);
    if (results[0].status === 'rejected') applyRiotFailure();
    if (manual)
      text(
        '[data-profile-refresh-state]',
        results[0].status === 'fulfilled'
          ? 'Actualizado.'
          : 'No se ha podido actualizar ahora mismo.',
      );
    if (button) button.disabled = false;
    fetching = false;
  };

  setupHistoryControls();
  refresh();
  window.setInterval(() => refresh(), 120_000);
  window.setInterval(updateRelativeLabels, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refresh();
  });
  root
    ?.querySelector('[data-profile-refresh]')
    ?.addEventListener('click', () => refresh(true));

  // Barra de comando: sin duplicar la identidad del hero panel (encargo
  // Signature §5). Mientras el hero panel es visible, la barra sticky se
  // queda en su estado MÍNIMO (cresta + tier, sin repetir LP/pico/sesión/
  // racha/última — el hero ya lo dice todo, más grande y mejor). En cuanto
  // el hero sale del viewport al hacer scroll (su borde inferior cruza la
  // línea donde queda pegada la barra, ~73px), la barra pasa a su estado
  // COMPLETO y adopta ese contexto por el resto de la página. Sin saltos de
  // layout: ambos estados caben en la misma altura de línea, solo cambia
  // qué contenido horizontal se muestra. `getBoundingClientRect()` + un
  // listener de scroll pasivo con throttle a un frame — más barato y más
  // predecible aquí que un `IntersectionObserver` con `rootMargin` (que
  // dispara de forma perezosa/por lotes en algunos entornos).
  const commandBar = root?.querySelector<HTMLElement>('[data-command-bar]');
  const heroPanel = root?.querySelector<HTMLElement>('[data-hero-panel]');
  if (commandBar && heroPanel) {
    // Una lectura de layout (`getBoundingClientRect`) + una escritura de
    // atributo — barato de sobra para correr en cada evento de scroll sin
    // throttle propio. Se evita a propósito `requestAnimationFrame`: en
    // pestañas en segundo plano el navegador puede pausarlo o diferirlo
    // segundos, lo que dejaría la barra en el estado equivocado más tiempo
    // del necesario para algo tan barato.
    const syncFull = () => {
      const heroVisible = heroPanel.getBoundingClientRect().bottom > 73;
      commandBar.toggleAttribute('data-full', !heroVisible);
    };
    window.addEventListener('scroll', syncFull, { passive: true });
    window.addEventListener('resize', syncFull, { passive: true });
    syncFull();
  }

  root?.toggleAttribute('data-motion-ready', true);
  const modules = root?.querySelectorAll<HTMLElement>('.live-module');
  if (reducedMotion)
    modules?.forEach((module) => module.classList.add('is-visible'));
  else {
    const moduleObserver = new IntersectionObserver(
      (entries, observer) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }),
      { threshold: 0.08 },
    );
    modules?.forEach((module) => moduleObserver.observe(module));
  }
</script>
