---
import RunesRow from './RunesRow.astro';
import SummonersRow from './SummonersRow.astro';
---

<!--
  Nivel 2 de profundidad (encargo Page Design Rework §21): el detalle real
  de TU partida — runas, hechizos, distinciones — que antes vivía siempre
  visible en la fila colapsada y ahora solo aparece al expandir.

  Signature §10: CS/Daño/Oro se retiraron de aquí — desde que existe el
  duelo Tidusss vs ADC rival (`.match-duel`), mostrarlos otra vez en esta
  misma vista era el mismo dato dos veces. Lo que queda es lo que el
  duelo NO cubre: participación en kills, visión, y el build real.
-->
<div class="match-your-build">
  <div class="match-badges" data-match-badges hidden aria-label="Distinciones de la partida"></div>
  <dl class="match-your-build-stats">
    <div><dt>Participación</dt><dd data-match-participation></dd></div>
    <div><dt>Visión</dt><dd data-match-vision></dd></div>
  </dl>
  <div class="match-your-build-assets">
    <RunesRow />
    <SummonersRow />
  </div>
</div>
