<aside class="match-video-panel" data-match-video-panel hidden>
  <img
    data-match-video-thumbnail
    width="480"
    height="270"
    alt=""
    loading="lazy"
    decoding="async"
  />
  <div>
    <span>Gameplay verificado</span>
    <h4 data-match-video-title></h4>
    <p>
      <time data-match-video-date></time>
      <span data-match-video-duration></span>
    </p>
    <a data-match-video-link target="_blank" rel="noopener noreferrer"
      >Ver gameplay completo ↗</a
    >
  </div>
</aside>
