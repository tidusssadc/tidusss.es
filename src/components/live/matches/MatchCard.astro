---
import MatchExpanded from './MatchExpanded.astro';
import MatchTimelinePanel from './MatchTimelinePanel.astro';
import MatchVideoPanel from './MatchVideoPanel.astro';
import MatchYourBuild from './MatchYourBuild.astro';
---

<!--
  Match row — no una card completa (encargo Page Design Rework §7). Nivel 1
  de profundidad: solo lo que se escanea en <2s (resultado/campeón/KDA/CS/
  duración/fecha/LP real/objetos). Todo lo demás (stats secundarias reales,
  runas, hechizos) vive en el detalle expandido (Nivel 2) — nunca duplicado
  en las dos capas.
-->
<template data-match-card-template>
  <li class="match-row-item" data-match-card>
    <article>
      <div class="match-row">
        <span class="match-row-accent" aria-hidden="true"></span>
        <div class="match-row-top">
          <img
            class="match-row-champion"
            data-match-champion-image
            width="48"
            height="48"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="match-row-identity">
            <strong data-match-champion></strong>
            <small data-match-position></small>
          </div>
          <div class="match-row-result">
            <strong data-match-status></strong>
            <span data-match-relative></span>
          </div>
        </div>
        <div class="match-row-meta">
          <div class="match-row-kda">
            <strong data-match-score></strong>
            <span data-match-kda></span>
          </div>
          <div class="match-row-metric">
            <strong data-match-csm></strong>
            <span>CS/min</span>
          </div>
          <div class="match-row-duration">
            <strong data-match-context-duration></strong>
            <time data-match-time></time>
          </div>
          <div class="match-row-lp">
            <strong data-match-lp>Pendiente</strong>
          </div>
        </div>
        <div class="match-row-items" data-match-items-compact aria-hidden="true">
          {
            Array.from({ length: 7 }, (_, index) => (
              <i data-item-slot={index}>
                <img width="18" height="18" alt="" loading="lazy" decoding="async" />
              </i>
            ))
          }
        </div>
        <span class="match-row-video" data-match-video-badge hidden aria-hidden="true">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="m6.2 4.8 4.2 3.2-4.2 3.2V4.8Z"></path>
          </svg>
        </span>
        <i class="match-row-chevron" aria-hidden="true"></i>
        <button
          type="button"
          class="match-row-hit"
          data-match-expand
          aria-expanded="false"
        >
          <span class="sr-only">Ver detalle de la partida</span>
        </button>
      </div>
      <MatchExpanded>
        <MatchYourBuild />
        <MatchVideoPanel />
        <MatchTimelinePanel />
      </MatchExpanded>
    </article>
  </li>
</template>
