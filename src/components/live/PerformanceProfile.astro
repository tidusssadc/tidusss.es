---
import { integrationEndpoints } from '../../config/platforms';
import { buildLabRegistry, getAdcRoster } from '../../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  leagueLaboratoryPatches,
  officialAdcTierList,
} from '../../data/league-laboratory';

/**
 * El roster ADC oficial de Tidusss (el mismo de la Tier List, "Champion
 * Pool" nunca mantiene una segunda lista a mano) se resuelve aquí, en
 * build time — server-side, gratis — y se pasa al cliente como una simple
 * lista de nombres (`dataDragonKey`, el mismo formato que usa
 * `ChampionPerformance.championName`, ambos vienen de Data Dragon). Así el
 * script del cliente no necesita importar el dominio de `league-laboratory`
 * completo solo para filtrar 25 nombres.
 */
const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
});
const adcRosterNames = getAdcRoster(registry).map((entry) => entry.catalogEntry.dataDragonKey);
---

<!--
  "Rendimiento" + "Champion Pool" + "Patrones" — Sprint Champion Analytics
  de Competitivo V2. Un solo componente, un solo fetch a `/api/riot/overview`
  (mismo dataset ya cacheado que el resto de Competitivo; un fetch más del
  cliente no dispara ninguna llamada Riot nueva — ver `performance.ts`).
  Todo lo que se pinta es DIRECTA/DERIVADA de Match-V5, nunca una
  estimación ni un score propio.
-->
<section
  class="live-module live-module--wide performance-profile"
  aria-labelledby="performance-profile-title"
  data-performance-profile
  data-riot={integrationEndpoints.riot}
  data-adc-roster={JSON.stringify(adcRosterNames)}
>
  <header class="live-module-head">
    <div>
      <span>02 / Rendimiento</span>
      <h2 id="performance-profile-title">Forma reciente</h2>
    </div>
    <small data-performance-sample>Actividad reciente</small>
  </header>

  <div
    class="live-loading live-loading--row performance-loading"
    data-performance-loading
    aria-label="Actualizando rendimiento"
  >
    <i></i><i></i><i></i>
  </div>

  <div data-performance-body hidden>
    <div class="stat-row" data-window-stats></div>
    <p class="stat-row-meta" data-window-meta></p>

    <div class="window-compare" data-window-compare></div>
  </div>

  <div class="compact-empty" data-performance-empty hidden>
    <strong>La muestra reciente todavía no contiene partidas de Solo/Duo.</strong>
    <span>Este bloque se completará en cuanto Riot devuelva actividad clasificatoria.</span>
  </div>

  <div class="live-empty" data-performance-error hidden>
    <strong>Riot no responde ahora mismo.</strong>
    <p>El resto de Competitivo sigue funcionando — este bloque se actualizará solo.</p>
  </div>
</section>

<section
  class="live-module live-module--wide champion-pool"
  aria-labelledby="champion-pool-title"
  data-champion-pool
  hidden
>
  <header class="live-module-head">
    <div>
      <span>03 / Campeones</span>
      <h2 id="champion-pool-title">Champion Pool</h2>
    </div>
    <small data-pool-sample></small>
  </header>

  <ol class="pool-hero" data-pool-hero></ol>

  <div class="profile-subhead">
    <h3>Distribución</h3>
    <small data-pool-distribution-note></small>
  </div>
  <div class="pool-distribution" data-pool-distribution></div>

  <div data-pool-dpm-block hidden>
    <div class="profile-subhead">
      <h3>Daño por minuto</h3>
      <small>Solo campeones con muestra suficiente (3+ partidas)</small>
    </div>
    <ul class="dpm-chart" data-pool-dpm></ul>
  </div>

  <div data-pool-secondary-block hidden>
    <div class="profile-subhead">
      <h3>Muestra pequeña</h3>
      <small>1-2 partidas — todavía no representativo</small>
    </div>
    <ul class="pool-secondary" data-pool-secondary></ul>
  </div>

  <div data-pool-off-role-block hidden>
    <div class="profile-subhead">
      <h3>Fuera del rol ADC</h3>
      <small>Partidas reales fuera del roster ADC — no protagonizan Champion Pool</small>
    </div>
    <ul class="pool-secondary" data-pool-off-role></ul>
  </div>
</section>

<section
  class="live-module live-module--wide patterns-module"
  aria-labelledby="patterns-title"
  data-patterns
  hidden
>
  <header class="live-module-head">
    <div><span>04 / Patrones</span><h2 id="patterns-title">Patrones</h2></div>
  </header>

  <div class="patterns-grid">
    <div class="pattern-block">
      <h3>Con support</h3>
      <small data-performance-synergy-note></small>
      <ul class="performance-relations" data-performance-synergy></ul>
    </div>
    <div class="pattern-block">
      <h3>Vs. ADC rival</h3>
      <small data-performance-matchups-note></small>
      <ul class="performance-relations" data-performance-matchups></ul>
    </div>
    <div class="pattern-block">
      <h3>Lado del mapa</h3>
      <ul class="performance-bars" data-performance-side></ul>
    </div>
    <div class="pattern-block">
      <h3>Duración</h3>
      <p class="performance-duration-summary" data-performance-duration-summary></p>
      <ul class="performance-bars" data-performance-duration></ul>
    </div>
  </div>

  <div class="profile-subhead">
    <h3>Actividad</h3>
    <small>Europe/Madrid</small>
  </div>
  <div class="activity-compact">
    <ul class="performance-bars" data-performance-weekday></ul>
    <ul class="performance-bars" data-performance-hourband></ul>
  </div>
</section>

<script>
  import type { RiotPublicResponse } from '../../lib/riot';
  import {
    splitChampionsByAdcRoster,
    tierChampionsBySampleSize,
    topChampionsByDamagePerMinute,
  } from '../../lib/riot';
  import type {
    ActivityBucket,
    AdcMatchupEntry,
    ChampionPerformance,
    DurationBucketEntry,
    PerformanceWindow,
    ProfilePerformance,
    SideSplitEntry,
    SupportSynergyEntry,
    TrendPoint,
  } from '../../lib/riot';

  const performanceRoot = document.querySelector<HTMLElement>('[data-performance-profile]');
  const poolRoot = document.querySelector<HTMLElement>('[data-champion-pool]');
  const patternsRoot = document.querySelector<HTMLElement>('[data-patterns]');

  if (performanceRoot && poolRoot && patternsRoot) {
    let adcRosterNames: string[] = [];
    try {
      adcRosterNames = JSON.parse(performanceRoot.dataset.adcRoster ?? '[]');
    } catch {
      adcRosterNames = [];
    }

    const decimal = (value?: number) =>
      value === undefined ? '—' : value.toFixed(2).replace('.', ',');
    const decimal1 = (value?: number) =>
      value === undefined ? '—' : String(value).replace('.', ',');
    const percent = (value?: number) => (value === undefined ? '—' : `${value}%`);
    const durationLabel = (seconds?: number) => {
      if (seconds === undefined) return '—';
      const minutes = Math.round(seconds / 60);
      return `${minutes} min`;
    };
    const text = (root: HTMLElement, selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };
    const el = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
    ): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      return node;
    };

    // --- 02 · Rendimiento — tipografía grande + una comparativa compacta,
    // nunca seis cajas idénticas (encargo §17). ---

    const STAT_TILES: Array<{ key: keyof PerformanceWindow; label: string; format: (v?: number) => string }> = [
      { key: 'winRate', label: 'WR', format: percent },
      { key: 'averageKda', label: 'KDA', format: decimal },
      { key: 'averageKillParticipation', label: 'KP', format: (v) => (v === undefined ? '—' : `${decimal1(v)}%`) },
      { key: 'averageCsPerMinute', label: 'CS/MIN', format: decimal1 },
      { key: 'averageGoldPerMinute', label: 'ORO/MIN', format: decimal1 },
      { key: 'averageDamagePerMinute', label: 'DAÑO/MIN', format: decimal1 },
    ];

    const renderStatRow = (window: PerformanceWindow, windowLabel: string) => {
      const container = performanceRoot.querySelector('[data-window-stats]');
      if (!container) return;
      container.replaceChildren(
        ...STAT_TILES.map(({ key, label, format }, index) => {
          const tile = el('div', 'stat-tile');
          // WR y KDA lideran la lectura (Rediseño V3 §6): tratamiento
          // tipográfico mayor. El resto (KP/CS/Oro/Daño por min) son el
          // contexto, no seis cifras del mismo peso.
          tile.classList.toggle('stat-tile--lead', index < 2);
          const value = el('strong');
          value.textContent = format(window[key] as number | undefined);
          const caption = el('span');
          caption.textContent = label;
          tile.append(value, caption);
          return tile;
        }),
      );
      text(
        performanceRoot,
        '[data-window-meta]',
        window.sampleSize
          ? `${windowLabel} · ${window.sampleSize} partidas · ${window.wins}V ${window.losses}D · ${durationLabel(window.averageDurationSeconds)} de media`
          : 'Sin partidas en la muestra',
      );
    };

    /** 5/10/20/muestra completa en una sola fila compacta — nunca tres dashboards (encargo §18). */
    interface ComparePoint {
      label: string;
      winRate?: number;
      averageKda?: number;
      averageDamagePerMinute?: number;
    }

    const renderWindowCompare = (trend: TrendPoint[], full: PerformanceWindow) => {
      const container = performanceRoot.querySelector('[data-window-compare]');
      if (!container) return;
      const points: ComparePoint[] = [
        ...trend.map((point) => ({
          label: `Últimas ${point.windowSize}`,
          winRate: point.winRate,
          averageKda: point.averageKda,
          averageDamagePerMinute: point.averageDamagePerMinute,
        })),
        {
          label: `Muestra (${full.sampleSize})`,
          winRate: full.winRate,
          averageKda: full.averageKda,
          averageDamagePerMinute: full.averageDamagePerMinute,
        },
      ];
      container.replaceChildren(
        ...points.map((point) => {
          const item = el('div', 'window-compare-item');
          const label = el('span', 'window-compare-label');
          label.textContent = point.label;
          const wr = el('strong');
          wr.textContent = percent(point.winRate);
          const meta = el('span', 'window-compare-meta');
          meta.textContent = `${decimal(point.averageKda)} KDA · ${decimal1(point.averageDamagePerMinute)} DPM`;
          item.append(label, wr, meta);
          return item;
        }),
      );
    };

    // --- 03 · Champion Pool — el foco visual (Rediseño V3 §7). ---

    /**
     * Arte de carga del campeón (Data Dragon, misma CDN que los iconos que
     * ya se cargan — 0 llamadas Riot nuevas, no cuenta contra el rate
     * limit). Se deriva la clave del propio `championImageUrl`
     * (`.../champion/{Key}.png`), nunca del nombre visible, que para
     * algunos campeones difiere de la clave.
     */
    const championLoadingArt = (iconUrl?: string): string | undefined => {
      if (!iconUrl) return undefined;
      const key = iconUrl.split('/').pop()?.replace(/\.png$/i, '');
      return key
        ? `https://ddragon.leagueoflegends.com/cdn/img/champion/loading/${key}_0.jpg`
        : undefined;
    };

    const championCard = (
      champion: ChampionPerformance,
      variant: 'hero' | 'secondary',
      isFeature = false,
    ): HTMLLIElement => {
      const item = el('li', variant === 'hero' ? 'pool-card' : 'pool-secondary-item');
      // El campeón más jugado real (nunca hardcodeado) es la pieza visual
      // principal: arte de carga a sangre, no un icono de 84px.
      item.classList.toggle('pool-card--feature', isFeature);
      const art = isFeature ? championLoadingArt(champion.championImageUrl) : undefined;
      if (art) {
        const image = el('img', 'pool-card-splash');
        image.src = art;
        image.alt = '';
        image.setAttribute('aria-hidden', 'true');
        image.loading = 'lazy';
        image.decoding = 'async';
        item.append(image);
      } else if (champion.championImageUrl) {
        const image = el('img', 'pool-card-art');
        image.src = champion.championImageUrl;
        image.alt = champion.championName;
        const size = variant === 'hero' ? 56 : 32;
        image.width = size;
        image.height = size;
        image.loading = 'lazy';
        image.decoding = 'async';
        item.append(image);
      }
      const body = el('div', 'pool-card-body');
      const name = el('strong');
      name.textContent = champion.championName;
      body.append(name);
      if (variant !== 'hero') {
        const record = el('span', 'pool-card-record');
        record.textContent = `${champion.games} ${champion.games === 1 ? 'partida' : 'partidas'} · ${percent(champion.winRate)} WR`;
        body.append(record);
        item.append(body);
        return item;
      }

      const record = el('span', 'pool-card-record');
      record.textContent = `${champion.games} partidas · ${champion.wins}V ${champion.losses}D`;
      body.append(record);
      const stats = el('div', 'pool-card-stats');
      const stat = (value: string, label: string) => {
        const wrap = el('div');
        const strong = el('strong');
        strong.textContent = value;
        const span = el('span');
        span.textContent = label;
        wrap.append(strong, span);
        return wrap;
      };
      stats.append(
        stat(percent(champion.winRate), 'WR'),
        stat(decimal(champion.averageKda), 'KDA'),
        stat(decimal1(champion.averageDamagePerMinute), 'DPM'),
        stat(decimal1(champion.averageCsPerMinute), 'CSM'),
      );
      if (isFeature) {
        // Feature: las stats van dentro del cuerpo, sobre el escrim del arte.
        body.append(stats);
        item.append(body);
      } else {
        // Fila compacta: [icono] [nombre + record] [stats] como columnas del grid.
        item.append(body, stats);
      }
      return item;
    };

    const renderChampionPool = (champions: ChampionPerformance[], sampleSize: number) => {
      const { adcChampions, offRoleChampions } = splitChampionsByAdcRoster(champions, adcRosterNames);
      const hasAny = champions.length > 0;
      poolRoot.hidden = !hasAny;
      if (!hasAny) return;

      text(poolRoot, '[data-pool-sample]', `${sampleSize} ${sampleSize === 1 ? 'partida analizada' : 'partidas analizadas'}`);

      const { primary, secondary } = tierChampionsBySampleSize(adcChampions);

      const hero = poolRoot.querySelector('[data-pool-hero]');
      if (hero) {
        if (primary.length) {
          hero.replaceChildren(
            ...primary.map((champion, index) => championCard(champion, 'hero', index === 0)),
          );
        } else {
          const empty = el('li', 'performance-bars-empty');
          empty.textContent = 'Ningún ADC con 3 o más partidas todavía en esta muestra.';
          hero.replaceChildren(empty);
        }
      }

      const totalGames = champions.reduce((sum, c) => sum + c.games, 0) || 1;
      const distribution = poolRoot.querySelector('[data-pool-distribution]');
      if (distribution) {
        distribution.replaceChildren(
          ...champions.slice(0, 8).map((champion) => {
            const segment = el('span', 'pool-distribution-segment');
            segment.style.width = `${Math.round((champion.games / totalGames) * 100)}%`;
            segment.title = `${champion.championName}: ${champion.games} partidas`;
            return segment;
          }),
        );
      }
      const top = champions[0];
      text(
        poolRoot,
        '[data-pool-distribution-note]',
        top ? `${top.championName} es el más jugado: ${Math.round((top.games / totalGames) * 100)}% de la muestra` : '',
      );

      const dpmBlock = poolRoot.querySelector<HTMLElement>('[data-pool-dpm-block]');
      const dpmList = poolRoot.querySelector('[data-pool-dpm]');
      const dpmChampions = topChampionsByDamagePerMinute(primary);
      if (dpmBlock) dpmBlock.hidden = dpmChampions.length === 0;
      if (dpmList && dpmChampions.length) {
        const maxDpm = Math.max(...dpmChampions.map((c) => c.averageDamagePerMinute ?? 0));
        dpmList.replaceChildren(
          ...dpmChampions.map((champion) => {
            const item = el('li');
            const label = el('span', 'dpm-label');
            if (champion.championImageUrl) {
              const icon = el('img', 'dpm-icon');
              icon.src = champion.championImageUrl;
              icon.alt = '';
              icon.width = 18;
              icon.height = 18;
              icon.loading = 'lazy';
              icon.decoding = 'async';
              label.append(icon);
            }
            const name = document.createElement('span');
            name.textContent = champion.championName;
            label.append(name);
            const track = el('span', 'dpm-track');
            const bar = el('i');
            bar.style.width = `${maxDpm ? Math.round(((champion.averageDamagePerMinute ?? 0) / maxDpm) * 100) : 0}%`;
            track.append(bar);
            const value = el('strong');
            value.textContent = decimal1(champion.averageDamagePerMinute);
            item.append(label, track, value);
            return item;
          }),
        );
      }

      const secondaryBlock = poolRoot.querySelector<HTMLElement>('[data-pool-secondary-block]');
      const secondaryList = poolRoot.querySelector('[data-pool-secondary]');
      if (secondaryBlock) secondaryBlock.hidden = secondary.length === 0;
      if (secondaryList) secondaryList.replaceChildren(...secondary.map((c) => championCard(c, 'secondary')));

      const offRoleBlock = poolRoot.querySelector<HTMLElement>('[data-pool-off-role-block]');
      const offRoleList = poolRoot.querySelector('[data-pool-off-role]');
      if (offRoleBlock) offRoleBlock.hidden = offRoleChampions.length === 0;
      if (offRoleList) offRoleList.replaceChildren(...offRoleChampions.map((c) => championCard(c, 'secondary')));
    };

    // --- 04 · Patrones — resultados, nunca causalidad. ---

    const renderBar = (
      container: Element | null,
      items: Array<{ label: string; games: number; percentage?: number; winRate?: number }>,
      emptyCopy: string,
    ) => {
      if (!container) return;
      if (!items.length) {
        const item = el('li', 'performance-bars-empty');
        item.textContent = emptyCopy;
        container.replaceChildren(item);
        return;
      }
      container.replaceChildren(
        ...items.map((entry) => {
          const item = el('li');
          const label = el('span');
          label.textContent = entry.label;
          const bar = el('i');
          bar.style.width = `${entry.percentage ?? Math.min(100, entry.games * 10)}%`;
          const value = el('strong');
          value.textContent = entry.winRate === undefined ? `${entry.games}` : `${entry.games} · ${entry.winRate}% WR`;
          item.append(label, bar, value);
          return item;
        }),
      );
    };

    const renderRelations = (
      selector: string,
      entries: Array<{ label: string; games: number; winRate?: number; imageUrl?: string }>,
    ) => {
      const list = patternsRoot.querySelector(selector);
      if (!list) return;
      if (!entries.length) {
        const item = el('li', 'performance-bars-empty');
        item.textContent = 'Todavía sin muestra suficiente (mínimo 3 partidas juntas).';
        list.replaceChildren(item);
        return;
      }
      list.replaceChildren(
        ...entries.map((entry) => {
          const item = el('li');
          if (entry.imageUrl) {
            const image = el('img');
            image.src = entry.imageUrl;
            image.alt = '';
            image.width = 24;
            image.height = 24;
            image.loading = 'lazy';
            image.decoding = 'async';
            item.append(image);
          }
          const name = el('span');
          name.textContent = entry.label;
          const value = el('strong');
          value.textContent = `${entry.games} · ${entry.winRate ?? 0}% WR`;
          item.append(name, value);
          return item;
        }),
      );
    };

    const renderPatterns = (performance: ProfilePerformance) => {
      const hasAny =
        performance.supportSynergy.length > 0 ||
        performance.adcMatchups.length > 0 ||
        performance.sideSplit.length > 0 ||
        performance.duration.buckets.length > 0 ||
        performance.activityByWeekday.length > 0;
      patternsRoot.hidden = !hasAny;
      if (!hasAny) return;

      text(patternsRoot, '[data-performance-synergy-note]', 'Resultados con 3+ partidas juntas — no implica causalidad.');
      renderRelations(
        '[data-performance-synergy]',
        performance.supportSynergy.map((entry: SupportSynergyEntry) => ({ label: entry.supportName, games: entry.games, winRate: entry.winRate })),
      );
      text(patternsRoot, '[data-performance-matchups-note]', 'Historial de resultados, no teoría de matchup.');
      renderRelations(
        '[data-performance-matchups]',
        performance.adcMatchups.map((entry: AdcMatchupEntry) => ({ label: `vs ${entry.enemyChampionName}`, games: entry.games, winRate: entry.winRate, imageUrl: entry.enemyChampionImageUrl })),
      );
      renderBar(
        patternsRoot.querySelector('[data-performance-side]'),
        performance.sideSplit.map((entry: SideSplitEntry) => ({ label: entry.side === 'blue' ? 'Azul' : 'Rojo', games: entry.games, percentage: Math.min(100, entry.games * 12), winRate: entry.winRate })),
        'Sin muestra suficiente.',
      );
      renderBar(
        patternsRoot.querySelector('[data-performance-duration]'),
        performance.duration.buckets.map((bucket: DurationBucketEntry) => ({ label: bucket.label, games: bucket.games, percentage: Math.min(100, bucket.games * 12), winRate: bucket.winRate })),
        'Sin partidas suficientes para desglosar por duración.',
      );
      text(
        patternsRoot,
        '[data-performance-duration-summary]',
        performance.duration.averageSeconds === undefined
          ? 'Sin muestra suficiente.'
          : `Media: ${durationLabel(performance.duration.averageSeconds)} · Victorias: ${durationLabel(performance.duration.averageWinSeconds)} · Derrotas: ${durationLabel(performance.duration.averageLossSeconds)}`,
      );
      renderBar(
        patternsRoot.querySelector('[data-performance-weekday]'),
        performance.activityByWeekday.map((entry: ActivityBucket) => ({ label: entry.label, games: entry.games, percentage: Math.min(100, entry.games * 12), winRate: entry.winRate })),
        'Sin actividad registrada.',
      );
      renderBar(
        patternsRoot.querySelector('[data-performance-hourband]'),
        performance.activityByHourBand.map((entry: ActivityBucket) => ({ label: entry.label, games: entry.games, percentage: Math.min(100, entry.games * 12), winRate: entry.winRate })),
        'Sin actividad registrada.',
      );
    };

    const render = (performance: ProfilePerformance) => {
      const hasSample = performance.sampleSize > 0;
      performanceRoot.querySelector<HTMLElement>('[data-performance-loading]')!.hidden = true;
      performanceRoot.querySelector<HTMLElement>('[data-performance-body]')!.hidden = !hasSample;
      performanceRoot.querySelector<HTMLElement>('[data-performance-empty]')!.hidden = hasSample;
      performanceRoot.querySelector<HTMLElement>('[data-performance-error]')!.hidden = true;
      text(
        performanceRoot,
        '[data-performance-sample]',
        `${performance.sampleSize} ${performance.sampleSize === 1 ? 'partida analizada' : 'partidas analizadas'}`,
      );
      poolRoot.hidden = !hasSample;
      patternsRoot.hidden = !hasSample;
      if (!hasSample) return;

      const recentLabel = performance.windowRecent.sampleSize < 20 ? 'Muestra disponible' : 'Últimas 20';
      renderStatRow(performance.windowRecent, recentLabel);
      renderWindowCompare(performance.trend, performance.windowFull);
      renderChampionPool(performance.champions, performance.sampleSize);
      renderPatterns(performance);
    };

    const load = async () => {
      try {
        const response = await fetch(performanceRoot.dataset.riot!);
        const payload = (await response.json()) as RiotPublicResponse;
        if (!payload.ok) throw new Error(payload.error.code);
        render(payload.data.performance);
      } catch {
        performanceRoot.querySelector<HTMLElement>('[data-performance-loading]')!.hidden = true;
        performanceRoot.querySelector<HTMLElement>('[data-performance-body]')!.hidden = true;
        performanceRoot.querySelector<HTMLElement>('[data-performance-empty]')!.hidden = false;
        performanceRoot.querySelector<HTMLElement>('[data-performance-error]')!.hidden = false;
        poolRoot.hidden = true;
        patternsRoot.hidden = true;
      }
    };

    void load();
    window.setInterval(load, 120_000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void load();
    });

    // Solo en `astro dev` (eliminado del bundle de producción): fuerza el
    // render con datos sintéticos para QA visual sin tocar la red real —
    // mismo patrón que `LiveGameModule.astro`.
    if (import.meta.env.DEV) {
      (window as unknown as { __performanceProfileDebugRender?: typeof render }).__performanceProfileDebugRender = render;
    }
  }
</script>
