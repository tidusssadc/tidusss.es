---
import { integrationEndpoints } from '../../config/platforms';
import { buildLabRegistry, getAdcRoster } from '../../domain/league-laboratory';
import {
  adcLabChampions,
  championCatalog,
  leagueLaboratoryPatches,
  officialAdcTierList,
} from '../../data/league-laboratory';

/**
 * El roster ADC oficial de Tidusss (el mismo de la Tier List) se resuelve
 * aquí, en build time, y se pasa al cliente como una lista de nombres.
 */
const registry = buildLabRegistry({
  catalog: championCatalog,
  champions: adcLabChampions,
  patches: leagueLaboratoryPatches,
  tierLists: [officialAdcTierList],
});
const adcRosterNames = getAdcRoster(registry).map((entry) => entry.catalogEntry.dataDragonKey);
---

<!--
  V4: "Forma por campeón" (5) + "Rendimiento reciente" (7) en un grid
  asimétrico, no dos secciones apiladas. La antigua sección "04 · Patrones"
  se disuelve: support / ADC rival / lado / duración pasan a ser un bloque
  "Contexto" COMPACTO dentro de Rendimiento (contexto de las últimas N, no un
  slab propio). La actividad por día/franja se retira de la vista principal
  (dato de "documentación", poco valor para consultar cada día).

  Un solo fetch a `/api/riot/overview` — mismo dataset ya cacheado, 0
  llamadas Riot nuevas.
-->
<div class="control-grid control-grid--mid" data-performance-profile data-riot={integrationEndpoints.riot} data-adc-roster={JSON.stringify(adcRosterNames)}>
  <section
    class="live-module champion-form"
    aria-labelledby="champion-form-title"
    data-champion-pool
    hidden
  >
    <header class="live-module-head">
      <div>
        <span>Forma por campeón</span>
        <h2 id="champion-form-title">Con qué está jugando</h2>
      </div>
      <small data-pool-sample></small>
    </header>

    <ol class="pool-hero" data-pool-hero></ol>

    <div class="profile-subhead">
      <h3>Reparto</h3>
      <small data-pool-distribution-note></small>
    </div>
    <div class="pool-distribution" data-pool-distribution></div>

    <div data-pool-dpm-block hidden>
      <div class="profile-subhead">
        <h3>Daño por minuto</h3>
        <small>Solo campeones con 3+ partidas</small>
      </div>
      <ul class="dpm-chart" data-pool-dpm></ul>
    </div>

    <div data-pool-secondary-block hidden>
      <div class="profile-subhead">
        <h3>Muestra pequeña</h3>
        <small>1-2 partidas — todavía no representativo</small>
      </div>
      <ul class="pool-secondary" data-pool-secondary></ul>
    </div>

    <div data-pool-off-role-block hidden>
      <div class="profile-subhead">
        <h3>Fuera del rol ADC</h3>
        <small>Partidas reales fuera del roster ADC</small>
      </div>
      <ul class="pool-secondary" data-pool-off-role></ul>
    </div>
  </section>

  <section
    class="live-module recent-performance"
    aria-labelledby="recent-performance-title"
    data-performance-block
  >
    <header class="live-module-head">
      <div>
        <span>Rendimiento reciente</span>
        <h2 id="recent-performance-title">¿Voy mejor o peor?</h2>
      </div>
      <small data-performance-sample>Actividad reciente</small>
    </header>

    <div
      class="live-loading live-loading--row performance-loading"
      data-performance-loading
      aria-label="Actualizando rendimiento"
    >
      <i></i><i></i><i></i>
    </div>

    <div data-performance-body hidden>
      <ul class="trend-grid" data-trend-grid></ul>
      <p class="stat-row-meta" data-window-meta></p>

      <div class="perf-context" data-perf-context hidden>
        <div class="profile-subhead">
          <h3>Contexto de las últimas partidas</h3>
          <small>Resultados con 3+ partidas — no implica causalidad.</small>
        </div>
        <div class="perf-context-grid">
          <div class="perf-context-cell">
            <h4>Con support</h4>
            <ul class="perf-context-list" data-context-synergy></ul>
          </div>
          <div class="perf-context-cell">
            <h4>Vs. ADC rival</h4>
            <ul class="perf-context-list" data-context-matchups></ul>
          </div>
          <div class="perf-context-cell">
            <h4>Lado del mapa</h4>
            <ul class="perf-context-list" data-context-side></ul>
          </div>
          <div class="perf-context-cell">
            <h4>Duración</h4>
            <p class="perf-context-duration" data-context-duration></p>
          </div>
        </div>
      </div>
    </div>

    <div class="compact-empty" data-performance-empty hidden>
      <strong>La muestra reciente todavía no contiene partidas de Solo/Duo.</strong>
      <span>Este bloque se completará en cuanto Riot devuelva actividad clasificatoria.</span>
    </div>

    <div class="compact-empty" data-performance-error hidden>
      <strong>Riot no responde ahora mismo.</strong>
      <span>El resto del Control Room sigue funcionando — se actualiza solo.</span>
    </div>
  </section>
</div>

<script>
  import { installCompetitiveQaIfRequested } from '../../lib/dev/competitive-qa';
  import type { RiotPublicResponse } from '../../lib/riot';
  import {
    splitChampionsByAdcRoster,
    tierChampionsBySampleSize,
    topChampionsByDamagePerMinute,
  } from '../../lib/riot';
  import type {
    AdcMatchupEntry,
    ChampionPerformance,
    ProfilePerformance,
    SideSplitEntry,
    SupportSynergyEntry,
    TrendPoint,
  } from '../../lib/riot';

  installCompetitiveQaIfRequested();

  const gridRoot = document.querySelector<HTMLElement>('[data-performance-profile]');
  const performanceRoot = document.querySelector<HTMLElement>('[data-performance-block]');
  const poolRoot = document.querySelector<HTMLElement>('[data-champion-pool]');

  if (gridRoot && performanceRoot && poolRoot) {
    let adcRosterNames: string[] = [];
    try {
      adcRosterNames = JSON.parse(gridRoot.dataset.adcRoster ?? '[]');
    } catch {
      adcRosterNames = [];
    }

    const decimal = (value?: number) =>
      value === undefined ? '—' : value.toFixed(2).replace('.', ',');
    const decimal1 = (value?: number) =>
      value === undefined ? '—' : String(value).replace('.', ',');
    const percent = (value?: number) => (value === undefined ? '—' : `${value}%`);
    const durationLabel = (seconds?: number) =>
      seconds === undefined ? '—' : `${Math.round(seconds / 60)} min`;
    const text = (root: HTMLElement, selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };
    const el = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
    ): HTMLElementTagNameMap[K] => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      return node;
    };

    // --- Rendimiento reciente como GRÁFICO DE PENDIENTE (encargo Signature
    // §9): para cada métrica, la muestra completa y las ventanas de 20/10/5
    // se leen como puntos de una misma línea — "TODAS" es la base, "5" es lo
    // más reciente. La pregunta que responde es "¿la ventana más reciente
    // está por encima o por debajo de la base?", con los valores reales
    // etiquetados en cada punto — nunca una puntuación inventada. Con menos
    // de 2 puntos disponibles no se dibuja línea (degradación honesta). ---

    interface TrendMetric {
      key: 'winRate' | 'averageKda' | 'averageCsPerMinute' | 'averageDamagePerMinute';
      label: string;
      format: (value?: number) => string;
      deltaFormat: (delta: number) => string;
    }
    const TREND_METRICS: TrendMetric[] = [
      { key: 'winRate', label: 'Win rate', format: percent, deltaFormat: (d) => `${Math.round(d)}%` },
      { key: 'averageKda', label: 'KDA', format: decimal, deltaFormat: (d) => d.toFixed(2).replace('.', ',') },
      { key: 'averageCsPerMinute', label: 'CS/min', format: decimal1, deltaFormat: (d) => d.toFixed(1).replace('.', ',') },
      {
        key: 'averageDamagePerMinute',
        label: 'Daño/min',
        format: (v) => (v === undefined ? '—' : String(Math.round(v))),
        deltaFormat: (d) => String(Math.round(d)),
      },
    ];

    // Geometría del gráfico — fija, en px, para que línea/puntos/etiquetas
    // compartan el mismo sistema de coordenadas sin medir el DOM real.
    const SLOPE_HEIGHT = 62;
    const DOT_Y_TOP = 22;
    const DOT_Y_BOTTOM = 40;
    const CAPTION_Y = 48;

    const slopeChart = (
      metric: TrendMetric,
      points: { x: number; value: number; windowLabel: string; sampleLabel: string }[],
    ): HTMLElement => {
      const wrap = el('div', 'trend-slope');
      if (points.length < 2) {
        const note = el('span', 'trend-item-note');
        note.textContent = 'Sin ventanas de tendencia todavía (hacen falta 5+ partidas).';
        wrap.append(note);
        return wrap;
      }
      const values = points.map((p) => p.value);
      const min = Math.min(...values);
      const max = Math.max(...values);
      const yFor = (value: number) =>
        max === min ? (DOT_Y_TOP + DOT_Y_BOTTOM) / 2 : DOT_Y_BOTTOM - ((value - min) / (max - min)) * (DOT_Y_BOTTOM - DOT_Y_TOP);

      const svgNs = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(svgNs, 'svg');
      svg.setAttribute('viewBox', `0 0 100 ${SLOPE_HEIGHT}`);
      svg.setAttribute('preserveAspectRatio', 'none');
      svg.setAttribute('class', 'trend-slope-line');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(svgNs, 'path');
      const d = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(2)} ${yFor(p.value).toFixed(2)}`).join(' ');
      path.setAttribute('d', d);
      const delta = values[values.length - 1]! - values[0]!;
      const threshold = metric.key === 'winRate' ? 1.5 : 0.05;
      const rising = delta > threshold;
      const falling = delta < -threshold;
      path.setAttribute('class', `trend-slope-line-path${rising ? ' is-up' : falling ? ' is-down' : ''}`);
      svg.append(path);
      wrap.append(svg);

      points.forEach((point, index) => {
        const isCurrent = index === points.length - 1;
        const y = yFor(point.value);
        const anchor = el('div', 'trend-slope-point');
        anchor.classList.toggle('is-current', isCurrent);
        anchor.classList.toggle('is-base', index === 0);
        anchor.style.left = `${point.x}%`;

        const value = el('span', 'trend-slope-value');
        value.style.top = `${Math.max(0, y - 16)}px`;
        value.textContent = metric.format(point.value);

        const dot = el('span', 'trend-slope-dot');
        dot.style.top = `${y}px`;

        const caption = el('span', 'trend-slope-caption');
        caption.style.top = `${CAPTION_Y}px`;
        caption.textContent = point.windowLabel;

        anchor.append(value, dot, caption);
        wrap.append(anchor);
      });

      return wrap;
    };

    const renderTrend = (
      trend: TrendPoint[],
      full: { winRate?: number; averageKda?: number; averageCsPerMinute?: number; averageDamagePerMinute?: number; sampleSize: number },
    ) => {
      const container = performanceRoot.querySelector('[data-trend-grid]');
      if (!container) return;
      // De más amplio (toda la muestra) a más reciente (ventana de 5).
      const windows = [...trend].sort((a, b) => b.windowSize - a.windowSize);
      container.replaceChildren(
        ...TREND_METRICS.map((metric) => {
          const raw: { value?: number; windowLabel: string; sampleLabel: string }[] = [
            { value: full[metric.key], windowLabel: 'TODAS', sampleLabel: String(full.sampleSize) },
            ...windows.map((w) => ({ value: w[metric.key], windowLabel: String(w.windowSize), sampleLabel: String(w.sampleSize) })),
          ];
          const present = raw.filter(
            (p): p is { value: number; windowLabel: string; sampleLabel: string } => p.value !== undefined,
          );
          const points = present.map((p, index) => ({
            ...p,
            // Margen del 8% a cada lado: el valor del punto (más grande en
            // el punto actual) se centra en su x y no debe invadir la
            // columna del delta ni el borde del carril.
            x: present.length > 1 ? 8 + (index / (present.length - 1)) * 84 : 50,
          }));

          const item = el('li', 'trend-item');
          const head = el('div', 'trend-item-head');
          const value = el('strong');
          value.textContent = metric.format(points[points.length - 1]?.value ?? full[metric.key]);
          const label = el('span', 'trend-item-label');
          label.textContent = metric.label;
          head.append(value, label);
          item.append(head, slopeChart(metric, points));

          if (points.length >= 2) {
            const delta = points[points.length - 1]!.value - points[0]!.value;
            const threshold = metric.key === 'winRate' ? 1.5 : 0.05;
            const rising = delta > threshold;
            const falling = delta < -threshold;
            const badge = el('span', 'trend-item-delta');
            const sign = delta > 0 ? '+' : delta < 0 ? '-' : '±';
            badge.textContent = falling
              ? `${sign}${metric.deltaFormat(Math.abs(delta))} vs. TODAS`
              : rising
                ? `${sign}${metric.deltaFormat(Math.abs(delta))} vs. TODAS`
                : '≈ estable vs. TODAS';
            badge.classList.toggle('is-up', rising);
            badge.classList.toggle('is-down', falling);
            item.append(badge);
          }
          return item;
        }),
      );
    };

    // --- Forma por campeón (antes "Champion Pool") ---
    const championLoadingArt = (iconUrl?: string): string | undefined => {
      if (!iconUrl) return undefined;
      const key = iconUrl.split('/').pop()?.replace(/\.png$/i, '');
      return key
        ? `https://ddragon.leagueoflegends.com/cdn/img/champion/loading/${key}_0.jpg`
        : undefined;
    };

    const championCard = (
      champion: ChampionPerformance,
      variant: 'hero' | 'secondary',
      isFeature = false,
    ): HTMLLIElement => {
      const item = el('li', variant === 'hero' ? 'pool-card' : 'pool-secondary-item');
      item.classList.toggle('pool-card--feature', isFeature);
      const art = isFeature ? championLoadingArt(champion.championImageUrl) : undefined;
      if (art) {
        const image = el('img', 'pool-card-splash');
        image.src = art;
        image.alt = '';
        image.setAttribute('aria-hidden', 'true');
        image.loading = 'lazy';
        image.decoding = 'async';
        item.append(image);
      } else if (champion.championImageUrl) {
        const image = el('img', 'pool-card-art');
        image.src = champion.championImageUrl;
        image.alt = champion.championName;
        const size = variant === 'hero' ? 56 : 32;
        image.width = size;
        image.height = size;
        image.loading = 'lazy';
        image.decoding = 'async';
        item.append(image);
      }
      const body = el('div', 'pool-card-body');
      const name = el('strong');
      name.textContent = champion.championName;
      body.append(name);
      if (variant !== 'hero') {
        const record = el('span', 'pool-card-record');
        record.textContent = `${champion.games} ${champion.games === 1 ? 'partida' : 'partidas'} · ${percent(champion.winRate)} WR`;
        body.append(record);
        item.append(body);
        return item;
      }

      const record = el('span', 'pool-card-record');
      record.textContent = `${champion.games} partidas · ${champion.wins}V ${champion.losses}D`;
      body.append(record);
      const stats = el('div', 'pool-card-stats');
      const stat = (value: string, label: string) => {
        const wrap = el('div');
        const strong = el('strong');
        strong.textContent = value;
        const span = el('span');
        span.textContent = label;
        wrap.append(strong, span);
        return wrap;
      };
      stats.append(
        stat(percent(champion.winRate), 'WR'),
        stat(decimal(champion.averageKda), 'KDA'),
        stat(decimal1(champion.averageDamagePerMinute), 'DPM'),
        stat(decimal1(champion.averageCsPerMinute), 'CSM'),
      );
      if (isFeature) {
        body.append(stats);
        item.append(body);
      } else {
        item.append(body, stats);
      }
      return item;
    };

    const renderChampionPool = (champions: ChampionPerformance[], sampleSize: number) => {
      const { adcChampions, offRoleChampions } = splitChampionsByAdcRoster(champions, adcRosterNames);
      const hasAny = champions.length > 0;
      poolRoot.hidden = !hasAny;
      if (!hasAny) return;

      text(poolRoot, '[data-pool-sample]', `${sampleSize} ${sampleSize === 1 ? 'partida' : 'partidas'}`);

      const { primary, secondary } = tierChampionsBySampleSize(adcChampions);

      const hero = poolRoot.querySelector('[data-pool-hero]');
      if (hero) {
        if (primary.length) {
          hero.replaceChildren(
            ...primary.map((champion, index) => championCard(champion, 'hero', index === 0)),
          );
        } else {
          const empty = el('li', 'performance-bars-empty');
          empty.textContent = 'Ningún ADC con 3 o más partidas todavía en esta muestra.';
          hero.replaceChildren(empty);
        }
      }

      const totalGames = champions.reduce((sum, c) => sum + c.games, 0) || 1;
      const distribution = poolRoot.querySelector('[data-pool-distribution]');
      if (distribution) {
        distribution.replaceChildren(
          ...champions.slice(0, 8).map((champion) => {
            const segment = el('span', 'pool-distribution-segment');
            segment.style.width = `${Math.round((champion.games / totalGames) * 100)}%`;
            segment.title = `${champion.championName}: ${champion.games} partidas`;
            return segment;
          }),
        );
      }
      const top = champions[0];
      text(
        poolRoot,
        '[data-pool-distribution-note]',
        top ? `${top.championName}: ${Math.round((top.games / totalGames) * 100)}% de la muestra` : '',
      );

      const dpmBlock = poolRoot.querySelector<HTMLElement>('[data-pool-dpm-block]');
      const dpmList = poolRoot.querySelector('[data-pool-dpm]');
      const dpmChampions = topChampionsByDamagePerMinute(primary);
      if (dpmBlock) dpmBlock.hidden = dpmChampions.length === 0;
      if (dpmList && dpmChampions.length) {
        const maxDpm = Math.max(...dpmChampions.map((c) => c.averageDamagePerMinute ?? 0));
        dpmList.replaceChildren(
          ...dpmChampions.map((champion) => {
            const item = el('li');
            const label = el('span', 'dpm-label');
            if (champion.championImageUrl) {
              const icon = el('img', 'dpm-icon');
              icon.src = champion.championImageUrl;
              icon.alt = '';
              icon.width = 18;
              icon.height = 18;
              icon.loading = 'lazy';
              icon.decoding = 'async';
              label.append(icon);
            }
            const name = document.createElement('span');
            name.textContent = champion.championName;
            label.append(name);
            const track = el('span', 'dpm-track');
            const bar = el('i');
            bar.style.width = `${maxDpm ? Math.round(((champion.averageDamagePerMinute ?? 0) / maxDpm) * 100) : 0}%`;
            track.append(bar);
            const value = el('strong');
            value.textContent = decimal1(champion.averageDamagePerMinute);
            item.append(label, track, value);
            return item;
          }),
        );
      }

      const secondaryBlock = poolRoot.querySelector<HTMLElement>('[data-pool-secondary-block]');
      const secondaryList = poolRoot.querySelector('[data-pool-secondary]');
      if (secondaryBlock) secondaryBlock.hidden = secondary.length === 0;
      if (secondaryList) secondaryList.replaceChildren(...secondary.map((c) => championCard(c, 'secondary')));

      const offRoleBlock = poolRoot.querySelector<HTMLElement>('[data-pool-off-role-block]');
      const offRoleList = poolRoot.querySelector('[data-pool-off-role]');
      if (offRoleBlock) offRoleBlock.hidden = offRoleChampions.length === 0;
      if (offRoleList) offRoleList.replaceChildren(...offRoleChampions.map((c) => championCard(c, 'secondary')));
    };

    // --- Contexto (antes "04 · Patrones"), compacto, dentro de Rendimiento ---
    const contextRow = (label: string, value: string, imageUrl?: string) => {
      const item = el('li');
      if (imageUrl) {
        const image = el('img');
        image.src = imageUrl;
        image.alt = '';
        image.width = 20;
        image.height = 20;
        image.loading = 'lazy';
        image.decoding = 'async';
        item.append(image);
      }
      const name = el('span');
      name.textContent = label;
      const strong = el('strong');
      strong.textContent = value;
      item.append(name, strong);
      return item;
    };
    const emptyRow = (copy: string) => {
      const item = el('li', 'performance-bars-empty');
      item.textContent = copy;
      return item;
    };

    const renderContext = (performance: ProfilePerformance) => {
      const context = performanceRoot.querySelector<HTMLElement>('[data-perf-context]');
      if (!context) return;
      const hasAny =
        performance.supportSynergy.length > 0 ||
        performance.adcMatchups.length > 0 ||
        performance.sideSplit.length > 0 ||
        performance.duration.buckets.length > 0;
      context.hidden = !hasAny;
      if (!hasAny) return;

      const synergy = context.querySelector('[data-context-synergy]');
      if (synergy)
        synergy.replaceChildren(
          ...(performance.supportSynergy.length
            ? performance.supportSynergy
                .slice(0, 3)
                .map((entry: SupportSynergyEntry) =>
                  contextRow(entry.supportName, `${entry.games} · ${entry.winRate ?? 0}% WR`),
                )
            : [emptyRow('Sin 3+ partidas con un mismo support.')]),
        );

      const matchups = context.querySelector('[data-context-matchups]');
      if (matchups)
        matchups.replaceChildren(
          ...(performance.adcMatchups.length
            ? performance.adcMatchups
                .slice(0, 3)
                .map((entry: AdcMatchupEntry) =>
                  contextRow(
                    `vs ${entry.enemyChampionName}`,
                    `${entry.games} · ${entry.winRate ?? 0}% WR`,
                    entry.enemyChampionImageUrl,
                  ),
                )
            : [emptyRow('Sin 3+ partidas contra un mismo ADC.')]),
        );

      const side = context.querySelector('[data-context-side]');
      if (side)
        side.replaceChildren(
          ...(performance.sideSplit.length
            ? performance.sideSplit.map((entry: SideSplitEntry) =>
                contextRow(
                  entry.side === 'blue' ? 'Azul' : 'Rojo',
                  `${entry.games} · ${entry.winRate ?? 0}% WR`,
                ),
              )
            : [emptyRow('Sin muestra.')]),
        );

      text(
        performanceRoot,
        '[data-context-duration]',
        performance.duration.averageSeconds === undefined
          ? 'Sin muestra suficiente.'
          : `Media ${durationLabel(performance.duration.averageSeconds)} · Victorias ${durationLabel(performance.duration.averageWinSeconds)} · Derrotas ${durationLabel(performance.duration.averageLossSeconds)}`,
      );
    };

    const render = (performance: ProfilePerformance) => {
      const hasSample = performance.sampleSize > 0;
      performanceRoot.querySelector<HTMLElement>('[data-performance-loading]')!.hidden = true;
      performanceRoot.querySelector<HTMLElement>('[data-performance-body]')!.hidden = !hasSample;
      performanceRoot.querySelector<HTMLElement>('[data-performance-empty]')!.hidden = hasSample;
      performanceRoot.querySelector<HTMLElement>('[data-performance-error]')!.hidden = true;
      text(
        performanceRoot,
        '[data-performance-sample]',
        `${performance.sampleSize} ${performance.sampleSize === 1 ? 'partida' : 'partidas'}`,
      );
      poolRoot.hidden = !hasSample;
      if (!hasSample) return;

      renderTrend(performance.trend, {
        winRate: performance.windowFull.winRate,
        averageKda: performance.windowFull.averageKda,
        averageCsPerMinute: performance.windowFull.averageCsPerMinute,
        averageDamagePerMinute: performance.windowFull.averageDamagePerMinute,
        sampleSize: performance.windowFull.sampleSize,
      });
      text(
        performanceRoot,
        '[data-window-meta]',
        `${performance.windowRecent.sampleSize} recientes · ${performance.windowRecent.wins}V ${performance.windowRecent.losses}D · ${durationLabel(performance.windowRecent.averageDurationSeconds)} de media`,
      );
      renderContext(performance);
      renderChampionPool(performance.champions, performance.sampleSize);
    };

    const load = async () => {
      try {
        const response = await fetch(gridRoot.dataset.riot!);
        const payload = (await response.json()) as RiotPublicResponse;
        if (!payload.ok) throw new Error(payload.error.code);
        render(payload.data.performance);
      } catch {
        performanceRoot.querySelector<HTMLElement>('[data-performance-loading]')!.hidden = true;
        performanceRoot.querySelector<HTMLElement>('[data-performance-body]')!.hidden = true;
        performanceRoot.querySelector<HTMLElement>('[data-performance-empty]')!.hidden = false;
        performanceRoot.querySelector<HTMLElement>('[data-performance-error]')!.hidden = false;
        poolRoot.hidden = true;
      }
    };

    void load();
    window.setInterval(load, 120_000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void load();
    });

    if (import.meta.env.DEV) {
      (window as unknown as { __performanceProfileDebugRender?: typeof render }).__performanceProfileDebugRender = render;
    }
  }
</script>
