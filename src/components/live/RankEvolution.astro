---
import { integrationEndpoints } from '../../config/platforms';
import { RANK_CHART_WIDTH, RANK_CHART_HEIGHT } from '../../lib/rank-history/render';
---

<!--
  Evolución de rango observada — V4: promovida de "columna estrecha dentro de
  01 Ahora" a MÓDULO propio junto a "Sesión de hoy" (encargo §6: elemento de
  deseo, no el sparkline menos prominente de la página). Ahora que D1 está
  aprovisionada, esto crece en importancia.

  Fetch propio a `/api/riot/rank-history` (mismo patrón que el resto de
  bloques: cada uno pide lo suyo). Sin binding D1 el endpoint responde
  `available:false` y este módulo entero se auto-oculta (`hidden`, nunca un
  error) — `.control-grid--top:has([data-rank-evolution][hidden])` colapsa a
  una sola columna y "Sesión de hoy" ocupa el ancho.

  El eje Y dibuja `rankOrdinal` (tier→división→LP aplanado, ver
  `src/lib/rank-history/rank-order.ts`), NUNCA el LP crudo. Ese número nunca
  se imprime; el texto que ve el usuario sale siempre de tier/rank/LP reales.
-->
<section
  class="live-module evo-module"
  data-rank-evolution
  data-riot-rank-history={integrationEndpoints.riotRankHistory}
  aria-labelledby="evo-title"
  hidden
>
  <header class="live-module-head">
    <div>
      <span>Evolución LP</span>
      <h2 id="evo-title" data-evo-heading>Evolución de rango</h2>
    </div>
    <small data-rank-evolution-since></small>
  </header>

  <div class="rank-evolution-empty" data-rank-evolution-empty hidden>
    <strong>Seguimiento de rango activado.</strong>
    <span>Todavía no hay historial suficiente — el gráfico aparece en cuanto haya más de una observación real.</span>
  </div>

  <div class="rank-evolution-body" data-rank-evolution-body hidden>
    <div class="rank-evolution-figures">
      <div>
        <strong data-rank-evolution-current></strong>
        <span data-rank-evolution-lp></span>
      </div>
      <div class="rank-evolution-peak" data-rank-evolution-peak hidden>
        <span>Pico observado</span>
        <strong data-rank-evolution-peak-value></strong>
      </div>
    </div>

    <div class="rank-evolution-chart-wrap" data-rank-evolution-chart hidden>
      <svg
        class="rank-evolution-chart"
        viewBox={`0 0 ${RANK_CHART_WIDTH} ${RANK_CHART_HEIGHT}`}
        preserveAspectRatio="none"
        role="img"
        aria-label="Evolución de rango observada"
      >
        <defs>
          <linearGradient id="evo-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#d6b56b" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="#d6b56b" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path data-rank-evolution-area class="rank-evolution-area"></path>
        <line data-rank-evolution-session class="rank-evolution-session-line" y1="0" y2={RANK_CHART_HEIGHT}></line>
        <path data-rank-evolution-path class="rank-evolution-line"></path>
        <g data-rank-evolution-dots></g>
        <line data-rank-evolution-cursor class="rank-evolution-cursor" y1="0" y2={RANK_CHART_HEIGHT}></line>
      </svg>
      <span class="rank-evolution-session-label" data-rank-evolution-session-label hidden>HOY</span>
      <div class="rank-evolution-tooltip" data-rank-evolution-tooltip hidden>
        <strong data-rank-evolution-tooltip-rank></strong>
        <span data-rank-evolution-tooltip-date></span>
      </div>
    </div>

    <p class="rank-evolution-meta rank-evolution-transition" data-rank-evolution-transition hidden></p>
  </div>
</section>

<script>
  import { installCompetitiveQaIfRequested } from '../../lib/dev/competitive-qa';
  import { buildRankEvolutionView, RANK_CHART_HEIGHT, RANK_CHART_WIDTH } from '../../lib/rank-history/render';
  import { buildSparklinePath } from '../../lib/rank-history/chart';
  import { madridDate } from '../../lib/time';
  import { formatRankLabel } from '../../lib/rank-history/format';
  import type { RankChartPoint } from '../../lib/rank-history/chart';
  import type { RankHistoryPublicResponse } from '../../../functions/api/riot/rank-history';

  installCompetitiveQaIfRequested();

  const root = document.querySelector<HTMLElement>('[data-rank-evolution]');

  if (root) {
    const text = (selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };
    const visible = (selector: string, show: boolean) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.hidden = !show;
    };

    const drawDots = (points: RankChartPoint[], transitionIndices: number[]) => {
      const group = root.querySelector('[data-rank-evolution-dots]');
      if (!group) return;
      const peakIndex = points.reduce(
        (best, point, index) => (point.y < points[best]!.y ? index : best),
        0,
      );
      const currentIndex = points.length - 1;
      const transitionSet = new Set(transitionIndices);
      group.replaceChildren(
        ...points.map((point, index) => {
          const isPeak = index === peakIndex;
          const isCurrent = index === currentIndex;
          const isTransition = transitionSet.has(index);
          const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          dot.setAttribute('cx', point.x.toFixed(2));
          dot.setAttribute('cy', point.y.toFixed(2));
          dot.setAttribute('r', isCurrent ? '4' : isPeak || isTransition ? '3.4' : '2.2');
          const classes = ['rank-evolution-dot'];
          if (isPeak) classes.push('is-peak');
          if (isCurrent) classes.push('is-current');
          if (isTransition) classes.push('is-transition');
          dot.setAttribute('class', classes.join(' '));
          return dot;
        }),
      );
    };

    const wireTooltip = (points: RankChartPoint[]) => {
      const wrap = root.querySelector<HTMLElement>('[data-rank-evolution-chart]');
      const svg = wrap?.querySelector('svg');
      const cursor = root.querySelector<SVGLineElement>('[data-rank-evolution-cursor]');
      const tooltip = root.querySelector<HTMLElement>('[data-rank-evolution-tooltip]');
      if (!wrap || !svg || !cursor || !tooltip || points.length === 0) return;

      const show = (clientX: number) => {
        const rect = svg.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        const nearest = points.reduce((best, point) => {
          const target = ratio * points[points.length - 1]!.x;
          return Math.abs(point.x - target) < Math.abs(best.x - target) ? point : best;
        }, points[0]!);
        cursor.setAttribute('x1', String(nearest.x));
        cursor.setAttribute('x2', String(nearest.x));
        cursor.classList.add('is-on');
        tooltip.hidden = false;
        tooltip.style.left = `${(nearest.x / points[points.length - 1]!.x) * 100}%`;
        // Delta día a día (encargo §8): diferencia real contra la
        // observación anterior — nunca inventada si a cualquiera de las
        // dos le falta el LP.
        const nearestIndex = points.indexOf(nearest);
        const previous = nearestIndex > 0 ? points[nearestIndex - 1] : undefined;
        const delta =
          previous?.leaguePoints !== undefined && nearest.leaguePoints !== undefined
            ? nearest.leaguePoints - previous.leaguePoints
            : undefined;
        text(
          '[data-rank-evolution-tooltip-rank]',
          `${formatRankLabel(nearest.tier, nearest.rank)}${
            nearest.leaguePoints === undefined ? '' : ` · ${nearest.leaguePoints} LP`
          }${delta === undefined || delta === 0 ? '' : ` (${delta > 0 ? '+' : ''}${delta})`}`,
        );
        text(
          '[data-rank-evolution-tooltip-date]',
          madridDate(nearest.observedAt) ?? '',
        );
      };
      const hide = () => {
        cursor.classList.remove('is-on');
        tooltip.hidden = true;
      };

      wrap.addEventListener('pointermove', (event) => show(event.clientX));
      wrap.addEventListener('pointerleave', hide);
      wrap.addEventListener('pointerdown', (event) => show(event.clientX));
    };

    const render = (payload: RankHistoryPublicResponse) => {
      if (!payload.ok) {
        root.hidden = true;
        return;
      }
      const view = buildRankEvolutionView(payload.data);
      root.hidden = view.state === 'hidden';
      if (view.state === 'hidden') return;

      text('[data-rank-evolution-since]', view.sinceLabel ?? '');
      visible('[data-rank-evolution-empty]', view.state === 'empty');
      visible('[data-rank-evolution-body]', view.state !== 'empty');
      if (view.state === 'empty') return;

      text('[data-rank-evolution-current]', view.currentLabel ?? 'Sin clasificar');
      text('[data-rank-evolution-lp]', view.currentLpLabel ?? '');
      visible('[data-rank-evolution-lp]', Boolean(view.currentLpLabel));

      visible('[data-rank-evolution-peak]', Boolean(view.peakLabel));
      if (view.peakLabel)
        text(
          '[data-rank-evolution-peak-value]',
          view.peakLabel.replace(/^Peak observado:\s*/i, ''),
        );

      visible('[data-rank-evolution-chart]', view.state === 'chart');
      visible('[data-rank-evolution-transition]', Boolean(view.latestTransitionLabel));
      if (view.state === 'chart') {
        text('[data-rank-evolution-transition]', view.latestTransitionLabel ?? '');
        const line = root.querySelector('[data-rank-evolution-path]');
        const area = root.querySelector('[data-rank-evolution-area]');
        const linePath = buildSparklinePath(view.points);
        if (line) line.setAttribute('d', linePath);
        if (area && view.points.length) {
          const first = view.points[0]!;
          const last = view.points[view.points.length - 1]!;
          area.setAttribute(
            'd',
            `${linePath} L ${last.x.toFixed(2)} ${RANK_CHART_HEIGHT} L ${first.x.toFixed(2)} ${RANK_CHART_HEIGHT} Z`,
          );
        }
        drawDots(view.points, view.transitionIndices);
        wireTooltip(view.points);

        // Marcador de inicio de sesión (encargo §8): separa "antes de hoy"
        // de "hoy" en el propio gráfico — solo si hay puntos anteriores a
        // hoy que separar.
        const sessionLine = root.querySelector<SVGLineElement>('[data-rank-evolution-session]');
        const sessionLabel = root.querySelector<HTMLElement>('[data-rank-evolution-session-label]');
        const sessionPoint =
          view.sessionStartIndex === undefined ? undefined : view.points[view.sessionStartIndex];
        if (sessionLine) {
          sessionLine.classList.toggle('is-on', Boolean(sessionPoint));
          if (sessionPoint) {
            sessionLine.setAttribute('x1', String(sessionPoint.x));
            sessionLine.setAttribute('x2', String(sessionPoint.x));
          }
        }
        if (sessionLabel) {
          sessionLabel.hidden = !sessionPoint;
          if (sessionPoint) {
            sessionLabel.style.left = `${(sessionPoint.x / RANK_CHART_WIDTH) * 100}%`;
          }
        }
      }
    };

    const load = async () => {
      try {
        const response = await fetch(root.dataset.riotRankHistory!);
        const payload = (await response.json()) as RankHistoryPublicResponse;
        render(payload);
      } catch {
        root.hidden = true;
      }
    };

    void load();

    if (import.meta.env.DEV) {
      (window as unknown as { __rankEvolutionDebugRender?: typeof render }).__rankEvolutionDebugRender = render;
    }
  }
</script>
