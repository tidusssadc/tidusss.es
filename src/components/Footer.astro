---
import { platforms } from '../config/platforms';
import { site } from '../data/site';
const year = new Date().getFullYear();

const socialIcons = [
  { name: 'YouTube', href: platforms.youtube.url, icon: '/icons/youtube.svg' },
  { name: 'Twitch', href: platforms.twitch.url, icon: '/icons/twitch.svg' },
  {
    name: 'Instagram',
    href: platforms.instagram.url,
    icon: '/icons/instagram.svg',
  },
  { name: 'X (Twitter)', href: platforms.x.url, icon: '/icons/x.svg' },
  { name: 'Discord', href: platforms.discord.url, icon: '/icons/discord.svg' },
];
---

<footer class="border-t border-white/8 px-5 py-8 sm:px-8">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left"
  >
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <p class="text-sm font-black tracking-[0.2em] text-white">
        {site.name}
        <span class="font-normal tracking-normal text-slate-600">© {year}</span>
      </p>
      <div class="footer-social flex justify-center gap-3 sm:justify-start">
        {
          socialIcons.map(({ name, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer"
              aria-label={name}
              title={name}
            >
              <img
                src={icon}
                width="18"
                height="18"
                alt=""
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>
    </div>
    <p class="max-w-2xl text-xs leading-5 text-slate-600">
      League of Legends es una marca registrada de Riot Games. Este sitio no
      está afiliado ni respaldado por Riot Games.
    </p>
  </div>
</footer>
