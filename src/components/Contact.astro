---
import { platforms } from '../config/platforms';

const socialCards = [
  {
    key: 'youtube',
    name: 'YouTube',
    icon: '/icons/youtube.svg',
    href: platforms.youtube.url,
    tagline: 'Gameplays con contexto.',
    description:
      'Partidas comentadas de principio a fin: mecánicas, errores y decisiones explicadas para que la partida siga aportando después.',
    cta: 'Suscribirse',
  },
  {
    key: 'twitch',
    name: 'Twitch',
    icon: '/icons/twitch.svg',
    href: platforms.twitch.url,
    tagline: 'Directo sin cortes.',
    description:
      'SoloQ en tiempo real: reacción, tensión y decisiones compartidas con la comunidad mientras ocurren.',
    cta: 'Seguir el canal',
  },
  {
    key: 'discord',
    name: 'Discord',
    icon: '/icons/discord.svg',
    href: platforms.discord.url,
    tagline: 'Donde se habla de ADC.',
    description:
      'La comunidad más cercana: dudas de builds y runas, avisos de directo y conversación entre partidas.',
    cta: 'Unirse al servidor',
  },
  {
    key: 'instagram',
    name: 'Instagram',
    icon: '/icons/instagram.svg',
    href: platforms.instagram.url,
    tagline: 'Momentos y clips.',
    description:
      'Highlights, anuncios y el lado más rápido de visitar entre un vídeo y el siguiente.',
    cta: 'Seguir',
  },
  {
    key: 'x',
    name: 'X',
    icon: '/icons/x.svg',
    href: platforms.x.url,
    tagline: 'Lo que pienso, al momento.',
    description:
      'Opiniones sobre el meta, avisos de directo y la conversación en tiempo real con la comunidad.',
    cta: 'Seguir',
  },
] as const;
---

<section
  id="contacto"
  class="coded-section px-5 py-16 sm:px-8 sm:py-24"
  data-code="CANAL / REDES"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-1">
    <header class="social-showcase-heading">
      <p class="eyebrow">Redes y canales</p>
      <h2>Nos vemos en la siguiente partida.</h2>
      <p>
        Elige dónde quieres vivirla: en directo, después de editarla o entre
        una publicación y la siguiente.
      </p>
    </header>
    <div class="social-card-grid">
      {
        socialCards.map((card) => (
          <a
            class="social-card"
            data-social={card.key}
            href={card.href}
            target="_blank"
            rel="noreferrer"
          >
            <div class="social-card-head">
              <img src={card.icon} width="28" height="28" alt="" aria-hidden="true" />
              <span>{card.name}</span>
            </div>
            <strong>{card.tagline}</strong>
            <p>{card.description}</p>
            <span class="social-card-cta">
              {card.cta} <b aria-hidden="true">↗</b>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
