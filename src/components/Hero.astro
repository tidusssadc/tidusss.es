---
import { platforms } from '../config/platforms';
import { brandPrinciple } from '../data/site';
import HeroVisual from './HeroVisual.astro';
---

<section
  id="inicio"
  class="hero-section relative overflow-hidden pt-18"
  data-hero
>
  <div
    class="hero-layout mx-auto grid min-h-[calc(100svh-4.5rem)] max-w-7xl items-center gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.04fr_0.96fr] lg:gap-6 lg:py-24"
  >
    <div class="hero-copy relative z-10 max-w-3xl">
      <p class="eyebrow animate-rise">
        Tidusss <span class="text-slate-600">·</span> Creador de contenido
      </p>
      <ul class="hero-identity-tags animate-rise" aria-label="Quién es Tidusss">
        <li><span aria-hidden="true">◆</span> ADC · Master EUW</li>
        <li><span aria-hidden="true">◆</span> Main Lucian</li>
      </ul>
      <h1
        class="hero-title animate-rise delay-1 mt-6 text-5xl leading-[0.94] font-black tracking-[-0.06em] text-white sm:text-7xl lg:text-[6.35rem]"
      >
        Cada combo<br /><span class="text-gradient">cuenta.</span>
      </h1>
      <p class="hero-thesis animate-rise delay-2">
        <span>{brandPrinciple.lead}</span>{' '}
        {brandPrinciple.conclusion}
      </p>
      <p
        class="hero-lead animate-rise delay-2 mt-5 max-w-xl text-base leading-8 text-slate-300 sm:text-lg"
      >
        Soy Tidusss: main ADC en Master EUW, reviso cada partida para
        entender qué ha fallado y qué ha funcionado, y comparto ese criterio
        para que tú también puedas mejorar.
      </p>
      <div
        class="animate-rise delay-3 mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
      >
        <a
          class="button-primary justify-center px-6 py-3.5"
          href={platforms.youtube.url}
          target="_blank"
          rel="noreferrer">Ver gameplays <span aria-hidden="true">↗</span></a
        >
        <a
          class="button-secondary justify-center px-6 py-3.5"
          href={platforms.twitch.url}
          target="_blank"
          rel="noreferrer">Ver directos <span aria-hidden="true">↗</span></a
        >
        <a class="hero-live-link justify-center px-6 py-3.5" href="/explorar">
          Explorar todo el contenido <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-code animate-rise delay-3">{brandPrinciple.code}</p>
      <div class="hero-live-embed" data-hero-live-embed hidden>
        <p class="hero-live-embed-label">
          <span class="platform-live-mark" aria-hidden="true"></span>
          En directo ahora en Twitch
        </p>
        <div class="hero-live-embed-frame" data-hero-live-embed-frame></div>
      </div>
    </div>
    <div
      class="hero-art animate-rise delay-2 mx-auto w-full max-w-xl lg:max-w-none"
    >
      <div
        class="hero-gameplay-fragments"
        data-hero-gameplay
        aria-hidden="true"
      >
      </div>
      <HeroVisual />
    </div>
  </div>
  <a
    class="scroll-cue"
    href="#canales"
    aria-label="Continuar a Twitch y YouTube"><span></span></a
  >
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  hero?.addEventListener(
    'pointermove',
    (event) => {
      if (reducedMotion.matches) return;
      const bounds = hero.getBoundingClientRect();
      hero.style.setProperty(
        '--pointer-x',
        `${((event.clientX - bounds.left) / bounds.width - 0.5) * 2}`,
      );
      hero.style.setProperty(
        '--pointer-y',
        `${((event.clientY - bounds.top) / bounds.height - 0.5) * 2}`,
      );
    },
    { passive: true },
  );
</script>

<script>
  import { platforms } from '../config/platforms';
  import type { HomeState } from '../domain/home-state';

  /**
   * Reutiliza el evento que ya dispara el Home State Engine para el resto de
   * la página (banner de contexto, prioridad visual del panel de Twitch) en
   * vez de inventar un segundo mecanismo de detección de directo. Solo se
   * añade el reproductor incrustado — nunca se sustituye la señal existente.
   */
  const container = document.querySelector<HTMLElement>(
    '[data-hero-live-embed]',
  );
  const frame = document.querySelector<HTMLElement>(
    '[data-hero-live-embed-frame]',
  );

  let embedded = false;
  window.addEventListener('tidusss:home-state-changed', (event) => {
    if (!container || !frame) return;
    const state = (event as CustomEvent<HomeState>).detail;
    const isLive = state.id === 'live';
    container.hidden = !isLive;
    if (isLive && !embedded) {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.twitch.tv/?channel=${platforms.twitch.handle}&parent=${location.hostname}&muted=true&autoplay=true`;
      iframe.title = 'Directo de Tidusss en Twitch';
      iframe.allowFullscreen = true;
      iframe.setAttribute(
        'allow',
        'autoplay; fullscreen; encrypted-media; picture-in-picture',
      );
      frame.replaceChildren(iframe);
      embedded = true;
    } else if (!isLive && embedded) {
      frame.replaceChildren();
      embedded = false;
    }
  });
</script>
