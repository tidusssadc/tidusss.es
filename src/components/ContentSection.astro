---
import { integrationEndpoints, platforms } from '../config/platforms';
import { contentCards } from '../data/content';
import { youtubeProvider } from '../services/youtube';
import { relativeTime } from '../lib/time';
import SectionHeading from './SectionHeading.astro';

// RSS provides a useful no-JavaScript fallback without evaluating secrets at build time.
const initialVideos = await youtubeProvider.getLatest(8);
const initialFeed = {
  videos: initialVideos,
  state: initialVideos.length ? ('partial' as const) : ('empty' as const),
  updatedAt: new Date().toISOString(),
};

const formatPublishedAt = (value: string) =>
  relativeTime(value) ?? 'Fecha no disponible';

const emptyCopy = 'No hay publicaciones disponibles ahora mismo.';
---

<section
  id="contenido"
  class="section-shell coded-section border-y border-white/6 bg-white/[0.012]"
  data-code="SECCIÓN / CONTENIDO"
  data-reveal
>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading
      eyebrow="Contenido"
      title="Partidas reales. Decisiones explicadas."
      description="Contenido directo sobre mecánicas, botlane y todo lo que ocurre antes de apretar el botón."
    />
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        contentCards.map((card, index) => (
          <article class="content-card group" style={`--item-index: ${index}`}>
            <span class="text-xs font-bold tracking-[0.22em] text-[#d6b56b]">
              {card.number}
            </span>
            <h3 class="mt-8 text-xl font-semibold text-white">{card.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-400">
              {card.description}
            </p>
            <span class="mt-8 block h-px w-10 bg-[#278cff] transition-all duration-300 group-hover:w-20" />
          </article>
        ))
      }
    </div>

    <div class="video-heading mt-16">
      <div>
        <p class="eyebrow">Últimos vídeos</p>
        <h3 class="mt-3 text-2xl font-semibold text-white">
          Recién publicados
        </h3>
      </div>
      <div class="video-toolbar" data-video-filters hidden>
        <span class="sr-only" id="video-filter-label"
          >Filtrar publicaciones</span
        >
        <div
          class="video-filters"
          role="group"
          aria-labelledby="video-filter-label"
          data-selected="all"
        >
          <button type="button" data-filter="all" aria-pressed="true"
            >Todo</button
          >
          <button type="button" data-filter="video" aria-pressed="false"
            >Vídeos</button
          >
          <button type="button" data-filter="short" aria-pressed="false"
            >Shorts</button
          >
        </div>
      </div>
    </div>

    <div
      class="video-feed mt-7"
      data-youtube-feed
      data-endpoint={integrationEndpoints.youtube}
      data-state={initialFeed.state}
      aria-live="polite"
      aria-busy="false"
    >
      {
        initialFeed.videos.length > 0 ? (
          initialFeed.videos.map((video, index) => (
            <a
              class:list={['video-card', { 'video-card--latest': index === 0 }]}
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${video.contentType === 'short' ? 'Short' : 'Vídeo'}: ${video.title}`}
              data-platform="youtube"
              data-content-type={video.contentType}
              data-video-id={video.id}
              data-video-index={index}
            >
              <div
                class:list={[
                  'video-thumbnail',
                  `video-thumbnail--${video.contentType}`,
                ]}
              >
                {video.contentType === 'short' && (
                  <img
                    class="video-thumbnail-blur"
                    src={video.thumbnailUrl}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                )}
                <img
                  class="video-thumbnail-main"
                  src={video.thumbnailUrl}
                  alt=""
                  width="480"
                  height="360"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
                <span class="video-type">
                  {index === 0 && <b>Último</b>}
                  {video.contentType === 'short' ? 'Short' : 'Vídeo'}
                </span>
                {video.durationLabel && (
                  <span
                    class="video-duration"
                    aria-label={`Duración ${video.durationLabel}`}
                  >
                    {video.durationLabel}
                  </span>
                )}
                <span class="video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m9 7 8 5-8 5V7Z" fill="currentColor" />
                  </svg>
                </span>
              </div>
              <div class="video-meta">
                <div class="video-meta-line">
                  <span>
                    {video.contentType === 'short' ? 'Short' : 'Vídeo'}
                  </span>
                  <time datetime={video.publishedAt}>
                    {formatPublishedAt(video.publishedAt)}
                  </time>
                </div>
                <h4>{video.title}</h4>
                <span class="video-action">
                  Ver en YouTube
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M8 16 16 8m-6 0h6v6"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          ))
        ) : (
          <div class="video-empty" data-video-empty>
            <p>{emptyCopy}</p>
            <a
              href={platforms.youtube.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visitar el canal
            </a>
          </div>
        )
      }
    </div>

    <div class="video-footer">
      <button class="video-more" type="button" data-video-more hidden
        >Ver más</button
      >
      <a
        class="channel-link"
        href={platforms.youtube.url}
        target="_blank"
        rel="noopener noreferrer"
        data-platform="youtube"
      >
        Explorar el canal
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8 16 16 8m-6 0h6v6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <p class="video-update" data-video-update hidden></p>
  </div>
</section>

<script>
  import { relativeTime } from '../lib/time';
  import type {
    YouTubeFeedResponse,
    YouTubeFeedResult,
    YouTubeVideo,
  } from '../types/content';

  const feed = document.querySelector<HTMLElement>('[data-youtube-feed]');
  const filterWrap = document.querySelector<HTMLElement>(
    '[data-video-filters]',
  );
  const moreButton =
    document.querySelector<HTMLButtonElement>('[data-video-more]');
  const updateNote = document.querySelector<HTMLElement>('[data-video-update]');
  const endpoint = feed?.dataset.endpoint;
  let videos: YouTubeVideo[] = [];
  let activeFilter = 'all';
  let expanded = false;

  const formatPublishedAt = (value: string) =>
    relativeTime(value) ?? 'Fecha no disponible';

  const svg = (path: string, filled = false) => {
    const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    icon.setAttribute('viewBox', '0 0 24 24');
    icon.setAttribute('fill', 'none');
    icon.setAttribute('aria-hidden', 'true');
    const shape = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'path',
    );
    shape.setAttribute('d', path);
    if (filled) shape.setAttribute('fill', 'currentColor');
    else {
      shape.setAttribute('stroke', 'currentColor');
      shape.setAttribute('stroke-width', '1.8');
      shape.setAttribute('stroke-linecap', 'round');
      shape.setAttribute('stroke-linejoin', 'round');
    }
    icon.append(shape);
    return icon;
  };

  const createVideoCard = (video: YouTubeVideo, index: number) => {
    const card = document.createElement('a');
    card.className = `video-card${index === 0 ? ' video-card--latest' : ''}`;
    card.href = video.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';
    card.setAttribute(
      'aria-label',
      `${video.contentType === 'short' ? 'Short' : 'Vídeo'}: ${video.title}`,
    );
    card.dataset.platform = 'youtube';
    card.dataset.contentType = video.contentType;
    card.dataset.videoId = video.id;
    card.dataset.videoIndex = String(index);

    const thumbnail = document.createElement('div');
    thumbnail.className = `video-thumbnail video-thumbnail--${video.contentType}`;
    const makeImage = (className: string, lazy: boolean) => {
      const image = document.createElement('img');
      image.className = className;
      image.src = video.thumbnailUrl;
      image.alt = '';
      image.width = 480;
      image.height = 360;
      image.loading = lazy ? 'lazy' : 'eager';
      image.decoding = 'async';
      return image;
    };
    if (video.contentType === 'short') {
      const background = makeImage('video-thumbnail-blur', true);
      background.setAttribute('aria-hidden', 'true');
      thumbnail.append(background);
    }
    thumbnail.append(makeImage('video-thumbnail-main', index !== 0));
    const type = document.createElement('span');
    type.className = 'video-type';
    if (index === 0) {
      const latest = document.createElement('b');
      latest.textContent = 'Último';
      type.append(latest);
    }
    type.append(video.contentType === 'short' ? 'Short' : 'Vídeo');
    thumbnail.append(type);
    if (video.durationLabel) {
      const duration = document.createElement('span');
      duration.className = 'video-duration';
      duration.textContent = video.durationLabel;
      duration.setAttribute('aria-label', `Duración ${video.durationLabel}`);
      thumbnail.append(duration);
    }
    const play = document.createElement('span');
    play.className = 'video-play';
    play.setAttribute('aria-hidden', 'true');
    play.append(svg('m9 7 8 5-8 5V7Z', true));
    thumbnail.append(play);

    const meta = document.createElement('div');
    meta.className = 'video-meta';
    const metaLine = document.createElement('div');
    metaLine.className = 'video-meta-line';
    const kind = document.createElement('span');
    kind.textContent = video.contentType === 'short' ? 'Short' : 'Vídeo';
    const date = document.createElement('time');
    date.dateTime = video.publishedAt;
    date.textContent = formatPublishedAt(video.publishedAt);
    metaLine.append(kind, date);
    const title = document.createElement('h4');
    title.textContent = video.title;
    const action = document.createElement('span');
    action.className = 'video-action';
    action.append('Ver en YouTube', svg('M8 16 16 8m-6 0h6v6'));
    meta.append(metaLine, title, action);
    card.append(thumbnail, meta);
    return card;
  };

  const applyView = () => {
    if (!feed) return;
    const cards = [...feed.querySelectorAll<HTMLElement>('.video-card')];
    const matching = cards.filter(
      (card) =>
        activeFilter === 'all' || card.dataset.contentType === activeFilter,
    );
    cards.forEach((card) => {
      card.hidden = true;
    });
    matching.forEach((card, index) => {
      card.hidden = !expanded && index >= 6;
    });
    if (moreButton) {
      moreButton.hidden = matching.length <= 6;
      moreButton.textContent = expanded
        ? 'Ver menos'
        : `Ver más (${matching.length - 6})`;
    }
  };

  const activate = (result: YouTubeFeedResult) => {
    if (!feed) return;
    if (!result.videos.length) {
      const empty = feed.querySelector<HTMLElement>('[data-video-empty]');
      const copy = empty?.querySelector('p');
      if (copy) copy.textContent = 'El canal todavía no tiene vídeos públicos.';
      feed.dataset.state = 'empty';
      feed.setAttribute('aria-busy', 'false');
      return;
    }
    videos = result.videos;
    feed.replaceChildren(...videos.map(createVideoCard));
    feed.dataset.state = result.state;
    feed.setAttribute('aria-busy', 'false');
    const types = new Set(videos.map(({ contentType }) => contentType));
    if (filterWrap) filterWrap.hidden = types.size < 2;
    if (updateNote && result.state === 'partial') {
      updateNote.textContent =
        'Algunos detalles no están disponibles temporalmente.';
      updateNote.hidden = false;
    }
    applyView();
  };

  document
    .querySelectorAll<HTMLButtonElement>('[data-filter]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter ?? 'all';
        expanded = false;
        document
          .querySelectorAll<HTMLButtonElement>('[data-filter]')
          .forEach((item) =>
            item.setAttribute('aria-pressed', String(item === button)),
          );
        button
          .closest<HTMLElement>('.video-filters')
          ?.setAttribute('data-selected', activeFilter);
        applyView();
      });
    });
  moreButton?.addEventListener('click', () => {
    expanded = !expanded;
    applyView();
  });

  if (feed) {
    videos = [...feed.querySelectorAll<HTMLElement>('.video-card')].map(
      (card) => ({
        id: card.dataset.videoId ?? '',
        title: '',
        url: card.getAttribute('href') ?? '',
        thumbnailUrl: '',
        publishedAt: '',
        durationSeconds: null,
        durationLabel: null,
        contentType: card.dataset.contentType === 'short' ? 'short' : 'video',
        isShort: card.dataset.contentType === 'short',
      }),
    );
    const types = new Set(videos.map(({ contentType }) => contentType));
    if (filterWrap) filterWrap.hidden = types.size < 2;
    applyView();
  }

  if (feed && endpoint) {
    feed.setAttribute('aria-busy', 'true');
    fetch(endpoint)
      .then((response) =>
        response.ok
          ? (response.json() as Promise<YouTubeFeedResponse>)
          : Promise.reject(),
      )
      .then((payload) => {
        if (!payload.ok) throw new Error(payload.error.code);
        activate(payload.data);
      })
      .catch(() => {
        feed.setAttribute('aria-busy', 'false');
        if (!feed.querySelector('.video-card')) {
          const emptyCopy = feed.querySelector<HTMLElement>(
            '[data-video-empty] p',
          );
          if (emptyCopy)
            emptyCopy.textContent =
              'Los vídeos no están disponibles temporalmente.';
        }
        if (updateNote) {
          updateNote.textContent =
            'Los vídeos no se han podido actualizar. Se conserva el contenido disponible.';
          updateNote.hidden = false;
        }
      });
  }
</script>
